# smart_water_core.py  ── 개선판 v5.3
# 변경 이력:
#   v1~v5.2 유지 태그 모두 포함
#   [V5.3-DIAM] CALC_START_TIME 3.0→5.0 (초반 불안정 구간 제외)
#   [V5.3-DIAM] REG_MIN_POINTS 16→20 (더 많은 데이터 쌓인 후 D 계산)
#   [V5.3-DIAM] LOESS_FRAC 0.45→0.35 (과도한 평활화 줄여 실제 slope 보존)
#   [V5.3-DIAM] spike gate 0.30→0.20 (초반 spike 더 엄격하게 차단)

import numpy as np
import sounddevice as sd
import scipy.signal as signal
import time
import threading
from collections import deque
from gpiozero import OutputDevice, Button

# ── 파일/GPIO 설정 ──────────────────────────────────────────────────
CSV_FILENAME      = 'experiment_results.csv'
INPUT_DEVICE      = 0
SOLENOID_GPIO     = 7
SW_ON_GPIO        = 3
