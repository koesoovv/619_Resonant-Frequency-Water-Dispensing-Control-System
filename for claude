def _get_zone_ema_alpha(fill_pct: float, in_final: bool) -> float:
    """fill% 50~99 구간이면 ZONE_EMA_ALPHA 사용, 아니면 기존 alpha."""
    if 50.0 <= fill_pct < 100.0:
        key = int(fill_pct // 10) * 10  # 57.3→50, 83.1→80
        if key in ZONE_EMA_ALPHA:
            return ZONE_EMA_ALPHA[key]
    return EMA_ALPHA_FINAL if in_final else EMA_ALPHA_NORMAL


def _get_zone_advance(fill_pct: float) -> float:
    """fill% 50~99 구간이면 ZONE_ADVANCE_PCT, 아니면 0."""
    if 50.0 <= fill_pct < 100.0:
        key = int(fill_pct // 10) * 10
        return ZONE_ADVANCE_PCT.get(key, 0.0)
    return 0.0


# ════════════════════════════════════════════════════════════════════
#  수학 유틸리티
# ════════════════════════════════════════════════════════════════════
def loess_smooth(x, y, frac=LOESS_FRAC, degree=LOESS_DEGREE):
    n = len(x)
    if n < 4:
        return np.array(y, dtype=float)
    x = np.array(x, dtype=float)
    y = np.array(y, dtype=float)
    smoothed = np.zeros(n)
    h_width  = max(int(np.ceil(frac * n)), degree + 2)
    for i in range(n):
        dist  = np.abs(x - x[i])
        idx   = np.argsort(dist)[:h_width]
        max_d = dist[idx[-1]]
        if max_d < 1e-10:
            smoothed[i] = np.mean(y[idx])
            continue
        u = dist[idx] / max_d
        w = (1.0 - u**3)**3
        X = np.column_stack([x[idx]**p for p in range(degree + 1)])
        W = np.diag(w)
        try:
            XtW  = X.T @ W
            coef = np.linalg.lstsq(XtW @ X, XtW @ y[idx], rcond=None)[0]
            smoothed[i] = sum(coef[p] * x[i]**p for p in range(degree + 1))
        except Exception:
            smoothed[i] = y[i]
    return smoothed


def levinson_durbin(r, order):
    e = float(r[0])
    if e <= 0:
        return None
    a = np.zeros(order + 1, dtype=float)
    a[0] = 1.0
    for k in range(1, order + 1):
        acc = float(np.dot(a[1:k], r[k - 1:0:-1]))
        lam = -(r[k] + acc) / (e + 1e-12)
        if k > 1:
            a[1:k] = a[1:k] + lam * a[k - 1:0:-1]
        a[k]  = lam
        e    *= max(1.0 - lam * lam, 1e-12)
    return a


# ════════════════════════════════════════════════════════════════════
#  주파수 검출
# ════════════════════════════════════════════════════════════════════
def lpc_main_frequency(chunk, last_freq, f_min, f_max):
    x_ds  = signal.decimate(chunk.astype(float), LPC_DS_FACTOR, ftype='fir')
    sr_ds = LPC_DS_RATE
    fl    = int(LPC_FRAME_MS / 1000 * sr_ds)
    hop   = int(LPC_HOP_MS  / 1000 * sr_ds)
    frames = [x_ds[i:i + fl] for i in range(0, len(x_ds) - fl, hop)]
    if not frames:
        return 0.0
    cands = []
    for frame in frames:
        if float(np.mean(frame**2)) < LPC_MIN_ENERGY:
            continue
        frame = frame * np.hamming(len(frame))
        r = np.array([
            np.dot(frame[:len(frame) - k], frame[k:]) / len(frame)
            for k in range(LPC_ORDER + 1)
        ])
        if r[0] < 1e-12:
            continue
        a = levinson_durbin(r, LPC_ORDER)
        if a is None:
            continue
        A   = np.fft.rfft(a, n=LPC_NFFT)
        mag = 1.0 / (np.abs(A) + 1e-12)
        freqs = np.fft.rfftfreq(LPC_NFFT, d=1.0 / sr_ds)
        mask  = (freqs >= f_min) & (freqs <= min(f_max, sr_ds / 2 - 50))
        if not np.any(mask):
            continue
        vf, vm   = freqs[mask], mag[mask]
        prom     = vm.max() * LPC_PEAK_PROM
        peaks, _ = signal.find_peaks(vm, prominence=prom, distance=4)
        if len(peaks) == 0:
            peaks = np.array([np.argmax(vm)])
        pf, pm = vf[peaks], vm[peaks]
        clean  = [i for i, f in enumerate(pf)
                  if not any(abs(f - nf) < 25.0 for nf in noise_profile)]
        if not clean:
            continue
        pf, pm = pf[clean], pm[clean]
        pm_n   = pm / (pm.max() + 1e-12)
        if last_freq > 0:
            score = pm_n - (1.0 / LPC_CONTINUITY_W) * np.abs(pf - last_freq)
            if LPC_RISE_BIAS > 0:
                score += LPC_RISE_BIAS * (pf > last_freq)
        else:
            score = pm_n
        cands.append(float(pf[np.argmax(score)]))
    return float(np.median(cands)) if cands else 0.0


def fft_backup_frequency(chunk, last_freq, f_min, f_max):
    windowed = chunk * np.hamming(len(chunk))
    fft_val  = np.abs(np.fft.rfft(windowed))
    freqs    = np.fft.rfftfreq(len(chunk), d=1.0 / SAMPLE_RATE)
    mask     = (freqs >= f_min) & (freqs <= f_max)
    if not np.any(mask):
        return 0.0
    vf, vm   = freqs[mask], fft_val[mask]
    peaks, _ = signal.find_peaks(vm, prominence=vm.max() * 0.15, distance=10)
    if len(peaks) == 0:
        return float(vf[np.argmax(vm)])
    pf, pm = vf[peaks], vm[peaks]
    clean  = [i for i, f in enumerate(pf)
              if not any(abs(f - nf) < 25.0 for nf in noise_profile)]
    if not clean:
        clean = list(range(len(pf)))
    pf, pm = pf[clean], pm[clean]
    pm_n   = pm / (pm.max() + 1e-12)
    if last_freq > 0:
        score = pm_n - (1.0 / 800.0) * np.abs(pf - last_freq)
        if LPC_RISE_BIAS > 0:
            score += LPC_RISE_BIAS * (pf > last_freq)
    else:
        score = pm_n
    return float(pf[np.argmax(score)])


def _harmonic_correct(f: float, ref: float) -> float:
    if ref <= 0 or f <= 0:
        return f
    ratio = f / ref
    if 2.7 <= ratio <= 3.3:
        return f / 3.0
    elif 1.8 <= ratio <= 2.2:
        return f / 2.0
    elif 4.7 <= ratio <= 5.3:
        return f / 5.0
    elif ratio > 2.5:
        return 0.0
    return f


def get_frequency(chunk, last_freq, f_min, f_max):
    filtered = signal.sosfilt(HP_SOS, chunk.astype(float))
    lpc_f = lpc_main_frequency(filtered, last_freq, f_min, f_max)
    lpc_f = _harmonic_correct(lpc_f, last_freq)
    if lpc_f > 0:
        return float(lpc_f)
    fft_f = fft_backup_frequency(filtered, last_freq, f_min, f_max)
    fft_f = _harmonic_correct(fft_f, last_freq)
    return float(fft_f)


# ════════════════════════════════════════════════════════════════════
#  회귀 기반 D 추정
# ════════════════════════════════════════════════════════════════════
def robust_slope_loess_lsm(times, inv_freqs):
    if len(times) < 12:
        return None, 0.0, 0.0
    x = np.array(times,     dtype=float)
    y = np.array(inv_freqs, dtype=float)
    y_smooth = loess_smooth(x, y, frac=LOESS_FRAC, degree=LOESS_DEGREE)
    try:
        p    = np.polyfit(x, y_smooth, 1)
        res  = np.abs(y_smooth - (p[0] * x + p[1]))
        mask = res <= np.percentile(res, 75)
        if mask.sum() < 8:
            return None, 0.0, 0.0
        slope, intercept = np.polyfit(x[mask], y_smooth[mask], 1)
        if slope >= 0 or abs(slope) < MIN_SLOPE_CUTOFF:
            return None, 0.0, 0.0
        y_pred  = slope * x[mask] + intercept
        ss_res  = np.sum((y_smooth[mask] - y_pred)**2)
        ss_tot  = np.sum((y_smooth[mask] - y_smooth[mask].mean())**2)
        r2      = 1.0 - ss_res / (ss_tot + 1e-12)
        return float(slope), float(intercept), float(r2)
    except Exception:
        return None, 0.0, 0.0


def theory_freq(t: float) -> float:
    if not theory_locked:
        return 0.0
    denom = theory_slope * t + theory_intercept
    if denom <= 1e-6:
        return 0.0
    return 1.0 / denom


# ════════════════════════════════════════════════════════════════════
#  회귀 워커 스레드
# ════════════════════════════════════════════════════════════════════
def _regression_worker():
    global current_diameter, target_freq, calibration_done
    global theory_slope, theory_intercept, theory_locked
    global init_air_len_cm, last_r2, diameter_candidates
    global _eff_target_air_cm

    while True:
        _reg_event.wait(timeout=1.0)
        _reg_event.clear()

        with lock:
            if not is_filling:
                continue
            _filling_elapsed = time.time() - filling_start_time - NOISE_CALIBRATION_TIME
            times     = list(reg_time_buffer)
            inv_freqs = list(reg_inv_freq_buffer)
            _init_f   = float(initial_stable_freq)
            _cur_d    = float(current_diameter)
            _tracking = bool(tracking_mode)
            _cand_cnt = len(diameter_candidates)
            _diam_full = (_cand_cnt >= DIAM_CAND_MAXLEN) or \
                         (_cand_cnt >= DIAM_CAND_MIN and _filling_elapsed > DIAM_CALC_END_TIME)

        if _diam_full:
            continue
        if len(times) <= REG_MIN_POINTS:
            continue

        s_a, s_b, r_sq = robust_slope_loess_lsm(times, inv_freqs)

        if s_a is not None:
            if _cur_d > 0:
                q_implied = abs(s_a) * np.pi * SOUND_SPEED * _cur_d**2 / 16
                print(f'\n[회귀] slope={s_a:.6f} | r²={r_sq:.4f} | 역산Q={q_implied:.1f}ml/s (설정Q={FLOW_RATE})')
            else:
                print(f'\n[회귀] slope={s_a:.6f} | r²={r_sq:.4f}')

        with lock:
            if s_a is not None and r_sq > THEORY_LOCK_R2 and not theory_locked:
                theory_slope     = s_a
                theory_intercept = s_b
                theory_locked    = True
                print(f'\n[★ 이론 곡선 잠금] slope={s_a:.6f} r²={r_sq:.3f}')

        if s_a is None or abs(s_a) <= 1e-9:
            continue

        if abs(s_a) < 0.000035:
            r2_threshold = 0.88
        elif abs(s_a) < 0.000055:
            r2_threshold = 0.92
        else:
            r2_threshold = 0.95

        if r_sq <= r2_threshold:
            with lock:
                last_r2 = r_sq
            continue

        if _cur_d > 0:
            q_implied = abs(s_a) * np.pi * SOUND_SPEED * _cur_d**2 / 16
            effective_Q = q_implied if 10.0 < q_implied < 30.0 else FLOW_RATE
        else:
            effective_Q = FLOW_RATE

        temp_D = np.sqrt(16 * effective_Q / (np.pi * SOUND_SPEED * abs(s_a)))

        if abs(s_a) < 0.000030:
            auto_scale = 0.90
        elif abs(s_a) < 0.000045:
            auto_scale = 0.95
        else:
            auto_scale = 1.0

        temp_D *= DIAMETER_SCALE * auto_scale

        if not (2.0 < temp_D < 15.0):
            continue

        with lock:
            cand_list = list(diameter_candidates)

        if len(cand_list) >= 3:
            cur_med = float(np.median(cand_list))
            outlier = abs(temp_D - cur_med) / cur_med > DIAM_OUTLIER_RATIO
        else:
            outlier = False
            cur_med = temp_D

        if outlier:
            print(f'\n[D이상치] temp_D={temp_D:.2f}cm (중앙값={cur_med:.2f}cm ±30%, 무시)')
            continue

        with lock:
            last_r2 = r_sq
            diameter_candidates.append(temp_D)

            _new_cnt     = len(diameter_candidates)
            _elapsed_now = time.time() - filling_start_time - NOISE_CALIBRATION_TIME
            diam_full_now = (_new_cnt >= DIAM_CAND_MAXLEN) or \
                            (_new_cnt >= DIAM_CAND_MIN and _elapsed_now > DIAM_CALC_END_TIME)

            med_D = float(np.median(list(diameter_candidates)))
            if current_diameter == 0:
                current_diameter = med_D
            else:
                current_diameter = current_diameter * DIAM_EMA_KEEP + med_D * DIAM_EMA_NEW
            _cur_d = float(current_diameter)

            if init_air_len_cm == 0.0 and _init_f > 0 and _cur_d > 0:
                est = SOUND_SPEED / (4 * _init_f) - END_CORRECTION_K * _cur_d
                est += INIT_AIR_OFFSET_CM
                if est > 0.5:
                    init_air_len_cm    = est
                    _eff_target_air_cm = max(0.5, est * (1.0 - TARGET_FILL_PCT / 100.0))
                    print(f'\n[★ 용기 높이 확정] {est:.2f} cm'
                          f' → 목표 공기층 {_eff_target_air_cm:.2f} cm ({TARGET_FILL_PCT:.0f}%)')

            target_L_eff = _eff_target_air_cm + END_CORRECTION_K * _cur_d
            new_tf = SOUND_SPEED / (4 * target_L_eff)
            if target_freq == 0:
                target_freq = new_tf
            else:
                change_ratio = abs(new_tf - target_freq) / target_freq
                if change_ratio <= TARGET_MAX_CHANGE_RATIO:
                    target_freq = new_tf
            calibration_done = True

            if diam_full_now:
                print(f'\n[★ 지름 확정] D={_cur_d:.3f}cm cand={_new_cnt} t={_elapsed_now:.1f}s')


_reg_worker_thread = threading.Thread(target=_regression_worker, daemon=True)
_reg_worker_thread.start()


# ════════════════════════════════════════════════════════════════════
#  급수 시작/종료
# ════════════════════════════════════════════════════════════════════
def start_filling_local() -> None:
    global is_filling, filling_start_time, calibration_done
    global freq_buffer, reg_time_buffer, reg_inv_freq_buffer
    global diameter_candidates, history_time, history_freq
    global last_tracked_freq, consecutive_loss_count, consecutive_stop_hits
    global current_diameter, target_freq, initial_stable_freq
    global request_finish, last_stable_f, last_current_air, last_fill_pct
    global dynamic_min_limit, noise_profile
    global max_freq_seen, tracking_mode, tracking_mode_hits
    global theory_slope, theory_intercept, theory_locked
    global _prev_buf_median, _freeze_count
    global last_r2, spike_blocked_count, history_freq_snapshot
    global init_air_len_cm, _eff_target_air_cm
    global peak_lock_floor
    global init_stable_buffer

    with lock:
        is_filling              = True
        filling_start_time      = time.time()
        calibration_done        = False
        freq_buffer             = deque()
        reg_time_buffer.clear()
        reg_inv_freq_buffer.clear()
        diameter_candidates.clear()
        history_time            = []
        history_freq            = []
        last_tracked_freq       = 0.0
        consecutive_loss_count  = 0
        consecutive_stop_hits   = 0
        initial_stable_freq     = 0.0
        current_diameter        = 0.0
        target_freq             = 0.0
        request_finish          = False
        last_stable_f           = 0.0
        last_current_air        = 0.0
        last_fill_pct           = 0.0
        dynamic_min_limit       = FREQ_MIN_LIMIT
        noise_profile           = []
        max_freq_seen           = 0.0
        tracking_mode           = False
        tracking_mode_hits      = 0
        theory_slope            = 0.0
        theory_intercept        = 0.0
        theory_locked           = False
        _prev_buf_median        = 0.0
        _freeze_count           = 0
        last_r2                 = 0.0
        spike_blocked_count     = 0
        history_freq_snapshot   = []
        init_air_len_cm         = 0.0
        _eff_target_air_cm      = 3.0
        peak_lock_floor         = 0.0
        init_stable_buffer      = deque(maxlen=10)
    print('\n>>> [1단계] 배경 소음 측정 (1초)...')


def stop_filling_local(save_result: bool) -> None:
    global is_filling, request_finish, history_freq_snapshot
    with lock:
        history_freq_snapshot = list(history_freq)
        is_filling = False
        if save_result:
            request_finish = True
    print('\n>>> 물 주입 종료.')


# ════════════════════════════════════════════════════════════════════
#  오디오 콜백
# ════════════════════════════════════════════════════════════════════
def audio_callback(indata, frames, time_info, status):
    global is_filling, filling_start_time, calibration_done
    global target_freq, current_diameter
    global freq_buffer, reg_time_buffer, reg_inv_freq_buffer
    global diameter_candidates, history_time, history_freq
    global last_tracked_freq, consecutive_loss_count, consecutive_stop_hits
    global request_finish, last_stable_f, last_current_air, last_fill_pct
    global initial_stable_freq
    global last_print_time, dynamic_min_limit, noise_profile
    global STOP_TRIGGER_COUNT, CONTROL_START_TIME, FREQ_MAX_LIMIT, EARLY_CEIL_HZ
    global max_freq_seen, tracking_mode, tracking_mode_hits
    global theory_slope, theory_intercept, theory_locked
    global _prev_buf_median, _freeze_count
    global last_r2, spike_blocked_count, history_freq_snapshot
    global init_air_len_cm, _eff_target_air_cm
    global peak_lock_floor
    global init_stable_buffer

    if not is_filling:
        return

    chunk = indata.flatten().astype(float)
    if np.max(np.abs(chunk)) < 0.01:
        return

    try:
        current_time = time.time()
        with lock:
            elapsed = current_time - filling_start_time

        # ── 1단계: 배경 소음 수집 ────────────────────────────────────
        if elapsed < NOISE_CALIBRATION_TIME:
            windowed = chunk * np.hamming(len(chunk))
            fft_val  = np.abs(np.fft.rfft(windowed))
            freqs    = np.fft.rfftfreq(len(chunk), d=1.0 / SAMPLE_RATE)
            mask     = (freqs >= 100) & (freqs <= 2000)
            if np.any(mask):
                vf, vm   = freqs[mask], fft_val[mask]
                peaks, _ = signal.find_peaks(vm, prominence=vm.max() * 0.2)
                with lock:
                    for p in peaks:
                        f_n = float(vf[p])
                        if not any(abs(f_n - nf) < 20 for nf in noise_profile):
                            noise_profile.append(f_n)
            return

        filling_elapsed = elapsed - NOISE_CALIBRATION_TIME

        if filling_elapsed < SPLASH_GUARD_TIME:
            return

        with lock:
            _last   = float(last_tracked_freq)
            _init   = float(initial_stable_freq)
            _last_s = float(last_stable_f)

        # ── 3단계: 탐색 범위 결정 ────────────────────────────────────
        if filling_elapsed < 3.5:
            current_ceil  = EARLY_CEIL_HZ
            current_floor = dynamic_min_limit
        elif tracking_mode:
            current_ceil  = min(FREQ_MAX_LIMIT, _last + TRACKING_BAND_HZ)
            current_floor = max(dynamic_min_limit, max_freq_seen * TRACKING_FLOOR_RATIO)
        else:
            base = _last if _last > 0 else (_last_s if _last_s > 0 else _init)
            current_ceil  = min(FREQ_MAX_LIMIT, base + 1500.0) if base > 0 else FREQ_MAX_LIMIT
            current_floor = dynamic_min_limit

        if not tracking_mode and _last > 400:
            new_floor = _last * 0.75
            if new_floor > dynamic_min_limit:
                dynamic_min_limit = new_floor

        if _init > 0 and not tracking_mode:
            init_floor = _init * 0.85
            if init_floor > dynamic_min_limit:
                dynamic_min_limit = init_floor

        with lock:
            _tf = float(target_freq)
        if _tf > 0 and dynamic_min_limit > _tf * 0.85:
            dynamic_min_limit = _tf * 0.85

        # ── 4단계: 주파수 검출 ───────────────────────────────────────
        detected_f = get_frequency(chunk, _last, current_floor, current_ceil)

        if detected_f < current_floor or detected_f == 0:
            detected_f = 0.0
        if filling_elapsed < 3.5 and detected_f > EARLY_CEIL_HZ:
            detected_f = 0.0

        if detected_f == 0.0:
            consecutive_loss_count += 1
            if not tracking_mode:
                dynamic_min_limit = max(FREQ_MIN_LIMIT, dynamic_min_limit * 0.97)
            if consecutive_loss_count > 10:
                with lock:
                    if last_stable_f > 0:
                        last_tracked_freq = float(last_stable_f)
                    elif initial_stable_freq > 0:
                        last_tracked_freq = float(initial_stable_freq)
                    else:
                        last_tracked_freq *= 0.9
            return

        consecutive_loss_count = 0
        raw_f_for_reg = float(detected_f)

        # ── 5단계: EMA 스무딩 ────────────────────────────────────────
        with lock:
            _cur_d_snap = float(current_diameter)
            _calib_snap = bool(calibration_done)
            _eff_tgt    = float(_eff_target_air_cm)
            _fill_pct_now = float(last_fill_pct)  # [v5.21] 현재 fill% 스냅샷

        if _calib_snap and _cur_d_snap > 0 and _last_s > 0:
            L_now    = SOUND_SPEED / (4 * _last_s) - END_CORRECTION_K * _cur_d_snap
            in_final = (L_now < _eff_tgt * FINAL_APPROACH_MULT)
        else:
            in_final = False

        # ── [v5.21-ZONE-EMA] 구간별 alpha 결정 ──────────────────────
        # calibration 완료 + fill% 50 이상이면 구간별, 아니면 기존 로직
        if _calib_snap and _fill_pct_now >= 50.0:
            alpha_det = _get_zone_ema_alpha(_fill_pct_now, in_final)
        else:
            alpha_det = EMA_ALPHA_FINAL if in_final else EMA_ALPHA_NORMAL

        if _last > 0:
            ratio = detected_f / _last
            if tracking_mode:
                if ratio < 0.9:
                    detected_f = _last
                elif ratio > 1.4:
                    detected_f = _last * 0.95 + detected_f * 0.05
                elif detected_f > _last:
                    if in_final:
                        alpha = FINAL_TRACKING_RISE_ALPHA
                    elif ratio > 1.3:
                        alpha = TRACKING_EMA_SPIKE_ALPHA
                    elif ratio > 1.15:
                        alpha = TRACKING_EMA_RISE2_ALPHA
                    else:
                        alpha = TRACKING_EMA_RISE1_ALPHA
                    detected_f = _last * (1 - alpha) + detected_f * alpha
                else:
                    detected_f = _last * (1 - TRACKING_EMA_FALL_ALPHA) + detected_f * TRACKING_EMA_FALL_ALPHA
            else:
                if ratio > SPIKE_RATIO_THRESHOLD:
                    detected_f = _last * 0.95 + detected_f * 0.05
                else:
                    # [v5.21] alpha_det은 구간별로 달라질 수 있음
                    detected_f = _last * (1 - alpha_det) + detected_f * alpha_det

        if not tracking_mode and _last > 0 and detected_f > _last:
            max_rise = RATE_LIMIT_FINAL_HZ if in_final else RATE_LIMIT_NORMAL_HZ
            if detected_f - _last > max_rise:
                detected_f = _last + max_rise

        # ── 이론 곡선 가이드 (v5.18 그대로) ─────────────────────────
        if theory_locked and detected_f > 0:
            f_theory = theory_freq(filling_elapsed)
            if f_theory > 0:
                deviation = abs(detected_f - f_theory) / f_theory
                if in_final:
                    g_alpha  = THEORY_GUIDE_ALPHA_FINAL
                    g_margin = THEORY_GUIDE_MARGIN_FINAL
                else:
                    g_alpha  = THEORY_GUIDE_ALPHA
                    g_margin = THEORY_GUIDE_MARGIN
                if deviation <= g_margin:
                    blended = detected_f * (1 - g_alpha) + f_theory * g_alpha
                    with lock:
                        _tf_cap = float(target_freq)
                    if _tf_cap > 0 and not in_final:
                        blended = min(blended, _tf_cap * 1.01)
                    detected_f = blended

        with lock:
            _tf_cap2   = float(target_freq)
            _calib_cap = bool(calibration_done)
        _cap_mult = 1.20 if not _calib_cap else (1.35 if in_final else 1.12)
        if _tf_cap2 > 0 and detected_f > _tf_cap2 * _cap_mult:
            detected_f = _last

        last_tracked_freq = detected_f

        # ── 6단계: freq_buffer → stable_f (v5.18 그대로) ─────────────
        if in_final:
            buf_size = BUF_SIZE_FINAL
        elif filling_elapsed < EARLY_NOISE_SEC:
            buf_size = EARLY_BUF_SIZE
        else:
            buf_size = 5

        freq_buffer.append(detected_f)
        while len(freq_buffer) > buf_size:
            freq_buffer.popleft()

        cur_median = float(np.median(list(freq_buffer)))
        if cur_median == _prev_buf_median:
            _freeze_count += 1
        else:
            _freeze_count = 0
        _prev_buf_median = cur_median
        if _freeze_count >= FREEZE_RESET_N:
            freq_buffer.clear()
            _freeze_count = 0

        if tracking_mode:
            stable_f = float(np.median(list(freq_buffer)[-BUF_SIZE_FINAL:])) if len(freq_buffer) >= BUF_SIZE_FINAL else detected_f
        else:
            stable_f = float(np.median(list(freq_buffer))) if freq_buffer else detected_f

        if _init > 0 and stable_f < _init * 0.97:
            stable_f = _init * 0.97
        elif filling_elapsed < EARLY_NOISE_SEC and _last_s > 0:
            if stable_f < _last_s * MONO_DROP_RATIO:
                stable_f = _last_s

        with lock:
            history_time.append(filling_elapsed)
            history_freq.append(stable_f)
            last_stable_f = stable_f
            if (filling_elapsed > SPLASH_GUARD_TIME
                    and initial_stable_freq == 0
                    and stable_f > INIT_STABLE_MIN_HZ):
                init_stable_buffer.append(stable_f)
                if len(init_stable_buffer) >= 10:
                    initial_stable_freq = float(np.percentile(list(init_stable_buffer), 75))

        with lock:
            if filling_elapsed > SPLASH_GUARD_TIME and stable_f > max_freq_seen:
                max_freq_seen = stable_f
            _max_f_seen = float(max_freq_seen)

        with lock:
            _tf_now = float(target_freq)
        if not tracking_mode and _tf_now > 0 and _max_f_seen > _tf_now * 0.75:
            hard_floor = min(_max_f_seen * 0.88, _tf_now * 0.98)
            if stable_f < hard_floor:
                stable_f = hard_floor

        if stable_f > peak_lock_floor:
            peak_lock_floor = stable_f
        if peak_lock_floor > 0 and stable_f < peak_lock_floor * 0.90:
            stable_f = peak_lock_floor * 0.90

        # ── 7단계: tracking 모드 진입 판정 ──────────────────────────
        _tracking_thresh = max(TRACKING_ENTRY_HZ, _init * TRACKING_ENTRY_MULT) if _init > 0 else TRACKING_ENTRY_HZ

        if stable_f > _tracking_thresh:
            tracking_mode_hits += 1
        else:
            tracking_mode_hits = max(0, tracking_mode_hits - 2)

        if tracking_mode_hits >= TRACKING_MODE_THRESHOLD and not tracking_mode:
            with lock:
                tracking_mode = True
            print(f'\n[★ 트래킹 모드] {stable_f:.0f}Hz (thresh={_tracking_thresh:.0f}Hz) 시작')

        # ── 8단계: 회귀 버퍼 수집 (v5.18 그대로) ────────────────────
        with lock:
            _init_f    = float(initial_stable_freq)
            _cur_d     = float(current_diameter)
            _cand_cnt  = len(diameter_candidates)
            _diam_full = (_cand_cnt >= DIAM_CAND_MAXLEN) or \
                         (_cand_cnt >= DIAM_CAND_MIN and filling_elapsed > DIAM_CALC_END_TIME)

        if filling_elapsed > CALC_START_TIME and not _diam_full:
            if int(filling_elapsed) % 3 == 0 and abs(filling_elapsed - round(filling_elapsed)) < 0.15:
                with lock:
                    _reg_buf_len   = len(reg_time_buffer)
                    _spike_blocked = int(spike_blocked_count)
                print(
                    f'\n[D진단] t={filling_elapsed:.1f}s'
                    f' | init_f={_init_f:.0f}Hz'
                    f' | raw_f={raw_f_for_reg:.0f}Hz'
                    f' | reg_buf={_reg_buf_len}'
                    f' | spikes={_spike_blocked}'
                    f' | D={_cur_d:.2f}cm'
                    f' | cand={_cand_cnt}/{DIAM_CAND_MAXLEN}'
                )

            if _init_f > 0 and raw_f_for_reg > _init_f * 1.005 and raw_f_for_reg < _init_f * 4.0:
                current_inv = 1.0 / raw_f_for_reg
                with lock:
                    _buf_snapshot = list(reg_inv_freq_buffer)
                if len(_buf_snapshot) >= 5:
                    recent_median = float(np.median(_buf_snapshot[-5:]))
                    spike = abs(current_inv - recent_median) / (recent_median + 1e-12) > REG_SPIKE_GATE
                else:
                    spike = False
                if not spike:
                    with lock:
                        reg_time_buffer.append(filling_elapsed)
                        reg_inv_freq_buffer.append(current_inv)
                        _reg_len_now = len(reg_time_buffer)
                    if _reg_len_now > REG_MIN_POINTS:
                        _reg_event.set()
                else:
                    with lock:
                        spike_blocked_count += 1
            else:
                if int(filling_elapsed) % 3 == 0 and abs(filling_elapsed - round(filling_elapsed)) < 0.15:
                    if _init_f == 0:
                        print(f'\n[D진단] ❌ initial_stable_freq 아직 0')
                    elif raw_f_for_reg <= _init_f * 1.005:
                        print(f'\n[D진단] ❌ raw_f({raw_f_for_reg:.0f}) ≤ init_f({_init_f:.0f})*1.005')
                    elif raw_f_for_reg >= _init_f * 4.0:
                        print(f'\n[D진단] ⚠ raw_f({raw_f_for_reg:.0f}) ≥ init_f({_init_f:.0f})*4.0 → 배음 의심, 제외')

        # ── 9단계: 정지 판단 [PCT] [v5.21-ZONE-ADV] ─────────────────
        with lock:
            _tf2       = float(target_freq)
            _cd        = bool(calibration_done)
            _cur_d2    = float(current_diameter)
            _init_air  = float(init_air_len_cm)

        if filling_elapsed > CONTROL_START_TIME and _cd and stable_f > 0:
            current_air = SOUND_SPEED / (4 * stable_f) - END_CORRECTION_K * _cur_d2
            with lock:
                last_current_air = float(current_air)

            if _init_air > 0:
                fill_pct = max(0.0, min(100.0, (1.0 - current_air / _init_air) * 100.0))
                with lock:
                    last_fill_pct = fill_pct

                # [v5.21-ZONE-ADV] 구간별 advance 합산
                zone_adv = _get_zone_advance(fill_pct)
                total_advance = STOP_ADVANCE_PCT + zone_adv

                trigger = (fill_pct >= TARGET_FILL_PCT - total_advance)
            else:
                fill_pct = 0.0
                zone_adv = 0.0
                total_advance = STOP_ADVANCE_PCT
                trigger  = False

            with lock:
                if trigger:
                    consecutive_stop_hits += 1
                elif consecutive_stop_hits > 0:
                    consecutive_stop_hits = max(0, consecutive_stop_hits - 1)
                _hits = int(consecutive_stop_hits)

            if current_time - last_print_time >= PRINT_INTERVAL:
                mode_str = '[T]' if tracking_mode else '   '
                lock_str = '[R]' if theory_locked  else '   '
                fin_str  = '[F]' if in_final        else '   '
                bar_len  = min(_hits, STOP_TRIGGER_COUNT)
                bar      = '#' * bar_len + '-' * (STOP_TRIGGER_COUNT - bar_len)
                # [v5.21] 구간 정보 표시
                adv_str = f' adv:{total_advance:+.0f}%' if zone_adv > 0 else ''
                if _init_air > 0:
                    print(
                        f'{mode_str}{lock_str}{fin_str}[제어] D:{_cur_d2:.2f}cm '
                        f'| Level:{fill_pct:.1f}%/{TARGET_FILL_PCT:.1f}%{adv_str} '
                        f'| α:{alpha_det:.2f} '
                        f'| {stable_f:.0f}Hz [{bar}]',
                        end='\r'
                    )
                else:
                    print(
                        f'{mode_str}{lock_str}{fin_str}[제어] D:{_cur_d2:.2f}cm '
                        f'| L:{current_air:.2f}cm (측정중) '
                        f'| {stable_f:.0f}Hz [{bar}]',
                        end='\r'
                    )
                last_print_time = current_time

            if _hits >= STOP_TRIGGER_COUNT:
                print(f'\n[완료] 목표 도달! D:{_cur_d2:.4f}cm | Level:{fill_pct:.1f}%'
                      f' (adv:{total_advance:+.0f}%) | L_est:{current_air:.2f}cm')
                solenoid_off_async()
                with lock:
                    history_freq_snapshot = list(history_freq)
                    is_filling     = False
                    request_finish = True
                return

    except Exception:
        return


# ════════════════════════════════════════════════════════════════════
#  오디오 스트림 관리
# ════════════════════════════════════════════════════════════════════
def ensure_audio_stream():
    global audio_stream
    if audio_stream is not None:
        return
    audio_stream = sd.InputStream(
        device=INPUT_DEVICE,
        callback=audio_callback,
        channels=1,
        samplerate=SAMPLE_RATE,
        blocksize=CHUNK_SIZE,
    )
    audio_stream.start()
