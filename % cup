void handleDfPlayerMessage() {                    // DFPlayer 상태 메시지 처리
  if (!mp3.available()) {                         // 메시지가 없으면
    return;                                       // 함수 종료
  }

  uint8_t type = mp3.readType();                  // 메시지 종류 읽기
  int value = mp3.read();                         // 메시지 값 읽기

  if (type == DFPlayerPlayFinished) {             // 음원 재생 완료 시
    if (systemActive && currentTrack > 0) {        // 시스템 동작 중이면
      int repeatTrack = currentTrack;             // 반복할 음원 저장
      currentTrack = 0;                           // 같은 음원 재시작 허용
      playTrack(repeatTrack);                     // 같은 음원 반복 재생
    }
  } else if (type == DFPlayerError) {             // DFPlayer 오류 발생 시
    Serial.print("DFPlayer 오류 코드: ");         // 오류 출력
    Serial.println(value);                        // 오류 코드 출력
    currentTrack = 0;                             // 오류 시 현재 음원 초기화
  }
}

