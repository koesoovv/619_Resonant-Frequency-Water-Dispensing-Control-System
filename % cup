  page += "<p class='small'>초음파 20cm 이내 3회 연속 감지 시 알림 정지</p>"; // 설명
  page += "<p class='small'>SD카드 파일명: /mp3/0001.mp3, /mp3/0002.mp3</p>"; // 설명
  page += "</div>";                                // 박스 종료
  page += "</body></html>";                        // HTML 종료

  return page;                                     // 웹페이지 반환
}

