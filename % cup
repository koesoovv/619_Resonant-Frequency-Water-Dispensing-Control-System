void setVolumeSafe(int vol) {                     // 볼륨 안전 설정 함수
  if (vol < MIN_VOLUME) vol = MIN_VOLUME;         // 최소 볼륨 제한
  if (vol > MAX_VOLUME) vol = MAX_VOLUME;         // 최대 볼륨 제한

  currentVolume = vol;                            // 현재 볼륨 저장
  mp3.volume(currentVolume);                      // DFPlayer 볼륨 적용

  Serial.print("현재 볼륨: ");                    // 볼륨 출력
  Serial.println(currentVolume);                  // 현재 볼륨 출력
}

void playTrack(int trackNum, bool force = false) {                 // 특정 음원 재생 함수
  unsigned long now = millis();                                    // 현재 시간 저장

  if (!force && currentTrack == trackNum) {                        // 같은 음원이면
    return;                                                        // 중복 재생 방지
  }

  if (!force && now - lastMp3CommandTime < MP3_COMMAND_INTERVAL) {  // 명령 간격이 너무 짧으면
    return;                                                        // 명령 무시
  }

  lastMp3CommandTime = now;                                        // 마지막 명령 시간 갱신

  mp3.stop();                                                      // 기존 재생 정지
  delay(80);                                                       // DFPlayer 안정화 대기

  mp3.playMp3Folder(trackNum);                                     // /mp3/0001.mp3 또는 /mp3/0002.mp3 재생
  currentTrack = trackNum;                                         // 현재 음원 번호 저장

  Serial.print("재생 음원: 000");                                  // 재생 상태 출력
  Serial.print(trackNum);                                          // 음원 번호 출력
  Serial.println(".mp3");                                          // 확장자 출력
}

bool isCupPresentByIr() {                         // IR 기준 컵 감지 함수
  int irValue = digitalRead(IR_PIN);              // IR 값 읽기
  return irValue == IR_ACTIVE_VALUE;              // 감지값과 같으면 컵 있음
}

void applyStableIrState(bool cupPresent) {        // 안정화된 IR 상태를 음원에 반영
  stableCupPresent = cupPresent;                  // 안정화 상태 저장

  if (cupPresent) {                               // 컵이 있으면
    if (currentTrack != TRACK_CUP_EXISTS) {       // 현재 음원이 컵 있음 음원이 아니면
      playTrack(TRACK_CUP_EXISTS, true);          // 0002.mp3 강제 재생
    }
  } else {                                        // 컵이 없으면
    if (currentTrack != TRACK_NO_CUP) {           // 현재 음원이 컵 없음 음원이 아니면
      playTrack(TRACK_NO_CUP, true);              // 0001.mp3 강제 재생
    }
  }
}

void startSystem() {                              // 알림 시작 함수
  systemActive = true;                            // 시스템 ON
  systemStartTime = millis();                     // 시작 시간 저장

  ultraCount = 0;                                 // 초음파 카운트 초기화
  irActiveCount = 0;                              // IR 감지 카운트 초기화
  irInactiveCount = 0;                            // IR 미감지 카운트 초기화

  cupFound = false;                               // 컵 찾음 초기화
  lastStopReason = "running";                     // 동작 중 상태 저장
  cupFoundTime = 0;                               // 컵 찾은 시간 초기화
  currentTrack = 0;                               // 현재 음원 초기화

  bool cupPresent = isCupPresentByIr();           // 시작 순간 IR 상태 확인

  if (cupPresent) {                               // 시작 시 컵이 있으면
    irActiveCount = NEED_IR_COUNT;                // 감지 상태로 초기화
    irInactiveCount = 0;                          // 미감지 카운트 초기화
    applyStableIrState(true);                     // 0002.mp3 재생
  } else {                                        // 시작 시 컵이 없으면
    irActiveCount = 0;                            // 감지 카운트 초기화
    irInactiveCount = NEED_IR_COUNT;              // 미감지 상태로 초기화
    applyStableIrState(false);                    // 0001.mp3 재생
  }

  Serial.println("시스템 시작");                  // 상태 출력
}

void stopSystem(bool foundByUltrasonic = false) { // 알림 정지 함수
  systemActive = false;                           // 시스템 OFF

  ultraCount = 0;                                 // 초음파 카운트 초기화
  irActiveCount = 0;                              // IR 감지 카운트 초기화
  irInactiveCount = 0;                            // IR 미감지 카운트 초기화
  currentTrack = 0;                               // 현재 음원 초기화

  mp3.stop();                                     // DFPlayer 재생 정지
  delay(50);                                      // 정지 안정화 대기

  if (foundByUltrasonic) {                        // 초음파로 정지된 경우
    cupFound = true;                              // 컵 찾음 처리
    lastStopReason = "ultrasonic";                // 정지 원인 저장
    cupFoundTime = millis();                      // 컵 찾은 시간 저장
    Serial.println("초음파 감지 -> 컵 찾음 처리"); // 상태 출력
  } else {                                        // 수동 정지인 경우
    lastStopReason = "manual";                    // 수동 정지 저장
    Serial.println("수동 정지");                  // 상태 출력
  }
}

float readDistanceCm() {                          // 초음파 거리 측정 함수
  digitalWrite(TRIG_PIN, LOW);                    // TRIG LOW 초기화
  delayMicroseconds(5);                           // 5us 대기

  digitalWrite(TRIG_PIN, HIGH);                   // TRIG HIGH 출력
  delayMicroseconds(10);                          // 10us 펄스 출력
  digitalWrite(TRIG_PIN, LOW);                    // TRIG LOW 종료

  unsigned long duration = pulseIn(ECHO_PIN, HIGH, 30000UL); // ECHO HIGH 시간 측정

  if (duration == 0) {                            // ECHO 신호가 없으면
    return -1.0;                                  // 측정 실패 반환
  }

  return duration * 0.0343 / 2.0;                 // cm 단위 거리 계산
}

void updateUltrasonic() {                         // 초음파 거리값 갱신 함수
  unsigned long now = millis();                   // 현재 시간 저장

  if (now - lastMeasureTime < MEASURE_INTERVAL) { // 측정 주기가 아니면
    return;                                       // 함수 종료
  }

  lastMeasureTime = now;                          // 마지막 측정 시간 갱신
  lastDistance = readDistanceCm();                // 초음파 거리 측정

  if (!systemActive) {                            // 시스템이 꺼져 있으면
    ultraCount = 0;                               // 카운트 초기화
    return;                                       // 정지 판단 안 함
  }

  if (now - systemStartTime < ULTRA_IGNORE_TIME) { // 시작 직후 보호 시간
    ultraCount = 0;                               // 카운트 초기화
    return;                                       // 정지 판단 안 함
  }

  if (lastDistance < 0) {                         // 측정 실패이면
    ultraCount = 0;                               // 카운트 초기화
    Serial.println("초음파 측정 실패: -1");       // 실패 출력
    return;                                       // 정지 판단 안 함
  }

  if (lastDistance <= STOP_DISTANCE_CM) {         // 20cm 이내이면
    ultraCount++;                                 // 연속 감지 증가
  } else {                                        // 20cm 밖이면
    ultraCount = 0;                               // 연속 감지 초기화
  }

  if (ultraCount >= NEED_ULTRA_COUNT) {           // 3회 연속 감지이면
    stopSystem(true);                             // 컵 찾음 처리 후 정지
  }
}

void checkIrAndSelectSound() {                    // IR 상태에 따라 음원 선택
  unsigned long now = millis();                   // 현재 시간 저장

  if (now - lastIrCheckTime < IR_CHECK_INTERVAL) { // 확인 주기가 아니면
    return;                                       // 함수 종료
  }

  lastIrCheckTime = now;                          // 마지막 확인 시간 갱신

  bool cupPresent = isCupPresentByIr();           // IR 기준 컵 있음/없음 판단

  if (cupPresent) {                               // 컵이 감지되면
    irActiveCount++;                              // 감지 카운트 증가
    irInactiveCount = 0;                          // 미감지 카운트 초기화
  } else {                                        // 컵이 감지되지 않으면
    irInactiveCount++;                            // 미감지 카운트 증가
    irActiveCount = 0;                            // 감지 카운트 초기화
  }

  if (irActiveCount >= NEED_IR_COUNT) {           // 컵 있음이 3회 연속이면
    applyStableIrState(true);                     // 컵 있음 음원으로 전환
  }

  if (irInactiveCount >= NEED_IR_COUNT) {         // 컵 없음이 3회 연속이면
    applyStableIrState(false);                    // 컵 없음 음원으로 전환
  }
}

