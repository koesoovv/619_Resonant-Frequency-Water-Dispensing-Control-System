void handleApiStatus() {                           // 상태 확인 API
  String json = "{";                               // JSON 시작

  json += "\"active\":";                           // 동작 상태 키
  json += (systemActive ? "true" : "false");       // 동작 상태 값
  json += ",";                                     // 쉼표

  json += "\"cup_found\":";                        // 컵 찾음 키
  json += (cupFound ? "true" : "false");           // 컵 찾음 값
  json += ",";                                     // 쉼표

  json += "\"ir_raw\":";                           // IR 원시값 키
  json += String(digitalRead(IR_PIN));              // IR 원시값
  json += ",";                                     // 쉼표

  json += "\"ir_cup_present\":";                   // IR 컵 판정 키
  json += (isCupPresentByIr() ? "true" : "false"); // IR 컵 판정 값
  json += ",";                                     // 쉼표

  json += "\"stable_cup_present\":";               // 안정화 컵 상태 키
  json += (stableCupPresent ? "true" : "false");   // 안정화 컵 상태 값
  json += ",";                                     // 쉼표

  json += "\"distance_cm\":";                      // 거리 키
  json += String(lastDistance, 1);                  // 거리 값
  json += ",";                                     // 쉼표

  json += "\"ir_active_count\":";                  // IR 감지 카운트 키
  json += String(irActiveCount);                    // IR 감지 카운트 값
  json += ",";                                     // 쉼표

  json += "\"ir_inactive_count\":";                // IR 미감지 카운트 키
  json += String(irInactiveCount);                  // IR 미감지 카운트 값
  json += ",";                                     // 쉼표

  json += "\"ultra_count\":";                      // 초음파 카운트 키
  json += String(ultraCount);                       // 초음파 카운트 값
  json += ",";                                     // 쉼표

  json += "\"track\":";                            // 현재 음원 키
  json += String(currentTrack);                     // 현재 음원 값
  json += ",";                                     // 쉼표

  json += "\"volume\":";                           // 볼륨 키
  json += String(currentVolume);                    // 볼륨 값
  json += ",";                                     // 쉼표

  json += "\"stop_reason\":\"";                    // 정지 원인 키
  json += lastStopReason;                           // 정지 원인 값
  json += "\"";                                    // 문자열 종료

  json += "}";                                     // JSON 종료

  server.send(200, "application/json", json);       // JSON 응답
}

void setup() {                                      // 처음 한 번 실행
  Serial.begin(115200);                             // 시리얼 모니터 시작
  delay(1500);                                      // 시리얼 안정화 대기

  pinMode(TRIG_PIN, OUTPUT);                        // 초음파 TRIG 출력 설정
  pinMode(ECHO_PIN, INPUT);                         // 초음파 ECHO 입력 설정
  pinMode(IR_PIN, INPUT_PULLUP);                    // IR 입력 풀업 설정
  digitalWrite(TRIG_PIN, LOW);                      // TRIG 초기값 LOW

  Serial.println();                                 // 줄바꿈
  Serial.println("Nano ESP32 컵 위치 알림 시스템 시작"); // 시작 문구 출력

  dfSerial.begin(9600, SERIAL_8N1, DF_RX_PIN, DF_TX_PIN); // DFPlayer UART 시작
  delay(1500);                                      // DFPlayer 부팅 대기

  if (!mp3.begin(dfSerial, false, true)) {           // DFPlayer 초기화
    Serial.println("DFPlayer 연결 실패");           // 실패 출력
    Serial.println("배선, SD카드, 전원 확인");      // 확인 항목 출력

    while (true) {                                   // 실패 시 정지
      delay(1000);                                   // 1초 대기
    }
  }

  Serial.println("DFPlayer 연결 성공");              // 성공 출력

  mp3.setTimeOut(500);                              // 응답 대기 시간 설정
  setVolumeSafe(currentVolume);                     // 시작 볼륨 적용
  mp3.EQ(DFPLAYER_EQ_NORMAL);                       // 기본 EQ 설정
  mp3.outputDevice(DFPLAYER_DEVICE_SD);             // SD카드 출력 설정

  WiFi.mode(WIFI_STA);                              // Wi-Fi 클라이언트 모드 설정
  WiFi.begin(ssid, password);                       // Wi-Fi 연결 시작

  Serial.print("Wi-Fi 연결 중");                    // 연결 상태 출력

  while (WiFi.status() != WL_CONNECTED) {           // Wi-Fi 연결 대기
    delay(500);                                     // 0.5초 대기
    Serial.print(".");                              // 진행 표시
  }

  Serial.println();                                 // 줄바꿈
  Serial.println("Wi-Fi 연결 완료");                // 연결 완료 출력

  espIp = WiFi.localIP().toString();                // IP 주소 저장

  Serial.print("ESP32 IP 주소: ");                  // IP 출력
  Serial.println(espIp);                            // IP 출력

  server.on("/", handleRoot);                       // 메인 페이지 등록
  server.on("/start", handleStart);                 // 시작 버튼 등록
  server.on("/stop", handleStop);                   // 정지 버튼 등록
  server.on("/volup", handleVolumeUp);              // 볼륨 증가 등록
  server.on("/voldown", handleVolumeDown);          // 볼륨 감소 등록
  server.on("/test1", handleTest1);                 // 0001 테스트 등록
  server.on("/test2", handleTest2);                 // 0002 테스트 등록

  server.on("/api/start", handleApiStart);          // 시작 API 등록
  server.on("/api/stop", handleApiStop);            // 정지 API 등록
  server.on("/api/reset", handleApiReset);          // 리셋 API 등록
  server.on("/api/status", handleApiStatus);        // 상태 API 등록
  server.on("/api/play1", handleApiPlay1);          // 0001 테스트 API 등록
  server.on("/api/play2", handleApiPlay2);          // 0002 테스트 API 등록

  server.begin();                                   // 웹서버 시작

  Serial.println("브라우저에서 아래 주소 접속");    // 접속 안내
  Serial.print("http://");                          // 주소 앞부분
  Serial.println(espIp);                            // IP 출력
}

void loop() {                                       // 계속 반복
  server.handleClient();                            // 웹 요청 처리
  updateUltrasonic();                               // 초음파 측정 및 정지 판단
  printStatus();                                    // 상태 출력
  handleDfPlayerMessage();                          // DFPlayer 상태 처리

  if (systemActive) {                               // 시스템 동작 중이면
    checkIrAndSelectSound();                        // IR 상태에 따라 음원 선택
  }
}
