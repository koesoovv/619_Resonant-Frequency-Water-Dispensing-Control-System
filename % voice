def rms(audio):
    if audio is None or audio.size == 0:
        return 0.0
    return float(np.sqrt(np.mean(audio ** 2)))


def clean_audio(audio):
    cleaned = audio.copy()
    if NOISE_REDUCE:
        try:
            cleaned = nr.reduce_noise(
                y=cleaned, sr=VOICE_SAMPLE_RATE,
                stationary=False, prop_decrease=0.35,
                n_fft=512, hop_length=128,
            )
        except Exception as e:
            log_dbg(f'noisereduce 오류: {e}')
    r = rms(cleaned)
    if r > 0.0001:
        cleaned = np.clip(cleaned * min(TARGET_RMS / r, MAX_GAIN), -1.0, 1.0)
    return cleaned.astype(np.float32)


def collect_speech(stream, vad_model, max_seconds):
    if max_seconds <= 0:
        return None
    pre_roll_n = max(1, int(PRE_ROLL_MS   / VAD_CHUNK_MS))
    pad_n      = max(1, int(SPEECH_PAD_MS / VAD_CHUNK_MS))
    min_n      = max(1, int(MIN_SPEECH_MS / VAD_CHUNK_MS))
    max_chunks = int(max_seconds * 1000 / VAD_CHUNK_MS)

    pre_roll      = collections.deque(maxlen=pre_roll_n)
    speech_frames = []
    speaking      = False
    silence_cnt   = 0

    vad_model.reset_states()
    for _ in range(max_chunks):
        try:
            data, _ = stream.read(VAD_CHUNK_SIZE)
        except Exception:
            break
        chunk = (data[:, 0] if data.ndim > 1 else data.flatten()).astype(np.float32)
        prob  = vad_model(torch.from_numpy(chunk), VOICE_SAMPLE_RATE).item()

        if not speaking:
            pre_roll.append(chunk.copy())
            if prob >= VAD_THRESHOLD:
                speaking    = True
                silence_cnt = 0
                speech_frames.extend(list(pre_roll))
                log_dbg(f'음성 감지 ({prob:.0%})')
        else:
            speech_frames.append(chunk.copy())
            if prob >= VAD_THRESHOLD:
                silence_cnt = 0
            else:
                silence_cnt += 1
                if silence_cnt >= pad_n:
                    break

    vad_model.reset_states()
    if not speech_frames or len(speech_frames) < min_n:
        return None
    audio = np.concatenate(speech_frames)
    if rms(audio) < MIN_RMS_FOR_STT:
        return None
    return audio


_recognizer = sr.Recognizer()


def transcribe_google(audio_np):
    if audio_np is None or audio_np.size == 0:
        return ''
    cleaned = clean_audio(audio_np)
    try:
        audio_data = sr.AudioData(
            (cleaned * 32767).astype(np.int16).tobytes(),
            VOICE_SAMPLE_RATE, 2,
        )
        text = _recognizer.recognize_google(audio_data, language='ko-KR')
        log_dbg(f'Google STT: "{text}"')
        return text.strip()
    except sr.UnknownValueError:
        return ''
    except sr.RequestError as e:
        log_info(f'[WARN] STT 네트워크 오류: {e}')
        return ''
    except Exception as e:
        log_info(f'[ERROR] STT 오류: {e}')
        return ''


def listen_text(stream, vad_model, max_seconds):
    audio = collect_speech(stream, vad_model, max_seconds)
    if audio is None:
        return ''
    text = transcribe_google(audio)
    if text:
        log_info(f'[STT] 인식됨: "{text}"')
    return text

