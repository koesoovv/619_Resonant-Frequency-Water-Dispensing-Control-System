async def _make_tts(text: str):
    comm = edge_tts.Communicate(
        text=text, voice=TTS_VOICE,
        rate=TTS_RATE, volume=TTS_VOLUME, pitch=TTS_PITCH,
    )
    await comm.save(TTS_FILE)


def speak(text: str):
    log_info(f'[TTS] "{text}"')
    if not USE_TTS:
        return
    try:
        asyncio.run(_make_tts(text))
        subprocess.run(
            ['ffmpeg', '-y', '-i', TTS_FILE, '-f', 'alsa', 'plughw:4,0'],
            timeout=15,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
        if os.path.exists(TTS_FILE):
            os.remove(TTS_FILE)
    except Exception as e:
        log_info(f'TTS 오류: {e}')


def _play_sound_once(path: str):
    global _dispenser_proc
    try:
        _dispenser_proc = subprocess.Popen(
            ['ffmpeg', '-y', '-i', path, '-f', 'alsa', 'plughw:4,0'],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            preexec_fn=os.setsid,
        )
        _dispenser_proc.wait()
    except Exception as e:
        log_info(f'[WARN] 음원 재생 실패: {e}')
    finally:
        _dispenser_proc = None


def action_dispenser_location():
    """0001.mp3 를 도착할 때까지 반복 재생 (별도 스레드)."""
    log_result('정수기 위치 안내 실행')
    _dispenser_sound_stop.clear()

    def _loop():
        while not _dispenser_sound_stop.is_set():
            if not os.path.exists(DISPENSER_SOUND_PATH):
                log_info(f'[WARN] 음원 파일 없음: {DISPENSER_SOUND_PATH}')
                break
            _play_sound_once(DISPENSER_SOUND_PATH)
            if not _dispenser_sound_stop.is_set():
                time.sleep(0.2)

    threading.Thread(target=_loop, daemon=True).start()


def stop_dispenser_sound():
    """ffmpeg 프로세스를 프로세스 그룹 단위로 즉시 강제 종료."""
    global _dispenser_proc
    _dispenser_sound_stop.set()

    proc = _dispenser_proc
    if proc and proc.poll() is None:
        try:
            os.killpg(os.getpgid(proc.pid), signal.SIGKILL)
        except Exception as e:
            log_dbg(f'음원 강제 종료 오류: {e}')
            try:
                proc.kill()
            except Exception:
                pass
        try:
            proc.wait(timeout=2)
        except Exception:
            pass

    _dispenser_proc = None
    time.sleep(0.3)
    log_info('[SOUND] 정수기 안내 음원 즉시 정지')


