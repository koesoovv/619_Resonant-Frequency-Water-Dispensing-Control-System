    """
    사용자 GUI 자동 정지에서도 급수 완료 안내를 보장한다.
    인식률 관련 VAD/STT/전처리 파라미터는 변경하지 않는다.
    """
    global _last_finish_tts_time

    now = time.time()
    with _finish_tts_lock:
        if now - _last_finish_tts_time < 4.0:                  # 중복 안내 방지
            return
        _last_finish_tts_time = now                            # 마지막 안내 시각 갱신

