async def _make_tts(text: str):
    comm = edge_tts.Communicate(
        text=text, voice=TTS_VOICE,
        rate=TTS_RATE, volume=TTS_VOLUME, pitch=TTS_PITCH,
    )
    await comm.save(TTS_FILE)


def _tts_gui_state(text: str):
    """TTS 안내 문장을 사용자 GUI에 표시하기 위해 core 상태값에 저장한다."""
    try:
        import smart_water_core as core                         # 순환 import 방지용 함수 내부 import
        clean_text = str(text).strip()                           # None/공백 문장 방지
        if not clean_text:                                       # 빈 문장이면 표시하지 않음
            return
        with core.lock:                                          # GUI 주기 갱신과 충돌 방지
            core.last_tts_text = clean_text                      # GUI에 표시할 안내 문장
            core.last_tts_time = time.time()                     # 마지막 안내 시각
    except Exception as e:
        log_dbg(f'TTS GUI 상태 갱신 오류: {e}')                  # 실패해도 TTS 자체는 계속 진행


