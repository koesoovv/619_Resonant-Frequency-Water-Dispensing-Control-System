def cup_locator_start():
    try:
        r = requests.get(CUP_LOCATOR_URL + '/api/start', timeout=2)
        log_info(f'컵 위치 알림 시작 요청: {r.status_code}')
        return r.status_code == 200
    except Exception as e:
        log_info(f'컵 위치 알림 시작 실패: {e}')
        return False

def cup_locator_stop():
    try:
        r = requests.get(CUP_LOCATOR_URL + '/api/stop', timeout=2)
        log_info(f'컵 위치 알림 정지 요청: {r.status_code}')
        return r.status_code == 200
    except Exception as e:
        log_info(f'컵 위치 알림 정지 실패: {e}')
        return False

def cup_locator_reset():
    try:
        r = requests.get(CUP_LOCATOR_URL + '/api/reset', timeout=2)
        return r.status_code == 200
    except Exception as e:
        log_info(f'컵 위치 상태 초기화 실패: {e}')
        return False

def is_cup_found() -> bool:
    try:
        r = requests.get(CUP_LOCATOR_URL + '/api/status', timeout=2)
        if r.status_code != 200:
            return False
        status = r.json()
        if DEBUG:
            log_dbg(f'컵 위치 알림 상태: {status}')
        return bool(status.get('cup_found', False))
    except Exception as e:
        log_info(f'컵 위치 상태 확인 실패: {e}')
        return False

