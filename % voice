_GPIO_READY = False
_trig_pin   = None
_echo_pin   = None


def _init_ultrasonic():
    global _GPIO_READY, _trig_pin, _echo_pin
    if _GPIO_READY:
        return
    try:
        from gpiozero import OutputDevice as _OD, InputDevice as _ID
        _trig_pin   = _OD(ULTRASONIC_TRIG_GPIO, initial_value=False)
        _echo_pin   = _ID(ULTRASONIC_ECHO_GPIO, pull_up=False)
        _GPIO_READY = True
        log_info(f'초음파 GPIO 초기화 완료 (TRIG={ULTRASONIC_TRIG_GPIO}, ECHO={ULTRASONIC_ECHO_GPIO})')
    except Exception as e:
        log_info(f'[WARN] 초음파 GPIO 초기화 실패: {e}')


def _measure_distance_cm() -> float:
    if not _GPIO_READY or _trig_pin is None or _echo_pin is None:
        return 9999.0
    try:
        _trig_pin.off()
        time.sleep(0.000002)
        _trig_pin.on()
        time.sleep(0.00001)
        _trig_pin.off()

        t0 = time.time()
        while not _echo_pin.value:
            if time.time() - t0 > ULTRASONIC_TIMEOUT:
                return 9999.0
        echo_start = time.time()

        while _echo_pin.value:
            if time.time() - echo_start > ULTRASONIC_TIMEOUT:
                return 9999.0
        echo_end = time.time()

        return round((echo_end - echo_start) * 34300.0 / 2.0, 1)
    except Exception as e:
        log_dbg(f'초음파 측정 오류: {e}')
        return 9999.0


def is_dispenser_arrived() -> bool:
    hit = 0
    for _ in range(ARRIVED_CONFIRM_CNT):
        dist = _measure_distance_cm()
        if DEBUG:
            log_dbg(f'초음파 거리: {dist:.1f} cm')
        if dist <= ARRIVED_DISTANCE_CM:
            hit += 1
        time.sleep(0.05)
    arrived = hit >= ARRIVED_CONFIRM_CNT
    if arrived:
        log_result('정수기 도착 감지', f'초음파 {hit}/{ARRIVED_CONFIRM_CNT}회 확인')
    return arrived

