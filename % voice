def find_respeaker_device():
    keywords = ['respeaker', 'seeed', 'xmos', 'xu316']
    for idx, dev in enumerate(sd.query_devices()):
        if dev['max_input_channels'] > 0:
            for kw in keywords:
                if kw in dev['name'].lower():
                    return idx, dev['name']
    return None, None

