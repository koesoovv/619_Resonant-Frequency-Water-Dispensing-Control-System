def _get_vad_model():
    """silero-VAD 모델을 1회만 로드해 캐시 후 재사용한다."""
    global _vad_model_cache
    with _vad_model_lock:
        if _vad_model_cache is None:
            log_info('silero-VAD 로드 중...')
            model, _ = torch.hub.load(
                repo_or_dir='snakers4/silero-vad',
                model='silero_vad',
                force_reload=False,
                trust_repo=True,
            )
            _vad_model_cache = model
            log_info('silero-VAD 로드 완료')
        else:
            log_info('silero-VAD 캐시 재사용')
        return _vad_model_cache

