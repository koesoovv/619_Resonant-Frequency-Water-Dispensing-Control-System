#  오디오 처리 (음성인식용)
# ════════════════════════════════════════════════════════════════════

def rms(audio):
    if audio is None or audio.size == 0:
        return 0.0
    return float(np.sqrt(np.mean(audio ** 2)))


def clean_audio(audio):
    """STT 입력용 전처리. noisereduce 후 RMS를 TARGET_RMS 근처로 맞춘다."""
    cleaned = audio.copy().astype(np.float32)
    if NOISE_REDUCE:
        time.sleep(0.001)   # GIL 양보: 무거운 noisereduce 직전에 GUI에 실행 기회를 준다.
        try:
            cleaned = nr.reduce_noise(
                y=cleaned, sr=VOICE_SAMPLE_RATE,
                stationary=False, prop_decrease=NOISE_PROP_DECREASE,
                n_fft=512, hop_length=128,
            ).astype(np.float32)
        except Exception as e:
            log_dbg(f'noisereduce 오류: {e}')
        time.sleep(0.001)   # GIL 양보: noisereduce 직후 GUI 프레임이 밀린 만큼 따라잡게 한다.
    r = rms(cleaned)
    if r > 0.0001:
        gain = min(TARGET_RMS / r, MAX_GAIN)
        cleaned = np.clip(cleaned * gain, -1.0, 1.0)
    return cleaned.astype(np.float32)


def _voice_gui_state(active=None, volume=None, text=None):
    """사용자 GUI의 음성 아우라/인식 문장 표시용 상태값을 갱신한다."""
    try:
        import smart_water_core as core
        with core.lock:
            if active is not None:
                core.voice_active = bool(active)
            if volume is not None:
                core.mic_volume = max(0.0, min(1.0, float(volume)))
            if text is not None:
                core.last_recognized_text = str(text)
                core.last_recognized_time = time.time()
    except Exception as e:
        log_dbg(f'음성 GUI 상태 갱신 오류: {e}')


def _chunk_volume(chunk):
    """마이크 RMS를 GUI 아우라 크기용 0.0~1.0 값으로 변환한다."""
    return max(0.0, min(1.0, rms(chunk) * 18.0))


def collect_speech(stream, vad_model, max_seconds):
    _voice_gui_state(active=False, volume=0.0)
    _voice_ready_gui_state(True, VOICE_READY_TEXT)               # 이 함수가 시작된 순간부터 실제 발화 수신 가능

    if max_seconds <= 0:
        return None

    pre_roll_n = max(1, int(PRE_ROLL_MS   / VAD_CHUNK_MS))
    pad_n      = max(1, int(SPEECH_PAD_MS / VAD_CHUNK_MS))
    min_n      = max(1, int(MIN_SPEECH_MS / VAD_CHUNK_MS))
    max_chunks = int(max_seconds * 1000 / VAD_CHUNK_MS)

    pre_roll      = collections.deque(maxlen=pre_roll_n)
    speech_frames = []
    speaking      = False
    silence_cnt   = 0
    read_fail_count = 0

    # 발화 대기 카운트다운(남은 발화 가능 시간) 표시용.
    # 매 VAD 청크(~32ms)마다 갱신하면 GIL 부하가 커지므로 0.2초에 한 번만 GUI 상태를 갱신한다.
    listen_start_t   = time.time()
    last_remain_push = 0.0
    REMAIN_PUSH_INTERVAL = 0.2

    vad_model.reset_states()
    try:
        for _ in range(max_chunks):
            try:
                data, _ = stream.read(VAD_CHUNK_SIZE)
                read_fail_count = 0
            except Exception as e:
                read_fail_count += 1
                log_info(f'[VOICE_READ_ERROR] {type(e).__name__}: {e} ({read_fail_count}/{VOICE_READ_FAIL_LIMIT})')
                _voice_gui_state(active=False, volume=0.0, text='음성 입력 오류')
                if read_fail_count >= VOICE_READ_FAIL_LIMIT:
                    raise RuntimeError('음성 마이크 스트림 read 연속 실패') from e
                time.sleep(0.05)
                continue

            chunk = (data[:, 0] if data.ndim > 1 else data.flatten()).astype(np.float32)
            prob  = vad_model(torch.from_numpy(chunk), VOICE_SAMPLE_RATE).item()

            if not speaking:
                pre_roll.append(chunk.copy())

                # 아직 발화 시작 전: 남은 발화 가능 시간을 0.2초마다 GUI에 갱신한다.
                now_remain = time.time()
                if now_remain - last_remain_push >= REMAIN_PUSH_INTERVAL:
                    remain = max(0.0, max_seconds - (now_remain - listen_start_t))
                    _voice_ready_gui_state(remain_sec=remain)
                    last_remain_push = now_remain

                if prob >= VAD_THRESHOLD:
                    speaking    = True
                    silence_cnt = 0
                    speech_frames.extend(list(pre_roll))
                    _voice_ready_gui_state(False, '듣는 중...', remain_sec=-1)  # 발화 시작 → 카운트다운 종료
                    _voice_gui_state(active=True, volume=_chunk_volume(chunk))
                    log_dbg(f'음성 감지 ({prob:.0%})')
            else:
                speech_frames.append(chunk.copy())
                _voice_gui_state(active=True, volume=_chunk_volume(chunk))

                if prob >= VAD_THRESHOLD:
                    silence_cnt = 0
                else:
                    silence_cnt += 1
                    if silence_cnt >= pad_n:
                        break

            # GIL 양보점: 매 VAD 청크 처리 후 짧게 실제로 양보해 GUI 메인 스레드(아우라)가
            # 55ms 주기를 지킬 틈을 확실히 준다. sleep(0)은 양보 보장이 없어 1ms 실제 sleep으로 강화.
            # VAD 청크 간격(수십 ms) 대비 1ms는 무시할 수준이라 인식 타이밍/정확도는 불변.
            time.sleep(0.001)
    finally:
        vad_model.reset_states()
        _voice_gui_state(active=False, volume=0.0)
        _voice_ready_gui_state(remain_sec=-1)   # 수신 종료 → 카운트다운 표시 해제

    if not speech_frames or len(speech_frames) < min_n:
        return None

    audio = np.concatenate(speech_frames)
    if rms(audio) < MIN_RMS_FOR_STT:
        return None

    return audio


_recognizer = sr.Recognizer()


def _parse_google_alternatives(result):
    """Google STT show_all 결과에서 후보 문장 목록을 뽑는다."""
    alternatives = []
    if not result:
        return alternatives
    if isinstance(result, dict):
        for item in result.get('alternative', []):
            text = str(item.get('transcript', '')).strip()
            conf = item.get('confidence', None)
            if text:
                alternatives.append((text, conf))
    elif isinstance(result, str):
        text = result.strip()
        if text:
            alternatives.append((text, None))
    return alternatives


def _hangul_count(text):
    """한글 글자 수를 계산한다."""
    return len(re.findall(r'[가-힣]', str(text)))


def _english_count(text):
    """영문 글자 수를 계산한다."""
    return len(re.findall(r'[A-Za-z]', str(text)))


def _stt_candidate_score(text):
    """프로젝트 명령어에 가까운 STT 후보에 점수를 준다."""
    if not text:
        return -9999.0

    raw = str(text).strip()
    n = _norm(raw)
    shown = voice_display_text(raw)
    sn = _norm(shown)
    score = 0.0

    if any(_norm(w) in n for w in WAKE_WORDS) or any(_norm(w) in sn for w in WAKE_WORDS):
        score += 100.0
    if detect_pour_start_command(raw) or detect_pour_start_command(shown):
        score += 80.0
    if detect_stop_command(raw) or detect_stop_command(shown):
        score += 80.0
    if detect_location_command(raw)[0] != 'UNKNOWN' or detect_location_command(shown)[0] != 'UNKNOWN':
        score += 60.0
    if detect_arrival_command(raw) or detect_arrival_command(shown):
        score += 50.0

    level_ok, _, level_reason = detect_level_command(raw)
    shown_level_ok, _, shown_level_reason = detect_level_command(shown)
    if level_ok or shown_level_ok:
        score += 70.0
    elif level_reason != 'NONE' or shown_level_reason != 'NONE':
        score += 20.0

    project_words = [
        '물', '불', '급수', '정수기', '컵',
        '따라', '따라줘', '받아', '받아줘', '깔아', '깔아줘', '빨아', '빨아줘',
        '멈춰', '정지', '위치', '찾아', '퍼센트', '프로',
    ]
    for word in project_words:
        if _norm(word) in n or _norm(word) in sn:
            score += 10.0

    score += min(_hangul_count(raw), 24) * 0.5
    score -= _english_count(raw) * 2.0
    return score


def _audio_to_google_alternatives(audio_np, label):
    """오디오 하나를 Google STT에 넣고 후보 문장을 반환한다."""
    if audio_np is None or audio_np.size == 0:
        return []
    try:
        audio_i16 = (np.clip(audio_np, -1.0, 1.0) * 32767).astype(np.int16)
        audio_data = sr.AudioData(audio_i16.tobytes(), VOICE_SAMPLE_RATE, 2)
        result = _recognizer.recognize_google(
            audio_data,
            language='ko-KR',
            show_all=True,
        )
        alternatives = _parse_google_alternatives(result)
        for text, conf in alternatives:
            log_dbg(f'[STT-{label}] 후보: "{text}" | conf={conf}')
        return alternatives
    except sr.UnknownValueError:
        log_dbg(f'[STT-{label}] UnknownValueError')
        return []
    except sr.RequestError as e:
        log_info(f'[WARN] STT 네트워크 오류({label}): {e}')
        return []
    except Exception as e:
        log_info(f'[ERROR] STT 오류({label}): {e}')
        return []


def _select_best_stt_candidate(candidates):
    """STT 후보 중 프로젝트 명령어에 가장 가까운 문장을 선택한다."""
    if not candidates:
        return None
    candidates.sort(
        key=lambda x: (x['score'], x['confidence']),
        reverse=True,
    )
    return candidates[0]


def transcribe_google(audio_np):
    """
    clean 음성을 우선 STT에 넣고, 결과가 약하면 raw 음성 후보까지 확인한다.
    STT 실패 여부와 관계없이 voice_loop는 계속 살아 있도록 빈 문자열만 반환한다.
    """
    if audio_np is None or audio_np.size == 0:
        return ''

    raw_audio = audio_np.astype(np.float32)
    clean_np = clean_audio(raw_audio)
    candidates = []

    clean_alternatives = _audio_to_google_alternatives(clean_np, 'CLEAN')
    for text, conf in clean_alternatives:
        candidates.append({
            'label': 'CLEAN',
            'text': text,
            'display': voice_display_text(text),
            'score': _stt_candidate_score(text),
            'confidence': float(conf) if conf is not None else 0.0,
        })

    best_clean = _select_best_stt_candidate(candidates[:])

    # clean 결과가 프로젝트 명령어로 충분히 확실하면 raw 요청을 생략해 네트워크/CPU 부하를 줄인다.
    if best_clean is not None and best_clean['score'] >= 60.0:
        log_info(
            f'[STT] 선택: {best_clean["label"]} | '
            f'raw="{best_clean["text"]}" | '
            f'display="{best_clean["display"]}" | '
            f'score={best_clean["score"]:.1f}'
        )
        return best_clean['text'].strip()

    raw_alternatives = _audio_to_google_alternatives(raw_audio, 'RAW')
    for text, conf in raw_alternatives:
        candidates.append({
            'label': 'RAW',
            'text': text,
            'display': voice_display_text(text),
            'score': _stt_candidate_score(text),
            'confidence': float(conf) if conf is not None else 0.0,
        })

    best = _select_best_stt_candidate(candidates)
    if best is None:
        return ''

    log_info(
        f'[STT] 선택: {best["label"]} | '
        f'raw="{best["text"]}" | '
        f'display="{best["display"]}" | '
        f'score={best["score"]:.1f}'
    )
    return best['text'].strip()


def listen_text(stream, vad_model, max_seconds):
    audio = collect_speech(stream, vad_model, max_seconds)
    if audio is None:
        return ''

    _voice_ready_gui_state(False, VOICE_PROCESS_TEXT)             # STT 처리 중에는 말해도 반영되지 않음
    text = transcribe_google(audio)
    if text:
        shown_text = voice_display_text(text)
        _voice_gui_state(text=shown_text)
        log_info(f'[STT] 인식됨: "{shown_text}"')
    else:
        _voice_gui_state(text='인식 실패')
        _voice_ready_gui_state(True, '다시 말씀해 주세요')          # 실패해도 바로 다음 발화 대기 상태로 복귀

    return text

