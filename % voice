#  명령 판정
# ════════════════════════════════════════════════════════════════════

def _contains_any(text, keywords):
    return any(kw in text for kw in keywords)

def _norm(text):
    return text.lower().replace(' ', '')

def check_wake_word(text):
    n     = _norm(text)
    clean = re.sub(r'[^\w]', '', text)
    if len(clean) < 2:
        return False
    return any(_norm(w) in n for w in WAKE_WORDS)

def detect_stop_command(text):
    return _contains_any(_norm(text), [_norm(k) for k in KW_STOP])

def detect_cancel_command(text):
    return _contains_any(_norm(text), [_norm(k) for k in KW_CANCEL])

def detect_location_command(text):
    t             = _norm(text)
    has_dispenser = _contains_any(t, [_norm(k) for k in KW_DISPENSER])
    has_cup       = _contains_any(t, [_norm(k) for k in KW_CUP])
    has_location  = _contains_any(t, [_norm(k) for k in KW_LOCATION])
    if has_cup and not has_dispenser:
        return 'CUP_LOCATION',       text, 1.0 if has_location else 0.8
    if has_dispenser and has_location:
        return 'DISPENSER_LOCATION', text, 1.0
    if has_dispenser:
        return 'DISPENSER_LOCATION', text, 0.8
    return 'UNKNOWN', text, 0.0

def detect_arrival_command(text):
    return _contains_any(_norm(text), [_norm(k) for k in KW_ARRIVAL])

def detect_level_command(text):
    t = _norm(text)
    m = re.search(r'(\d+)\s*(%|퍼센트|프로)', text)
    if m:
        lvl = int(m.group(1))
        if 0 < lvl <= 100:
            return True, lvl
    m = re.search(r'\b(\d{1,3})\b', text)
    if m:
        lvl = int(m.group(1))
        if 0 < lvl <= 100:
            return True, lvl
    for word, lvl in LEVEL_WORD_MAP.items():
        if _norm(word) in t:
            return True, lvl
    return False, None

def detect_pour_start_command(text):
    t       = _norm(text)
    directs = ['물줘','물따라줘','물받아줘','물틀어줘',
               '급수시작','급수해줘','따라줘','받아줘']
    if _contains_any(t, [_norm(k) for k in directs]):
        return True
    return (_contains_any(t, [_norm(k) for k in KW_WATER]) and
            _contains_any(t, [_norm(k) for k in KW_START]))

# ════════════════════════════════════════════════════════════════════
#  음성인식 메인 루프
# ════════════════════════════════════════════════════════════════════

def voice_loop():
    log_info('silero-VAD 로드 중...')
    vad_model, _ = torch.hub.load(
        repo_or_dir='snakers4/silero-vad',
        model='silero_vad',
        force_reload=False,
        trust_repo=True,
    )
    log_info('silero-VAD 로드 완료')

    mic_idx, mic_name = find_respeaker_device()
    if VOICE_MIC_DEVICE is not None:
        mic_idx  = VOICE_MIC_DEVICE
        mic_name = '수동 설정'
    log_info(f'마이크: [{mic_idx}] {mic_name}' if mic_idx is not None else '마이크: 기본 장치')

    stream = sd.InputStream(
        samplerate=VOICE_SAMPLE_RATE,
        channels=VOICE_CHANNELS,
        dtype='float32',
        device=mic_idx,
        blocksize=VAD_CHUNK_SIZE,
    )
    stream.start()
    log_info('음성인식 오디오 스트림 시작')

    _init_ultrasonic()

    mode             = MODE_SLEEP
    selected_level   = None
    state_start_time = time.time()
    last_tts_time    = 0.0
    header_printed   = False
    stt_fail_count   = 0

    def change_mode(new_mode):
        nonlocal mode, state_start_time, header_printed, stt_fail_count
        mode             = new_mode
        state_start_time = time.time()
        header_printed   = False
        stt_fail_count   = 0

    def tts(text):
        nonlocal last_tts_time
        speak(text)
        last_tts_time = time.time()

    try:
        while True:
            if _shutdown.is_set():         # 
                log_info('음성인식 루프 종료')  #
                break                       #
            if time.time() - last_tts_time < TTS_COOLDOWN:
                time.sleep(0.05)
                continue

            now           = time.time()
            elapsed_state = now - state_start_time

            # ── SLEEP ─────────────────────────────────────────────────
            if mode == MODE_SLEEP:
                if not header_printed:
                    log_header('절전모드 - "지니야"라고 말하면 시작합니다')
                    header_printed = True
                text = listen_text(stream, vad_model, MAX_WAKE_SEC)
                if not text:
                    continue
                if check_wake_word(text):
                    log_result('호출어 인식 성공', f'"{text}"')
                    tts('무엇을 찾을까요? 정수기 위치 또는 컵 위치를 말해주세요')
                    change_mode(MODE_LOCATION_COMMAND)
                else:
                    log_info(f'호출어 아님: "{text}"')

            # ── LOCATION_COMMAND ───────────────────────────────────────
            elif mode == MODE_LOCATION_COMMAND:
                if not header_printed:
                    log_header('위치 선택 대기 - 정수기 위치 또는 컵 위치를 말하세요')
                    header_printed = True
                if elapsed_state > LOCATION_TIMEOUT:
                    tts('시간이 초과되었습니다')
                    change_mode(MODE_SLEEP)
                    continue
                text = listen_text(stream, vad_model, MAX_CMD_SEC)
                if not text:
                    continue
                if detect_cancel_command(text):
                    tts('취소합니다')
                    change_mode(MODE_SLEEP)
                    continue
                cmd, _, _ = detect_location_command(text)
                if cmd == 'CUP_LOCATION':
                    log_result('명령 인식: 컵 위치', f'"{text}"')
                    tts('컵 위치를 안내합니다. 컵을 찾으면 자동으로 정수기 위치 안내를 시작합니다')
                    action_cup_location()
                    change_mode(MODE_WAIT_CUP_FOUND)
                elif cmd == 'DISPENSER_LOCATION':
                    log_result('명령 인식: 정수기 위치', f'"{text}"')
                    tts('정수기 위치를 안내합니다')
                    action_dispenser_location()
                    change_mode(MODE_WAIT_DISPENSER_ARRIVAL)
                else:
                    stt_fail_count += 1
                    log_info(f'위치 명령 아님: "{text}"')
                    if stt_fail_count >= 2:
                        tts('정수기 위치 또는 컵 위치 중 하나를 말해주세요')
                        stt_fail_count = 0

            # ── WAIT_CUP_FOUND ─────────────────────────────────────────
            elif mode == MODE_WAIT_CUP_FOUND:
                if not header_printed:
                    log_header('컵 찾기 대기 - ESP32 컵 위치 알림 동작 중')
                    header_printed = True
                if elapsed_state > CUP_FOUND_TIMEOUT:
                    cup_locator_stop()
                    tts('컵 찾기 시간이 초과되었습니다')
                    change_mode(MODE_SLEEP)
                    continue
                if is_cup_found():
                    log_result('컵 찾음 확인', 'ESP32 초음파 감지 완료')
                    cup_locator_reset()
                    tts('컵을 찾았습니다. 정수기 위치를 안내합니다')
                    action_dispenser_location()
                    change_mode(MODE_WAIT_DISPENSER_ARRIVAL)
                    continue
                time.sleep(CUP_POLL_INTERVAL)

            # ── WAIT_DISPENSER_ARRIVAL ─────────────────────────────────
            elif mode == MODE_WAIT_DISPENSER_ARRIVAL:
                if not header_printed:
                    log_header('정수기 도착 대기 - 초음파 자동 감지 중')
                    header_printed = True
                if elapsed_state > ARRIVAL_TIMEOUT:
                    stop_dispenser_sound()
                    tts('시간이 초과되었습니다')
                    change_mode(MODE_SLEEP)
                    continue
                if is_dispenser_arrived():
                    stop_dispenser_sound()
                    tts('정수기 앞에 도착하셨군요. 급수량을 선택해 주세요')
                    change_mode(MODE_SELECT_LEVEL)
                    continue
                time.sleep(0.05)

            # ── SELECT_LEVEL ───────────────────────────────────────────
            elif mode == MODE_SELECT_LEVEL:
                if not header_printed:
                    log_header('급수량 선택 - 70%, 80%, 반만, 가득 등을 말하세요')
                    header_printed = True
                if elapsed_state > LEVEL_TIMEOUT:
                    tts('시간이 초과되었습니다')
                    change_mode(MODE_SLEEP)
                    continue
                text = listen_text(stream, vad_model, MAX_CMD_SEC)
                if not text:
                    continue
                if detect_cancel_command(text):
                    tts('취소합니다')
                    change_mode(MODE_SLEEP)
                    continue
                level_ok, level = detect_level_command(text)
                if level_ok:
                    selected_level = level
                    set_water_level(selected_level)   # 코어 + GUI 반영
                    tts(f'수위를 {selected_level}퍼센트로 설정합니다. 물이 필요하면 물 줘라고 말해주세요')
                    change_mode(MODE_READY_TO_POUR)
                elif detect_pour_start_command(text):
                    tts('먼저 급수량을 선택해 주세요')
                else:
                    stt_fail_count += 1
                    log_info(f'급수량 인식 실패: "{text}"')
                    if stt_fail_count >= 2:
                        tts('70퍼센트, 80퍼센트, 반만, 가득 중에서 말해주세요')
                        stt_fail_count = 0

            # ── READY_TO_POUR ──────────────────────────────────────────
            elif mode == MODE_READY_TO_POUR:
                if not header_printed:
                    log_header('급수 시작 대기 - 물 줘, 물 따라줘, 급수 시작 등을 말하세요')
                    header_printed = True
                if elapsed_state > READY_TIMEOUT:
                    tts('시간이 초과되었습니다')
                    change_mode(MODE_SLEEP)
                    continue
                text = listen_text(stream, vad_model, MAX_CMD_SEC)
                if not text:
                    continue
                if detect_cancel_command(text):
                    tts('취소합니다')
                    change_mode(MODE_SLEEP)
                    continue
                if detect_stop_command(text):
                    tts('급수를 취소합니다')
                    change_mode(MODE_SLEEP)
                    continue
                level_ok, level = detect_level_command(text)
                if level_ok:
                    selected_level = level
                    set_water_level(selected_level)   # 코어 + GUI 반영
                    tts(f'수위를 {selected_level}퍼센트로 다시 설정합니다. 물 줘라고 말해주세요')
                    continue
                if detect_pour_start_command(text):
                    if selected_level is None:
                        tts('먼저 급수량을 선택해 주세요')
                        change_mode(MODE_SELECT_LEVEL)
                    else:
                        log_result('급수 시작 명령 인식', f'"{text}"')
                        voice_start_water()
                        tts('급수를 시작합니다')
                        change_mode(MODE_POURING)
                else:
                    log_info(f'급수 시작 명령 아님: "{text}"')

            # ── POURING ────────────────────────────────────────────────
            elif mode == MODE_POURING:
                if not header_printed:
                    log_header('급수 중 - 멈춰, 정지, 그만이라고 말하면 즉시 멈춥니다')
                    header_printed = True

                # 급수가 외부(GUI 버튼, 목표 도달)에서 종료됐는지 체크
                import smart_water_core as _core
                with _core.lock:
                    still_filling = bool(_core.is_filling)

                if not still_filling:
                    log_result('급수 종료 감지 (외부 정지 또는 목표 도달)')
                    tts('급수가 완료되었습니다')
                    selected_level = None
                    change_mode(MODE_SLEEP)
                    continue

                text = listen_text(stream, vad_model, POUR_LISTEN_SEC)
                if not text:
                    continue

                if detect_stop_command(text):
                    log_result('급수 정지 명령 인식', f'"{text}"')
                    voice_stop_water()
                    tts('급수를 멈춥니다')
                    selected_level = None
                    change_mode(MODE_SLEEP)
                else:
                    log_info(f'급수 중 입력 무시: "{text}"')

    except Exception as e:
        log_info(f'[ERROR] voice_loop 예외: {e}')
    finally:
        stream.stop()
        stream.close()
        log_info('음성인식 오디오 스트림 종료')

