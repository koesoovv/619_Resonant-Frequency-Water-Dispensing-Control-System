#  명령 판정
# ════════════════════════════════════════════════════════════════════

def _contains_any(text, keywords):
    return any(kw in text for kw in keywords)

def _norm(text):
    return text.lower().replace(' ', '')

def check_wake_word(text):
    n     = _norm(text)
    clean = re.sub(r'[^\w]', '', text)
    # 한 글자 호출어(예: 샘, 쌤)도 인식되도록 2글자 제한을 제거한다.
    if len(clean) < 1:
        return False
    return any(_norm(w) in n for w in WAKE_WORDS)

def detect_stop_command(text):
    return _contains_any(_norm(text), [_norm(k) for k in KW_STOP])

def detect_cancel_command(text):
    return _contains_any(_norm(text), [_norm(k) for k in KW_CANCEL])

def detect_location_command(text):
    t             = _norm(text)
    has_dispenser = _contains_any(t, [_norm(k) for k in KW_DISPENSER])
    has_cup       = _contains_any(t, [_norm(k) for k in KW_CUP])
    has_location  = _contains_any(t, [_norm(k) for k in KW_LOCATION])
    if has_cup and not has_dispenser:
        return 'CUP_LOCATION',       text, 1.0 if has_location else 0.8
    if has_dispenser and has_location:
        return 'DISPENSER_LOCATION', text, 1.0
    if has_dispenser:
        return 'DISPENSER_LOCATION', text, 0.8
    return 'UNKNOWN', text, 0.0

def detect_arrival_command(text):
    return _contains_any(_norm(text), [_norm(k) for k in KW_ARRIVAL])


def detect_yes_command(text):
    """정수기 위치 안내 여부 확인용 긍정 응답 판정."""
    t = _norm(text)
    yes_words = [
        '응', '네', '예', '어', '좋아', '맞아', '맞어', '그래',
        'ㅇ', '오케이', 'ok', '안내해', '알려줘', '해줘', '시작', '그대로',
    ]
    return _contains_any(t, [_norm(k) for k in yes_words])

def _validate_level_value(lvl):
    if lvl < 50:
        return False, None, 'LOW'
    if lvl > 90:
        return False, None, 'HIGH'
    if lvl % 10 != 0:
        return False, None, 'NOT_STEP'
    if lvl not in VALID_LEVELS:
        return False, None, 'NOT_ALLOWED'
    return True, lvl, 'OK'


def get_level_error_message(reason):
    if reason == 'LOW':
        return '급수량은 50퍼센트부터 90퍼센트까지 10퍼센트 단위로만 설정할 수 있습니다'
    if reason == 'HIGH':
        return '최대 급수량은 90퍼센트까지만 가능합니다'
    if reason in ('NOT_STEP', 'NOT_ALLOWED'):
        return '급수량은 50, 60, 70, 80, 90퍼센트 중 하나로 설정해 주세요'
    return ''


def detect_level_command(text):
    t = _norm(text)
    m = re.search(r'(\d+)\s*(%|퍼센트|프로)', text)
    if m:
        lvl = int(m.group(1))
        return _validate_level_value(lvl)
    m = re.search(r'\b(\d{1,3})\b', text)
    if m:
        lvl = int(m.group(1))
        return _validate_level_value(lvl)
    for word, lvl in LEVEL_WORD_MAP.items():
        if _norm(word) in t:
            return True, lvl, 'OK'
    return False, None, 'NONE'


def detect_pour_start_command(text):
    t       = _norm(text)
    directs = [
        '물줘', '물따라줘', '물받아줘', '물틀어줘',
        '급수시작', '급수해줘',
        '따라줘', '받아줘',
        '깔아줘', '빨아줘', '깔 아줘', '빨 아줘', '깔아 줘', '빨아 줘',
    ]
    if _contains_any(t, [_norm(k) for k in directs]):
        return True
    return (_contains_any(t, [_norm(k) for k in KW_WATER]) and
            _contains_any(t, [_norm(k) for k in KW_START]))

# GUI 표시용 호출어 보정은 DISPLAY_WORD_GROUPS에서 처리하지 않는다.
# 이유: '새미야' 안의 '새미', '미야'가 반복 치환되어 '새새새미미미야야야'처럼 깨질 수 있기 때문이다.
DISPLAY_WAKE_ALIASES = [
    '새미야', '세미야', '샘이야', '쌤이야',
    '지니야', '진이야', '지니아', '진희야', '제니야', '시리야', '시니어',
    '최미영', '세비야', '지니', '지니어', '지니 야',
    '도비야', '우석아', '가희야', '세 명',
    '세미', '새미', '미야', '샘',
    '먹고싶다', '마시고싶다', '아쿠야', '덕배야',
]


def _display_compact(text: str) -> str:
    """호출어 표시 보정용 비교 문자열을 만든다."""
    return re.sub(r'\s+', '', str(text).lower().strip())


def _clean_display_spaces(text: str) -> str:
    """중복 공백을 정리한다."""
    return re.sub(r'\s+', ' ', str(text)).strip()


def _display_similarity(a: str, b: str) -> float:
    """GUI 표시 보정용 문자열 유사도 계산."""
    aa = _norm(a)
    bb = _norm(b)
    if not aa or not bb:
        return 0.0
    return difflib.SequenceMatcher(None, aa, bb).ratio()


def _replace_display_phrases(text: str) -> str:
    """DISPLAY_WORD_GROUPS의 phrase/substring 별칭을 먼저 치환한다."""
    result = str(text)
    replacements = []

    for group in DISPLAY_WORD_GROUPS:
        canonical = str(group.get('canonical', '')).strip()
        mode = str(group.get('mode', 'phrase')).strip()
        if not canonical or mode not in ('phrase', 'substring'):
            continue
        for alias in group.get('aliases', []):
            alias = str(alias).strip()
            if not alias:
                continue
            replacements.append((alias, canonical))

    # 긴 별칭부터 바꿔야 "물 좀 줘"가 "물 줘"보다 먼저 안정적으로 처리된다.
    for alias, canonical in sorted(replacements, key=lambda x: len(x[0]), reverse=True):
        result = re.sub(re.escape(alias), canonical, result, flags=re.IGNORECASE)

    return _clean_display_spaces(result)


def _replace_display_tokens(text: str) -> str:
    """token/fuzzy 보정. 띄어쓰기 단위 단어만 안전하게 치환한다."""
    parts = re.split(r'(\s+)', str(text))
    out = []

    for part in parts:
        if not part or part.isspace():
            out.append(part)
            continue

        # 앞뒤 문장부호는 보존한다.
        m = re.match(r'^([^0-9A-Za-z가-힣]*)([0-9A-Za-z가-힣%]+)([^0-9A-Za-z가-힣]*)$', part)
        if not m:
            out.append(part)
            continue

        prefix, token, suffix = m.groups()
        token_norm = _norm(token)
        replaced = None

        for group in DISPLAY_WORD_GROUPS:
            canonical = str(group.get('canonical', '')).strip()
            mode = str(group.get('mode', 'phrase')).strip()
            aliases = [str(a).strip() for a in group.get('aliases', []) if str(a).strip()]
            fuzzy = bool(group.get('fuzzy', False))
            threshold = float(group.get('threshold', 0.85))

            if not canonical:
                continue

            # token 모드는 정확히 같은 단어만 치환한다.
            if mode == 'token':
                if token_norm in [_norm(a) for a in aliases + [canonical]]:
                    replaced = canonical
                    break

            # fuzzy는 token 단위에서만 수행해 과도한 부분 치환을 막는다.
            if fuzzy and len(token_norm) >= 2:
                candidates = aliases + [canonical]
                best = max((_display_similarity(token, c) for c in candidates), default=0.0)
                if best >= threshold:
                    replaced = canonical
                    break

        out.append(prefix + (replaced if replaced is not None else token) + suffix)

    return _clean_display_spaces(''.join(out))


def normalize_display_text(text: str) -> str:
    """
    STT 원문을 사용자 GUI 표시용 문장으로 정리한다.
    내부 명령 판정에는 영향 없음.
    """
    if not text:
        return ''

    shown = str(text).strip()
    shown = _replace_display_phrases(shown)
    shown = _replace_display_tokens(shown)
    return _clean_display_spaces(shown)


def voice_display_text(text):
    """STT 원문을 사용자 GUI/로그 표시용 표준 문장으로 변환한다."""
    if not text:                                             # 빈 입력 방지
        return ''                                            # GUI에는 빈 문자열 표시

    raw = str(text).strip()                                  # STT 결과 원문 정리
    raw_compact = _display_compact(raw)                      # 호출어 비교용 문자열

    for alias in DISPLAY_WAKE_ALIASES:                       
        if raw_compact == _display_compact(alias):            
            return '세미야'                                  

    shown = raw                                              # 호출어가 아니면 일반 표시 보정 진행
    shown = _replace_display_phrases(shown)                  # phrase/substring 별칭 치환
    shown = _replace_display_tokens(shown)                   # token/fuzzy 별칭 치환
    return _clean_display_spaces(shown)                      # 중복 공백 제거 후 반환

