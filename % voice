def voice_loop():
    """
    지니야 → 네 부르셨나요? → 명령 지능형 분기
    기존 기능(정수기/컵 위치, 도착 대기, 급수량 선택 등) 모두 유지.
    """
    # silero-VAD는 프로세스당 1회만 로드한다(캐시 재사용).
    # 급수 후 입력 스트림을 재시작해도 무거운 torch.hub.load가 반복되지 않게 한다.
    vad_model = _get_vad_model()

    # 진단용: 살아 있는 voice_loop 인스턴스 수 증가. 정상이면 1이어야 한다.
    global _voice_loop_active_count
    with _voice_loop_count_lock:
        _voice_loop_active_count += 1
        _vl_count_now = _voice_loop_active_count
    log_info(f'[DIAG] voice_loop 진입 — 활성 인스턴스 수={_vl_count_now}'
             + ('  *** 중복 실행 의심 ***' if _vl_count_now > 1 else ''))

    mic_idx, mic_name = find_respeaker_device()
    if VOICE_MIC_DEVICE is not None:
        mic_idx  = VOICE_MIC_DEVICE
        mic_name = '수동 설정'
    log_info(f'마이크: [{mic_idx}] {mic_name}' if mic_idx is not None
             else '마이크: 기본 장치')

    def _open_voice_stream():
        """음성 입력 sounddevice 스트림을 새로 열어 start까지 한다."""
        s = sd.InputStream(
            samplerate=VOICE_SAMPLE_RATE,
            channels=VOICE_CHANNELS,
            dtype='float32',
            device=mic_idx,
            blocksize=VAD_CHUNK_SIZE,
        )
        s.start()
        return s

    def _restart_voice_stream(old_stream):
        """기존 스트림을 닫고 새 스트림을 연다. voice_loop는 죽이지 않는다."""
        try:
            old_stream.stop()
        except Exception:
            pass
        try:
            old_stream.close()
        except Exception:
            pass
        new_stream = _open_voice_stream()
        log_info('음성인식 오디오 스트림 재시작(루프 유지)')
        return new_stream

    stream = _open_voice_stream()
    log_info('음성인식 오디오 스트림 시작')

    _init_ultrasonic()

    import smart_water_core as _core

    mode                = MODE_SLEEP
    selected_level      = None
    voice_confirmed_pct = None   # 음성으로 명시 설정한 수위만 추적 (GUI 기본값 무시)
    state_start_time    = time.time()
    last_tts_time       = 0.0
    header_printed      = False
    stt_fail_count      = 0

    def change_mode(new_mode):
        nonlocal mode, state_start_time, header_printed, stt_fail_count
        mode             = new_mode
        state_start_time = time.time()
        header_printed   = False
        stt_fail_count   = 0

    def tts(text):
        nonlocal last_tts_time
        speak(text)
        last_tts_time = time.time()

    def get_target_pct():
        """음성으로 명시 설정된 수위만 반환. 미설정이면 0.0."""
        return float(voice_confirmed_pct) if voice_confirmed_pct is not None else 0.0

    def _do_start_pour(announce=True):
        with _core.lock:
            already = bool(_core.is_filling)
        if already:
            tts('이미 급수 중입니다')
            return False
        voice_start_water()
        if announce:
            tts('급수를 시작합니다')
        change_mode(MODE_POURING)
        return True

    def _start_dispenser_guide():
        log_result('정수기 위치 안내 시작')
        tts('정수기 위치를 안내합니다')
        action_dispenser_location()
        change_mode(MODE_WAIT_DISPENSER_ARRIVAL)

    def _handle_general_command(text):
        """COMMAND 상태와 컵 찾은 뒤 대기 상태에서 공통으로 쓰는 명령 처리."""
        nonlocal selected_level, voice_confirmed_pct, stt_fail_count

        if detect_cancel_command(text):
            tts('취소합니다')
            change_mode(MODE_SLEEP)
            return True

        if detect_stop_command(text):
            with _core.lock:
                filling = bool(_core.is_filling)
            if filling:
                voice_stop_water()
                tts('급수를 멈춥니다')
                selected_level = None
                change_mode(MODE_SLEEP)
            else:
                tts('현재 급수 중이 아닙니다')
            return True

        cmd_loc, _, _ = detect_location_command(text)
        if cmd_loc == 'CUP_LOCATION':
            log_result('명령 인식: 컵 위치', f'"{voice_display_text(text)}"')
            tts('컵 위치를 안내합니다.')
            action_cup_location()
            change_mode(MODE_WAIT_CUP_FOUND)
            return True
        if cmd_loc == 'DISPENSER_LOCATION':
            log_result('명령 인식: 정수기 위치', f'"{voice_display_text(text)}"')
            _start_dispenser_guide()
            return True

        level_ok, level, level_reason = detect_level_command(text)
        has_water = detect_pour_start_command(text)

        if (not level_ok) and level_reason != 'NONE':
            tts(get_level_error_message(level_reason))
            return True

        if has_water and level_ok:
            selected_level      = level
            voice_confirmed_pct = level
            set_water_level(selected_level)
            tts(f'{selected_level}퍼센트로 설정하고 급수를 시작합니다')
            _do_start_pour(announce=False)
        elif has_water:
            pct = get_target_pct()
            if pct > 0:
                tts(f'현재 설정된 수위는 {int(pct)}퍼센트입니다. 그대로 하시겠습니까?')
                change_mode(MODE_CONFIRM_LEVEL)
            else:
                tts('목표 수위가 설정되지 않았습니다. 몇 퍼센트로 채워드릴까요?')
                change_mode(MODE_ASK_LEVEL)
        elif level_ok:
            selected_level      = level
            voice_confirmed_pct = level
            set_water_level(selected_level)
            tts(f'{selected_level}퍼센트로 설정했습니다. 물을 따라드릴까요?')
            # 방금 물을 따라드릴지 물었으므로, 다음 발화는 확인 응답으로 처리한다.
            # 기존처럼 COMMAND에 남아 있으면 "어 따라 줘"를 새 급수 명령으로 오해해
            # "현재 설정된 수위는 ... 그대로 하시겠습니까?"가 한 번 더 나오는 중복 현상이 생긴다.
            change_mode(MODE_CONFIRM_LEVEL)
        else:
            stt_fail_count += 1
            log_info(f'명령 인식 실패: "{voice_display_text(text)}"')
            if stt_fail_count >= 2:
                pct = get_target_pct()
                hint = (f'현재 목표 수위는 {int(pct)}퍼센트입니다. 물을 따라드릴까요?'
                        if pct > 0 else
                        '물 줘, 정수기 어디야, 또는 70퍼센트 따라줘처럼 말씀해 주세요')
                tts(hint)
                stt_fail_count = 0
        return True

    try:
        while True:
            if _shutdown.is_set():
                log_info('음성인식 루프 종료')
                break

            if _voice_audio_restart_request.is_set():
                _voice_audio_restart_request.clear()
                log_info('[VOICE_RESTART] 음성 입력 스트림 재시작 처리(루프 유지)')
                # 루프를 죽이지 않고 입력 스트림만 닫았다가 다시 연다.
                # voice_loop를 break하면 main.py watchdog이 새 스레드를 띄우면서
                # silero-VAD 재로드 + 스트림 중복 생성으로 GUI가 영구적으로 버벅인다.
                stream = _restart_voice_stream(stream)
                continue

            if time.time() - last_tts_time < TTS_COOLDOWN:
                time.sleep(0.05)
                continue

            now           = time.time()
            elapsed_state = now - state_start_time

            # SLEEP
            if mode == MODE_SLEEP:
                if not header_printed:
                    log_header('절전 모드 — "세미야"라고 부르면 시작합니다')
                    header_printed = True
                text = listen_text(stream, vad_model, MAX_WAKE_SEC)
                if not text:
                    continue
                if check_wake_word(text):
                    log_result('호출어 인식', f'"{voice_display_text(text)}"')
                    if '덕배' in text:
                        tts('멍멍. 부르지마라 ')
                    else:
                        tts('네 부르셨나요?')
                    change_mode(MODE_COMMAND)

            # MODE_COMMAND — 모든 명령 지능형 분기
            elif mode == MODE_COMMAND:
                if not header_printed:
                    log_header('명령 대기 — 물 줘 / 정수기 어디야 / 70% 따라줘 등')
                    header_printed = True
                if elapsed_state > COMMAND_TIMEOUT:
                    tts('시간이 초과되었습니다')
                    change_mode(MODE_SLEEP)
                    continue
                text = listen_text(stream, vad_model, MAX_CMD_SEC)
                if not text:
                    continue
                log_info(f'명령 입력: "{voice_display_text(text)}"')

                _handle_general_command(text)
                continue

            # MODE_CONFIRM_LEVEL — 현재 수위로 진행할지 확인
            elif mode == MODE_CONFIRM_LEVEL:
                if not header_printed:
                    log_header('수위 확인 대기 — 응/그래/줘 또는 다른 %로 변경')
                    header_printed = True
                if elapsed_state > LEVEL_TIMEOUT:
                    tts('시간이 초과되었습니다')
                    change_mode(MODE_SLEEP)
                    continue
                text = listen_text(stream, vad_model, MAX_CMD_SEC)
                if not text:
                    continue
                if detect_cancel_command(text):
                    tts('취소합니다')
                    change_mode(MODE_SLEEP)
                    continue
                # 새 수위 지정 → 해당 수위로 급수
                level_ok, level, level_reason = detect_level_command(text)
                if (not level_ok) and level_reason != 'NONE':
                    tts(get_level_error_message(level_reason))
                    continue
                if level_ok:
                    selected_level      = level
                    voice_confirmed_pct = level
                    set_water_level(selected_level)
                    tts(f'{selected_level}퍼센트로 설정하고 급수를 시작합니다')
                    _do_start_pour(announce=False)
                    continue
                # 긍정 응답 → 현재 수위 그대로 급수
                _CONFIRM_KW = ['응','네','어','좋아','맞아','그래','줘','물줘',
                               '시작','그렇게','그거','그대로','맞어','ㅇ']
                t_norm = text.replace(' ','').lower()
                if any(kw in t_norm for kw in _CONFIRM_KW) or detect_pour_start_command(text):
                    _do_start_pour(announce=True)
                else:
                    stt_fail_count += 1
                    log_info(f'확인 명령 인식 실패: "{voice_display_text(text)}"')
                    if stt_fail_count >= 2:
                        pct = get_target_pct()
                        tts(f'{int(pct)}퍼센트로 진행하려면 응, 다른 수위는 숫자로 말씀해 주세요')
                        stt_fail_count = 0

            # MODE_ASK_LEVEL — 수위 미설정 시 수위 질문
            elif mode == MODE_ASK_LEVEL:
                if not header_printed:
                    log_header('수위 입력 대기 — 70퍼센트 / 반만 / 가득 등')
                    header_printed = True
                if elapsed_state > LEVEL_TIMEOUT:
                    tts('시간이 초과되었습니다')
                    change_mode(MODE_SLEEP)
                    continue
                text = listen_text(stream, vad_model, MAX_CMD_SEC)
                if not text:
                    continue
                if detect_cancel_command(text):
                    tts('취소합니다')
                    change_mode(MODE_SLEEP)
                    continue
                level_ok, level, level_reason = detect_level_command(text)
                if (not level_ok) and level_reason != 'NONE':
                    tts(get_level_error_message(level_reason))
                    continue
                if level_ok:
                    selected_level      = level
                    voice_confirmed_pct = level
                    set_water_level(selected_level)
                    tts(f'{selected_level}퍼센트로 설정하고 급수를 시작합니다')
                    _do_start_pour(announce=False)
                else:
                    stt_fail_count += 1
                    if stt_fail_count >= 2:
                        tts('70퍼센트, 반만, 가득 중 하나로 말씀해 주세요')
                        stt_fail_count = 0

            # MODE_WAIT_CUP_FOUND — 기존 동일
            elif mode == MODE_WAIT_CUP_FOUND:
                if not header_printed:
                    log_header('컵 찾기 대기 - ESP32 컵 위치 알림 동작 중')
                    header_printed = True
                if elapsed_state > CUP_FOUND_TIMEOUT:
                    cup_locator_stop()
                    tts('컵 찾기 시간이 초과되었습니다')
                    change_mode(MODE_SLEEP)
                    continue
                if is_cup_found():
                    log_result('컵 찾음 확인', 'ESP32 초음파 감지 완료')
                    cup_locator_reset()
                    tts('컵을 찾았습니다. 정수기 위치를 안내할까요?')
                    change_mode(MODE_AFTER_CUP_FOUND)
                    continue
                time.sleep(CUP_POLL_INTERVAL)

            # MODE_AFTER_CUP_FOUND — 컵을 찾은 뒤 다음 명령 또는 정수기 안내 확인
            elif mode == MODE_AFTER_CUP_FOUND:
                if not header_printed:
                    log_header('컵 찾음 이후 대기 - 응/정수기 위치/물 줘/70퍼센트 등')
                    header_printed = True
                if elapsed_state > COMMAND_TIMEOUT:
                    tts('시간이 초과되었습니다')
                    change_mode(MODE_SLEEP)
                    continue
                text = listen_text(stream, vad_model, MAX_CMD_SEC)
                if not text:
                    continue
                log_info(f'컵 찾음 이후 입력: "{voice_display_text(text)}"')

                level_ok, level, level_reason = detect_level_command(text)
                has_water   = detect_pour_start_command(text)
                cmd_loc, _, _ = detect_location_command(text)

                if (not level_ok) and level_reason != 'NONE':
                    tts(get_level_error_message(level_reason))
                    continue

                # 사용자가 순수 긍정으로 답하면 정수기 위치 안내 시작.
                # 단, "70퍼센트로 해줘" 또는 "물 줘"처럼 실제 명령이면 그 명령을 우선 처리한다.
                if (not level_ok) and (not has_water) and (cmd_loc != 'CUP_LOCATION') and                    (cmd_loc == 'DISPENSER_LOCATION' or detect_yes_command(text)):
                    log_result('정수기 위치 안내 확인', f'"{voice_display_text(text)}"')
                    _start_dispenser_guide()
                    continue

                # 컵 찾은 뒤 "정수기 위치를 안내할까요?"라고 물은 상태에서는
                # "물 줘"를 다시 확인 질문으로 돌리지 말고 실제 급수 명령으로 처리한다.
                if has_water and (not level_ok) and get_target_pct() > 0:
                    log_result('컵 찾음 이후 급수 시작 명령', f'"{voice_display_text(text)}"')
                    _do_start_pour(announce=True)
                    continue

                _handle_general_command(text)
                continue

            # MODE_WAIT_DISPENSER_ARRIVAL — 기존 동일
            elif mode == MODE_WAIT_DISPENSER_ARRIVAL:
                if not header_printed:
                    log_header('정수기 도착 대기 - 초음파 자동 감지 중')
                    header_printed = True
                if elapsed_state > ARRIVAL_TIMEOUT:
                    stop_dispenser_sound()
                    tts('시간이 초과되었습니다')
                    change_mode(MODE_SLEEP)
                    continue
                if is_dispenser_arrived():
                    stop_dispenser_sound()
                    tts('정수기 앞에 도착하셨군요. 급수량을 선택해 주세요')
                    change_mode(MODE_SELECT_LEVEL)
                    continue
                time.sleep(0.05)

            # MODE_SELECT_LEVEL — 기존 동일
            elif mode == MODE_SELECT_LEVEL:
                if not header_printed:
                    log_header('급수량은 50, 60, 70, 80, 90퍼센트 중 하나로 말해주세요')
                    header_printed = True
                if elapsed_state > LEVEL_TIMEOUT:
                    tts('시간이 초과되었습니다')
                    change_mode(MODE_SLEEP)
                    continue
                text = listen_text(stream, vad_model, MAX_CMD_SEC)
                if not text:
                    continue
                if detect_cancel_command(text):
                    tts('취소합니다')
                    change_mode(MODE_SLEEP)
                    continue
                level_ok, level, level_reason = detect_level_command(text)
                if (not level_ok) and level_reason != 'NONE':
                    tts(get_level_error_message(level_reason))
                    continue
                if level_ok:
                    selected_level      = level
                    voice_confirmed_pct = level
                    set_water_level(selected_level)
                    tts(f'수위를 {selected_level}퍼센트로 설정합니다. 물이 필요하면 물 줘라고 말해주세요')
                    change_mode(MODE_READY_TO_POUR)
                elif detect_pour_start_command(text):
                    tts('먼저 급수량을 선택해 주세요')
                else:
                    stt_fail_count += 1
                    if stt_fail_count >= 2:
                        tts('급수량은 50, 60, 70, 80, 90퍼센트 중 하나로 말해주세요')
                        stt_fail_count = 0

            # MODE_READY_TO_POUR — 기존 동일
            elif mode == MODE_READY_TO_POUR:
                if not header_printed:
                    log_header('급수 시작 대기 - 물 줘, 물 따라줘 등을 말하세요')
                    header_printed = True
                if elapsed_state > READY_TIMEOUT:
                    tts('시간이 초과되었습니다')
                    change_mode(MODE_SLEEP)
                    continue
                text = listen_text(stream, vad_model, MAX_CMD_SEC)
                if not text:
                    continue
                if detect_cancel_command(text):
                    tts('취소합니다')
                    change_mode(MODE_SLEEP)
                    continue
                if detect_stop_command(text):
                    tts('급수를 취소합니다')
                    change_mode(MODE_SLEEP)
                    continue
                level_ok, level, level_reason = detect_level_command(text)
                if (not level_ok) and level_reason != 'NONE':
                    tts(get_level_error_message(level_reason))
                    continue
                if level_ok:
                    selected_level      = level
                    voice_confirmed_pct = level
                    set_water_level(selected_level)
                    tts(f'수위를 {selected_level}퍼센트로 다시 설정합니다. 물 줘라고 말해주세요')
                    continue
                if detect_pour_start_command(text):
                    if selected_level is None:
                        tts('먼저 급수량을 선택해 주세요')
                        change_mode(MODE_SELECT_LEVEL)
                    else:
                        log_result('급수 시작 명령 인식', f'"{voice_display_text(text)}"')
                        _do_start_pour(announce=True)
                else:
                    log_info(f'급수 시작 명령 아님: "{voice_display_text(text)}"')

            # MODE_POURING — 기존 동일
            elif mode == MODE_POURING:
                if not header_printed:
                    log_header('급수 중 - 멈춰, 정지, 그만이라고 말하면 즉시 멈춥니다')
                    header_printed = True
                with _core.lock:
                    still_filling = bool(_core.is_filling)
                if not still_filling:
                    log_result('급수 종료 감지 (외부 정지 또는 목표 도달)')
                    notify_water_finished(source='voice_loop')                # 중복 방지 포함 완료 안내
                    request_voice_audio_restart('pouring_finished')           # 급수 후 입력 스트림 재시작
                    selected_level = None
                    change_mode(MODE_SLEEP)
                    continue
                text = listen_text(stream, vad_model, POUR_LISTEN_SEC)
                if not text:
                    continue
                if detect_stop_command(text):
                    log_result('급수 정지 명령 인식', f'"{voice_display_text(text)}"')
                    voice_stop_water()
                    tts('급수를 멈춥니다')
                    selected_level = None
                    change_mode(MODE_SLEEP)
                else:
                    log_info(f'급수 중 입력 무시: "{voice_display_text(text)}"')

    except Exception as e:
        log_info(f'[ERROR] voice_loop 예외: {e}')
    finally:
        try:
            stream.stop()
        except Exception:
            pass
        try:
            stream.close()
        except Exception:
            pass
        with _voice_loop_count_lock:
            _voice_loop_active_count = max(0, _voice_loop_active_count - 1)
            _vl_count_now = _voice_loop_active_count
        _voice_gui_state(active=False, volume=0.0)
        _voice_ready_gui_state(False, '음성인식 재시작 중...')
        log_info(f'음성인식 오디오 스트림 종료 — 활성 voice_loop 수={_vl_count_now}')
