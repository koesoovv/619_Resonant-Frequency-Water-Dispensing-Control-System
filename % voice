def voice_start_water():
    import smart_water_core as core
    with core.lock:
        if core.is_filling:
            log_info('[급수] 이미 급수 중 — 시작 무시')
            return
    if _gui_on_cb:
        _gui_on_cb()
    else:
        core.ensure_audio_stream()
        core.start_filling_local()
        def _delayed():
            time.sleep(core.NOISE_CALIBRATION_TIME + 0.1)
            with core.lock:
                still = bool(core.is_filling)
            if still:
                core.solenoid_on()
        threading.Thread(target=_delayed, daemon=True).start()
    log_info('[급수] 시작 요청')


def voice_stop_water():
    import smart_water_core as core
    if _gui_off_cb:
        _gui_off_cb()
    else:
        core.solenoid_off()
        core.stop_filling_local(save_result=True)
    log_info('[급수] 정지 요청')


def is_water_target_reached() -> bool:
    import smart_water_core as core
    with core.lock:
        return bool(core.request_finish)

