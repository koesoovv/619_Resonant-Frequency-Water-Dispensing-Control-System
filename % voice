                core.voice_ready = bool(ready)                   # True이면 실제 음성 입력 대기 상태
            if text is not None:
                core.voice_ready_text = str(text)                # GUI에 표시할 대기/처리 상태 문구
                core.voice_ready_time = time.time()              # 마지막 상태 갱신 시각
            if remain_sec is not None:
                # 발화 대기 중 남은 시간(초). 음수 방지. -1이면 '표시 안 함' 의미로 사용.
                core.voice_remain_sec = float(remain_sec)        # GUI 카운트다운 표시용 남은 시간
                core.voice_remain_time = time.time()             # 남은 시간 갱신 시각(오래되면 GUI가 무시)
    except Exception as e:
        log_dbg(f'음성 대기 상태 갱신 오류: {e}')                # 실패해도 음성 루프는 계속 진행



def speak(text: str):
    log_info(f'[TTS] "{text}"')
    _voice_ready_gui_state(False, VOICE_BUSY_TEXT)               # TTS 중에는 사용자 발화를 받지 않음을 표시
    _tts_gui_state(text)                                         # 음성 출력 전 GUI 안내 문장 먼저 갱신
    if not USE_TTS:
        _voice_ready_gui_state(False, '잠시 후 말씀해 주세요')     # cooldown 이후 listen_text에서 ready로 바뀜
        return
    try:
        asyncio.run(_make_tts(text))
        subprocess.run(
            ['ffmpeg', '-y', '-i', TTS_FILE, '-f', 'alsa', 'plughw:4,0'],
            timeout=15,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
        if os.path.exists(TTS_FILE):
            os.remove(TTS_FILE)
    except Exception as e:
        log_info(f'TTS 오류: {e}')
    finally:
        # 실제 수신 가능 시점은 voice_loop의 TTS_COOLDOWN 이후 collect_speech()가 시작될 때다.
        _voice_ready_gui_state(False, '잠시 후 말씀해 주세요')



