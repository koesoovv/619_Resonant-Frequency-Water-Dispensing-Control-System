    plot_frame.pack(fill='both', expand=True)                       # 배치

    graph_header = ctk.CTkFrame(plot_frame, fg_color=C_CARD)        # 그래프 헤더 행
    graph_header.pack(fill='x', pady=(0, 6))                        # 배치

    ctk.CTkLabel(graph_header, text='실시간 주파수 추적 그래프',
                 text_color=C_TEXT,
