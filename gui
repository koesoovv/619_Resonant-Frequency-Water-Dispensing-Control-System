                 ).pack(side='left')                                 # 제목 (왼쪽 고정)

    actual_air_frame = ctk.CTkFrame(graph_header, fg_color=C_CARD)  # 입력 영역 (평소 숨김)
    # 초기에는 pack 안 함 → 제어 완료 시에만 오른쪽에 표시

    ctk.CTkLabel(actual_air_frame, text='실제 공기층(cm):',
                 text_color=C_NAVY,
                 font=('Malgun Gothic', 12, 'bold')
                 ).pack(side='left', padx=(14, 4))                   # 라벨

    actual_air_entry = ctk.CTkEntry(actual_air_frame, width=72,
                                    placeholder_text='예) 3.20',
                                    font=('Malgun Gothic', 12))      # 숫자 입력창
    actual_air_entry.pack(side='left', padx=(0, 6))                  # 배치

    def on_confirm_save():                                           # 저장 버튼 동작
        data = _pending_save[0]
        if data is None:
            return
        raw = actual_air_entry.get().strip()                         # 입력값 읽기
        try:
            actual_air = float(raw)                                  # 숫자 변환 시도
        except ValueError:
            actual_air = None                                        # 미입력 시 공란으로 저장
        save_to_csv(
            data['d'], data['init_f'], data['tf'], data['sf'],
            r2_final=data['r2'],
            total_samples=data['total_samples'],
            theory_intercept=data['theory_intercept'],
            stand_type='filled_box',
            stand_height_cm=3.0,
            actual_air_cm=actual_air,
        )
        _pending_save[0] = None                                      # 대기 데이터 초기화
        actual_air_frame.pack_forget()                               # 입력 칸 숨김
        actual_air_entry.delete(0, 'end')                            # 입력창 초기화
        set_status('저장 완료')                                       # 상태 표시

    ctk.CTkButton(actual_air_frame, text='저장', width=60, height=28,
                  fg_color=C_NAVY, hover_color=C_NAVY_HOVER,
                  font=('Malgun Gothic', 12, 'bold'), corner_radius=8,
                  command=on_confirm_save).pack(side='left')         # 저장 버튼

    fig = Figure(figsize=(6.2, 3.0), dpi=100)                      # Figure 생성
    ax  = fig.add_subplot(111)                                     # 축 생성
    ax.set_xlabel('t [s]')                                         # x축 라벨
    ax.set_ylabel('f [Hz]')                                        # y축 라벨
    ax.grid(True, alpha=0.3)                                       # 격자 표시
    fig.tight_layout(pad=3.0)                                      # 여백 정리

    line_freq,  = ax.plot([], [], linewidth=1.5)                   # 주파수 선 생성
    target_line = ax.axhline(y=0, linestyle='--', alpha=0.8)       # 목표선 생성
    canvas = FigureCanvasTkAgg(fig, master=plot_frame)             # Tk 그래프 객체 생성
    canvas.get_tk_widget().pack(fill='both', expand=True)          # 배치

    _init_air_fixed = [None]                                       # 초기 공기층 1회 고정용 클로저 변수

    def periodic_update():                                         # 100ms 주기 GUI 갱신 함수
        try:
            with core.lock:
                d           = float(core.current_diameter)          # 현재 지름
                sf          = float(core.last_stable_f)            # 현재 안정 주파수
                tf          = float(core.target_freq)              # 목표 주파수
                air         = float(core.last_current_air)         # 현재 공기층
                hits        = int(core.consecutive_stop_hits)      # 정지 히트 수
                finish      = bool(core.request_finish)            # 저장 요청 여부

                if core.request_finish:
                    core.request_finish = False                    # 한 번만 처리되도록 플래그 해제

                t_list      = list(core.history_time)              # 시간 배열 복사
                f_list      = list(core.history_freq)              # 주파수 배열 복사
                t_mode      = bool(core.tracking_mode)             # tracking 모드 여부
                init_air_c  = float(core.init_air_len_cm)         # 확정 초기 공기층

            d_var.set(f'지름(D) : {d:.2f} cm' if d > 0 else '지름(D) : - cm')  # 지름 표시
            f_var.set(f'주파수(F) : {sf:.0f} Hz' if sf > 0 else '주파수(F) : - Hz')  # 현재 주파수 표시
            tf_var.set(f'목표(Target) : {tf:.0f} Hz' if tf > 0 else '목표(Target) : - Hz')  # 목표 주파수 표시
            air_var.set(f'공기층(Air) : {air:.2f} cm' if air != 0 else '공기층(Air) : - cm')  # 공기층 표시

            if _init_air_fixed[0] is None and init_air_c > 0:     # 아직 화면에 고정 안 했고 값이 있으면
                _init_air_fixed[0] = init_air_c                    # 값 고정
                init_air_var.set(f'초기 공기층(용기 높이) : {init_air_c:.2f} cm')  # 표시

            hit_var.set(f'확신(Hits) : {hits}/{core.STOP_TRIGGER_COUNT}')  # 히트 수 표시
            progress.set(hits / float(max(1, core.STOP_TRIGGER_COUNT)))    # 진행바 갱신
            progress.configure(progress_color='#0B7A3E' if t_mode else C_NAVY)  # tracking 모드 색상 변경

            if t_list:                                             # 그래프 데이터가 있으면
                if len(t_list) > core.PLOT_MAX_POINTS:             # 최대 포인트 수 초과 시
                    t_list = t_list[-core.PLOT_MAX_POINTS:]        # 최근 구간만 사용
                    f_list = f_list[-core.PLOT_MAX_POINTS:]        # 최근 구간만 사용

                line_freq.set_data(t_list, f_list)                 # 그래프 선 데이터 갱신
                t_max = max(t_list)                                # 현재 최대 시간
                ax.set_xlim(max(0, t_max - 30), max(5, t_max))    # x축 범위 갱신
                fmn, fmx = min(f_list), max(f_list)                # 최소/최대 주파수
                pad = max(50, 0.1 * (fmx - fmn))                   # 여백 계산
                ax.set_ylim(max(0, fmn - pad), fmx + pad)          # y축 범위 갱신

                if tf > 0:
                    target_line.set_ydata([tf, tf])                # 목표선 위치 갱신
                    target_line.set_alpha(0.9)                     # 목표선 표시
                else:
                    target_line.set_alpha(0.0)                     # 목표선 숨김
            else:                                                  # 그래프 데이터가 없으면
                line_freq.set_data([], [])                         # 선 초기화
                ax.set_xlim(0, 1)                                  # x축 초기화
                ax.set_ylim(core.FREQ_MIN_LIMIT, core.FREQ_MAX_LIMIT)  # y축 초기화
                target_line.set_alpha(0.0)                         # 목표선 숨김

            canvas.draw_idle()                                     # 화면에 반영

            if finish:                                             # 저장 요청이 있으면
                set_status('측정 완료 → 실제 공기층 입력 후 저장')   # 상태 표시

                with core.lock:
                    init_f_save   = float(core.initial_stable_freq)    # 저장용 초기 주파수
                    r2            = float(core.last_r2)                # 저장용 R²
                    freq_snapshot = list(core.history_freq_snapshot)   # 저장용 주파수 기록
                    t_intercept_s = float(core.theory_intercept)       # 저장용 절편

                total_samples = len(freq_snapshot)                    # 총 샘플 수 계산

                print(f'\n[DEBUG] 샘플수={total_samples} | R2={r2}')  # 디버그 출력

                # 즉시 저장하지 않고 실제 공기층 입력 대기
                _pending_save[0] = {
                    'd':                d,
                    'init_f':           init_f_save,
                    'tf':               tf,
                    'sf':               sf,
                    'r2':               r2,
                    'total_samples':    total_samples,
                    'theory_intercept': t_intercept_s,
                }
                actual_air_entry.delete(0, 'end')                    # 입력창 초기화
                actual_air_frame.pack(side='right')                  # 제목 오른쪽에 입력 칸 표시

                _init_air_fixed[0] = None                            # 다음 실험 위해 초기화
                init_air_var.set('초기 공기층(용기 높이) : - cm')     # 표시 초기화

        except Exception as e:
            print(f'\n[periodic_update 오류] {e}')                   # 예외가 나도 루프는 유지

        finally:
            app.after(100, periodic_update)                          # 100ms 뒤 다시 실행 예약

    footer = ctk.CTkFrame(card, fg_color=C_CARD, corner_radius=20)  # 하단 푸터
    footer.grid(row=2, column=0, sticky='ew', padx=24, pady=(0, 18))  # 배치

    ctk.CTkLabel(footer, textvariable=status_var, text_color=C_MUTED,
                 font=('Malgun Gothic', 14)).pack(anchor='w')       # 상태 문구 표시

    core.sw_on.when_pressed  = gui_on                               # 물리 ON 스위치 연결
    core.sw_off.when_pressed = gui_off                              # 물리 OFF 스위치 연결
    app.protocol('WM_DELETE_WINDOW', on_close)                      # 창 닫기 이벤트 연결
    core.solenoid_off()                                             # 시작 시 솔레노이드 OFF
    set_status('GPIO 제어 모드 준비 완료')                           # 초기 상태 표시
    periodic_update()                                               # 업데이트 루프 시작
    app.mainloop()                                                  # GUI 메인 루프 시작


