def ensure_audio_stream():                                          # 오디오 스트림 생성/시작
    global audio_stream
    if audio_stream is not None:
        return                                                      # 이미 있으면 종료
    audio_stream = sd.InputStream(                                  # 입력 스트림 생성
        device=INPUT_DEVICE,                                        # 입력 장치
        callback=audio_callback,                                    # 콜백 함수
        channels=1,                                                 # 모노 입력
        samplerate=SAMPLE_RATE,                                     # 샘플레이트
        blocksize=CHUNK_SIZE                                        # 블록 크기
    )
    audio_stream.start()                                            # 시작

