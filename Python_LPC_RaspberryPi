            if request_finish:
                request_finish = False                               # 저장 요청 클리어
            t_list = list(history_time)                              # 시간 히스토리 복사
            f_list = list(history_freq)                              # 주파수 히스토리 복사

        d_var.set(f"지름(D) : {d:.2f} cm" if d > 0 else "지름(D) : - cm")  # 라벨 업데이트
        f_var.set(f"주파수(F) : {sf:.0f} Hz" if sf > 0 else "주파수(F) : - Hz")  # 라벨 업데이트
        tf_var.set(f"목표(Target) : {tf:.0f} Hz" if tf > 0 else "목표(Target) : - Hz")  # 라벨 업데이트
        air_var.set(f"공기층(Air) : {air:.2f} cm" if air != 0 else "공기층(Air) : - cm")  # 라벨 업데이트
        hit_var.set(f"확신(Hits) : {hits}/{STOP_TRIGGER_COUNT}")     # 라벨 업데이트

        progress.set(hits / float(max(1, STOP_TRIGGER_COUNT)))       # 진행바 업데이트

        if not t_list:
            line_freq.set_data([], [])                               # 데이터 없음
            target_line.set_ydata([0, 0])                            # 목표선 초기화
            ax.set_xlim(0, 1)                                        # x축 기본
            ax.set_ylim(FREQ_MIN_LIMIT, FREQ_MAX_LIMIT)              # y축 기본
            canvas.draw_idle()                                       # 그리기 요청
        else:
            if len(t_list) > PLOT_MAX_POINTS:
                t_list = t_list[-PLOT_MAX_POINTS:]                   # 뒤쪽만 유지
                f_list = f_list[-PLOT_MAX_POINTS:]                   # 뒤쪽만 유지

            line_freq.set_data(t_list, f_list)                       # 라인 데이터 갱신

            t_max = max(t_list)                                      # 최대 시간
            ax.set_xlim(max(0, t_max - 30), max(5, t_max))           # 최근 30초 뷰

            f_min, f_max = min(f_list), max(f_list)                  # 범위 계산
            pad = max(50, 0.1 * (f_max - f_min))                     # 여유폭
            ax.set_ylim(max(0, f_min - pad), f_max + pad)            # y축 자동

            if tf > 0:
                target_line.set_ydata([tf, tf])                      # 목표선 갱신
                target_line.set_alpha(0.9)                           # 보이기
            else:
                target_line.set_alpha(0.0)                           # 숨기기

            canvas.draw_idle()                                       # 그리기 요청

        if do_finish:
            set_status("종료 → 결과 저장")                           # 상태 표시
            with lock:
                init_f = float(initial_stable_freq)                  # 초기 주파수 복사
            save_to_csv(d, init_f, tf, sf)                           # CSV 저장

        app.after(100, periodic_update)                              # 100ms 주기 재호출

    footer = ctk.CTkFrame(card, fg_color=C_CARD, corner_radius=20)  # 푸터 프레임
    footer.grid(row=2, column=0, sticky="ew", padx=24, pady=(0, 18))  # 배치
    ctk.CTkLabel(footer, textvariable=status_var, text_color=C_MUTED, font=("Malgun Gothic", 14, "normal")).pack(anchor="w")  # 상태 라벨

    # ===== 물리 스위치 이벤트 연결 =====
    sw_on.when_pressed = gui_on                                      # GPIO3 눌리면 ON 시작
    sw_off.when_pressed = gui_off                                    # GPIO5 눌리면 OFF 종료

    app.protocol("WM_DELETE_WINDOW", on_close)                       # 종료 이벤트 연결

    solenoid_off()                                                   # 시작 시 안전 OFF
    ensure_audio_stream()                                            # 오디오 스트림 준비
    set_status("GPIO 제어 모드 준비 완료")                           # 상태 표시
    periodic_update()                                                # 주기 업데이트 시작
    app.mainloop()                                                   # GUI 메인루프

if __name__ == "__main__":
    run_kiosk_gui()                                                  # 프로그램 시작
