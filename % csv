def _num(value, default=0.0):                                      # 숫자 변환 보조 함수
    try:                                                           # 변환 시도
        if value is None:                                          # None이면
            return default                                         # 기본값 반환
        return float(value)                                        # float 변환
    except (TypeError, ValueError):                                # 변환 실패 시
        return default                                             # 기본값 반환


def _blank(value, digits=None):                                    # CSV 공란/반올림 처리 함수
    if value is None:                                              # 값이 없으면
        return ''                                                  # 빈칸 저장
    try:                                                           # 숫자 처리 시도
        value = float(value)                                       # float 변환
        return round(value, digits) if digits is not None else value  # 반올림 또는 원값
    except (TypeError, ValueError):                                # 숫자가 아니면
        return value                                               # 문자열 그대로 저장


def _safe_str(value, default='unknown'):                           # 문자열 정리 함수
    text = str(value).strip() if value is not None else ''         # 문자열 변환
    return text if text else default                               # 빈 문자열이면 기본값 반환


def _bool_text(value):                                             # bool 값을 CSV용 문자열로 변환
    return 'TRUE' if bool(value) else 'FALSE'                      # 엑셀에서 보기 쉬운 형태로 저장


def _calc_init_air_len(diameter, init_freq, theory_intercept,      # 초기 공기층 계산 함수
                       init_air_len_cm=None):                      # 외부에서 직접 넘겨준 값 우선
    """
    우선순위:
      1) init_air_len_cm 가 양수로 직접 제공된 경우 → 그대로 사용
      2) theory_intercept 기반 외삽
      3) init_freq 기반 계산
    """
    if init_air_len_cm is not None and _num(init_air_len_cm) > 0:  # 직접 제공된 값이 있으면
        return _num(init_air_len_cm)                               # 바로 반환

    diameter         = _num(diameter)                              # 지름 숫자화
    init_freq        = _num(init_freq)                             # 초기 주파수 숫자화
    theory_intercept = _num(theory_intercept)                      # 회귀 절편 숫자화

    if theory_intercept > 1e-6 and diameter > 0:                   # 회귀 외삽값이 있으면
        f_at_t0 = 1.0 / theory_intercept                           # t=0 추정 주파수
        return core.SOUND_SPEED / (4 * f_at_t0) - core.END_CORRECTION_K * diameter  # 초기 공기층 반환

    if init_freq > 0 and diameter > 0:                             # 초기 주파수 기반 계산 가능하면
        return core.SOUND_SPEED / (4 * init_freq) - core.END_CORRECTION_K * diameter  # 초기 공기층 반환

    return None                                                    # 계산 불가


def _backup_existing_csv(filename):                                # 기존 CSV 백업 함수
    base, ext = os.path.splitext(filename)                         # 파일명/확장자 분리
    idx = 1                                                        # 백업 번호 시작값
    while True:                                                    # 겹치지 않는 백업명 탐색
        backup = f'{base}_backup_{idx}{ext}'                       # 날짜 없는 백업명 생성
        if not os.path.exists(backup):                             # 해당 파일명이 비어 있으면
            os.replace(filename, backup)                           # 기존 CSV 백업
            print(f'\n[CSV 헤더 변경] 기존 파일 백업: {backup}')     # 백업 안내
            return                                                 # 종료
        idx += 1                                                   # 다음 번호 확인


def _prepare_csv_file(filename, header):                           # CSV 헤더 준비 함수
    if not os.path.isfile(filename):                               # 파일이 없으면
        return True                                                # 헤더 작성 필요

    try:                                                           # 기존 헤더 확인
        with open(filename, mode='r', newline='', encoding='utf-8-sig') as f:  # 기존 CSV 열기
            old_header = next(csv.reader(f), None)                 # 첫 줄 읽기
    except Exception:                                              # 읽기 실패 시
        old_header = None                                          # 헤더 없음 처리

    if old_header == header:                                       # 현재 헤더와 같으면
        return False                                               # 헤더 작성 불필요

    _backup_existing_csv(filename)                                 # 다른 구조의 CSV는 백업
    return True                                                    # 새 헤더 작성 필요


def _next_trial_no(filename):                                      # 날짜 없는 실험 순번 계산
    if not os.path.isfile(filename):                               # 파일이 없으면
        return 1                                                   # 첫 실험
    try:                                                           # 기존 행 수 확인
        with open(filename, mode='r', newline='', encoding='utf-8-sig') as f:  # CSV 열기
            reader = csv.reader(f)                                 # reader 생성
            next(reader, None)                                     # 헤더 스킵
            return sum(1 for row in reader if row) + 1             # 데이터 행 수 + 1
    except Exception:                                              # 읽기 실패 시
        return 1                                                   # 안전하게 1번부터 시작


def _calc_fill_pct_from_air(init_air_len, stop_air):               # 공기층 기반 채움률 계산
    init_air = _num(init_air_len)                                  # 초기 공기층 숫자화
    air = _num(stop_air)                                           # 정지 공기층 숫자화
    if init_air <= 0 or air < 0:                                   # 계산 불가 조건
        return None                                                # 빈칸 처리
    fill_pct = (1.0 - air / init_air) * 100.0                      # 채움률 계산
    return max(0.0, min(100.0, fill_pct))                          # 0~100% 범위 제한


def save_to_csv(                                                   # CSV 저장 함수
    diameter, init_freq, target_f, final_freq,                     # 기존 GUI 호출과 호환되는 기본 인자
    r2_final=0.0,                                                  # 회귀 R²
    total_samples=0,                                               # 총 샘플 수
    theory_intercept=0.0,                                          # 1/f 회귀 절편
    stand_type=None,                                               # 기존 코드 호환용, 저장 안 함
    stand_height_cm=None,                                          # 기존 코드 호환용, 저장 안 함
    actual_air_cm=None,                                            # 실측 남은 공기층(cm)
    estimated_stop_air_cm=None,                                    # 정지 순간 추정 공기층(cm), 없으면 core 값 사용
    target_air_cm=None,                                            # 기존 코드 호환용, 저장 안 함
    stop_reason=None,                                              # 기존 코드 호환용, 저장 안 함
    note=None,                                                     # 기존 코드 호환용, 저장 안 함
    init_air_len_cm=None,                                          # 코어에서 직접 읽은 초기 공기층(cm)
    actual_fill_pct=None,                                          # 실험자가 입력한 실측 채움률(%)
    cup_type=None,                                                 # 컵 종류/용기 구분
    target_fill_pct=None,                                          # 목표 채움률(%)
    stop_elapsed_sec=None,                                         # 정지까지 걸린 시간(s)
):
    """
    CSV 한 줄 저장.

    분석 목적:
      - Fill_Error_Pct로 빠른 정지/늦은 정지 구분
      - Reg_R2, Theory_Locked로 회귀 신뢰도 구분
      - Noise_Floor_Level, Spike_Blocked_Count로 잡음 영향 확인
      - Stop_Hits, Stop_Trigger_Count로 정지 판정 조건 튜닝
    """
    filename = core.CSV_FILENAME                                   # 코어에서 지정한 CSV 파일명 사용
    write_header = _prepare_csv_file(filename, HEADER)             # 헤더 작성 여부 확인
    trial_no = 1 if write_header else _next_trial_no(filename)     # 날짜 없는 실험 순번

    target_pct = _num(target_fill_pct, _num(getattr(core, 'TARGET_FILL_PCT', 0.0)))  # 목표 % 확보
    cup_type_text = _safe_str(cup_type)                            # 컵 종류 문자열 정리

    init_air_len = _calc_init_air_len(                             # 초기 공기층 계산
        diameter, init_freq, theory_intercept,
        init_air_len_cm=init_air_len_cm,
    )

    if estimated_stop_air_cm is None:                              # GUI에서 정지 공기층을 안 넘겼으면
        estimated_stop_air_cm = getattr(core, 'last_current_air', None)  # 코어의 마지막 추정 공기층 사용

    estimated_stop_fill_pct = _calc_fill_pct_from_air(             # 추정 정지 채움률 계산
        init_air_len, estimated_stop_air_cm,
    )

    if actual_fill_pct is not None and actual_air_cm is None:      # 채움률(%)로 넘어왔으면
        ref_air = _num(init_air_len) if init_air_len else 0.0      # 초기 공기층 참조
        if ref_air > 0:                                            # 역변환 가능하면
            actual_air_cm = (1.0 - _num(actual_fill_pct) / 100.0) * ref_air  # cm 변환

    fill_error_pct = None                                          # 실제 오차 초기화
    if actual_fill_pct is not None and target_pct > 0:             # 실측 채움률과 목표값이 있으면
        fill_error_pct = _num(actual_fill_pct) - target_pct        # 실제 - 목표 계산

    decision_freq = getattr(core, 'last_decision_freq', None)       # 실제 정지 판단 주파수
    raw_stop_freq = getattr(core, 'last_raw_stop_freq', None)       # raw 정지 후보 주파수

    stop_target_diff = None                                        # 목표 대비 decision 주파수 차이 초기화
    if _num(target_f) > 0 and _num(decision_freq) > 0:             # 둘 다 유효하면
        stop_target_diff = _num(decision_freq) - _num(target_f)    # decision 주파수 - 목표 주파수 계산

    if stop_elapsed_sec is None:                                   # 외부에서 종료 시간을 안 넘겼으면
        stop_elapsed_sec = getattr(core, 'last_stop_elapsed_sec', None)  # 코어 종료 시간 사용

    row = [                                                        # CSV 한 줄 구성
        int(trial_no),                                             # 실험 순번
        cup_type_text,                                             # 컵 종류
        _blank(target_pct, 1),                                     # 목표 채움률
        _blank(diameter, 4),                                       # 기존 추정 지름
        _blank(getattr(core, 'last_d_locked_cm', None), 4),        # 잠금 D
        _blank(getattr(core, 'last_d_candidate_median', None), 4), # D 후보 중앙값
        _blank(getattr(core, 'last_d_candidate_mad', None), 4),    # D 후보 MAD
        _blank(init_freq, 1),                                      # 초기 주파수
        _blank(getattr(core, 'last_init_air_by_initfreq_cm', None), 4),    # initfreq 기반 H
        _blank(getattr(core, 'last_init_air_by_regression_cm', None), 4),  # regression 기반 H
        _blank(getattr(core, 'last_init_air_locked_cm', init_air_len), 4), # 잠금 H
        _blank(target_f, 1),                                       # 목표 주파수
        _blank(raw_stop_freq, 1),                                  # raw 정지 후보 주파수
        _blank(decision_freq, 1),                                  # decision 주파수
        _blank(final_freq, 1),                                     # 화면/그래프 기준 정지 주파수
        _blank(stop_target_diff, 1),                               # 목표 대비 decision 주파수 차이
        _blank(estimated_stop_air_cm, 4),                          # 정지 순간 추정 공기층
        _blank(getattr(core, 'last_decision_fill_pct', None), 2),  # decision 채움률
        _blank(estimated_stop_fill_pct, 2),                        # 공기층 기반 추정 채움률
        _blank(actual_air_cm, 4),                                  # 실측 공기층
        _blank(actual_fill_pct, 2),                                # 실측 채움률
        _blank(fill_error_pct, 2),                                 # 실측 오차
        _blank(r2_final, 4),                                       # 회귀 R²
        _bool_text(getattr(core, 'theory_locked', False)),         # 이론 곡선 잠금 여부
        _bool_text(getattr(core, 'last_model_valid', False)),      # 모델 유효 여부
        _safe_str(getattr(core, 'last_reject_reason', 'unknown')), # 모델 보류/거부 이유
        int(_num(total_samples, 0)),                               # 총 샘플 수
        _blank(getattr(core, 'max_freq_seen', None), 1),           # 최대 관측 주파수
        _blank(getattr(core, 'noise_floor_level', None), 4),       # 노이즈 플로어
        _blank(getattr(core, 'dynamic_Q', None), 3),               # 동적 유량
        int(_num(getattr(core, 'consecutive_stop_hits', 0), 0)),   # 정지 누적 횟수
        int(_num(getattr(core, 'STOP_TRIGGER_COUNT', 0), 0)),      # 정지 기준 횟수
        int(_num(getattr(core, 'spike_blocked_count', 0), 0)),     # 스파이크 차단 횟수
        _blank(stop_elapsed_sec, 3),                               # 정지까지 걸린 시간
        _safe_str(getattr(core, 'last_control_profile', 'default')),  # 진단 프로파일
    ]

    try:                                                           # 저장 시도
        with open(filename, mode='a', newline='', encoding='utf-8-sig') as f:  # CSV 열기
            writer = csv.writer(f)                                 # writer 생성
            if write_header:                                       # 새 파일이면
                writer.writerow(HEADER)                            # 헤더 저장
            writer.writerow(row)                                   # 데이터 한 줄 저장

        print(f'\n[저장 완료] {filename}')                         # 저장 완료 출력
        print(f'  Trial_No={trial_no} | Cup={cup_type_text}')       # 실험 번호/컵 종류 출력
        print(f'  Target={target_pct:.1f}% | Actual={_blank(actual_fill_pct, 2)}% | Error={_blank(fill_error_pct, 2)}%')  # 오차 출력
        print(f'  D_locked={_num(getattr(core, "last_d_locked_cm", 0.0)):.2f}cm | H_locked={_num(getattr(core, "last_init_air_locked_cm", init_air_len)):.2f}cm')  # 핵심 모델 출력
        print(f'  DecisionF={_num(decision_freq):.1f}Hz | RawF={_num(raw_stop_freq):.1f}Hz | TargetF={_num(target_f):.1f}Hz | R²={_num(r2_final):.4f}')  # 주파수/R² 출력
        print(f'  ModelValid={_bool_text(getattr(core, "last_model_valid", False))} | Reason={_safe_str(getattr(core, "last_reject_reason", "unknown"))}')  # 모델 유효성 출력
        print(f'  TheoryLocked={_bool_text(getattr(core, "theory_locked", False))} | SpikeBlocked={int(_num(getattr(core, "spike_blocked_count", 0), 0))}')  # 신뢰도 출력

    except Exception as e:                                         # 저장 실패 시
        print(f'\n[저장 실패] {e}')                                # 오류 출력

