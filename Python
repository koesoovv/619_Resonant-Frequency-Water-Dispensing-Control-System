        set_status("배경 소음 측정 중... (1초 후 펌프 작동)")      # GUI 안내

        def delayed_pump_on():
            time.sleep(NOISE_CALIBRATION_TIME + 0.1)   # 소음 측정 끝날 때까지 대기
            serial_write(b'1')                         # 아두이노에 ON 명령 전송
