# [9. 오디오 스트림 보장]
# =========================================================
def ensure_audio_stream():
    global audio_stream
    if audio_stream is not None: return
    audio_stream = sd.InputStream(callback=audio_callback, channels=1, samplerate=SAMPLE_RATE, blocksize=CHUNK_SIZE)
    audio_stream.start()

