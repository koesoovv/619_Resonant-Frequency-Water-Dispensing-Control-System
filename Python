        early_ceil_var.set(vv)                       # 변수 갱신
        apply_tuning_from_vars()                     # 전역 반영

    early_ceil_slider = ctk.CTkSlider(early_box, from_=300, to=1500, number_of_steps=120, height=SLIDER_H, command=on_early_ceil)  # 슬라이더
    early_ceil_slider.set(DEFAULT_EARLY_CEIL_HZ)      # 초기 위치
    early_ceil_slider.grid(row=2, column=0, sticky="ew", pady=(2, 8))# 배치

    fmax_box = ctk.CTkFrame(bottom_row, fg_color=C_CARD, corner_radius=12)  # FREQ_MAX 박스
    fmax_box.grid(row=0, column=1, sticky="ew", padx=(10, 0))                # 오른쪽 배치
    fmax_box.grid_columnconfigure(0, weight=1)                               # 내부 확장

    ctk.CTkLabel(fmax_box, text="최대 탐색 주파수 (FREQ_MAX_LIMIT)", text_color=C_TEXT, font=("Malgun Gothic", 13, "bold")).grid(row=0, column=0, sticky="w")  # 제목
    fmax_val = ctk.StringVar(value=f"{DEFAULT_FREQ_MAX_LIMIT} Hz")           # 표시 값
    ctk.CTkLabel(fmax_box, textvariable=fmax_val, text_color=C_MUTED, font=("Malgun Gothic", 12)).grid(row=1, column=0, sticky="w", pady=(0, 4))                # 값 표시

    def on_fmax(v):
        vv = int(float(v))                           # int 변환
        fmax_val.set(f"{vv} Hz")                     # 표시 갱신
        fmax_var.set(vv)                             # 변수 갱신
        apply_tuning_from_vars()                     # 전역 반영

    fmax_slider = ctk.CTkSlider(fmax_box, from_=800, to=5000, number_of_steps=420, height=SLIDER_H, command=on_fmax)  # 슬라이더
    fmax_slider.set(DEFAULT_FREQ_MAX_LIMIT)          # 초기 위치
    fmax_slider.grid(row=2, column=0, sticky="ew", pady=(2, 8))              # 배치

    on_lock_toggle()                                  # 초기 LOCK 상태를 위젯에 반영(비활성화 등)

    # ===== RIGHT: 진행바/값/그래프 =====
    prog_area = ctk.CTkFrame(right, fg_color=C_CARD, corner_radius=16)  # 진행바 카드
    prog_area.pack(fill="x", pady=(0, 12))                              # 상단 고정

    ctk.CTkLabel(prog_area, text="정지 확신도", text_color=C_TEXT, font=("Malgun Gothic", 16, "bold")).pack(anchor="w", pady=(0, 8))  # 제목
    progress = ctk.CTkProgressBar(prog_area, height=18, corner_radius=10, fg_color="#E5E7EB", progress_color=C_NAVY)  # 진행바
    progress.set(0.0)                                  # 초기 0%
    progress.pack(fill="x")                            # 전체 폭

    stats = ctk.CTkFrame(right, fg_color=C_CARD, corner_radius=16)  # 수치 표시 카드
    stats.pack(fill="x", pady=(0, 12))                              # 진행바 아래

    def add_stat(p, v):
        r = ctk.CTkFrame(p, fg_color=C_CARD, corner_radius=12)      # 한 줄 프레임
        r.pack(fill="x", pady=4)                                     # 줄 간격
        ctk.CTkLabel(r, textvariable=v, text_color=C_TEXT, font=("Malgun Gothic", 16, "bold")).pack(anchor="w", padx=6)  # 값 라벨

    add_stat(stats, d_var)                           # 지름 표시 라벨 추가
    add_stat(stats, f_var)                           # 주파수 표시 라벨 추가
    add_stat(stats, tf_var)                          # 목표 표시 라벨 추가
    add_stat(stats, air_var)                         # 공기층 표시 라벨 추가
    add_stat(stats, hit_var)                         # hits 표시 라벨 추가

    plot_frame = ctk.CTkFrame(right, fg_color=C_CARD, corner_radius=16)  # 그래프 카드
    plot_frame.pack(fill="both", expand=True)                           # 남은 공간 확장

    ctk.CTkLabel(plot_frame, text="실시간 주파수 추적 그래프", text_color=C_TEXT, font=("Malgun Gothic", 16, "bold")).pack(anchor="w", pady=(0, 6))  # 제목

    fig = Figure(figsize=(6.2, 3.0), dpi=100)          # matplotlib Figure 생성
    ax = fig.add_subplot(111)                          # 단일 subplot
    ax.set_xlabel("t [s]")                             # x축 라벨
    ax.set_ylabel("f [Hz]")                            # y축 라벨
    ax.grid(True, alpha=0.3)                           # 그리드
    fig.tight_layout(pad=3.0)                          # 여백 정리

    line_freq, = ax.plot([], [], linewidth=1.5)        # 주파수 라인(데이터는 주기적으로 set_data)
    target_line = ax.axhline(y=0, linestyle="--", alpha=0.8)  # 목표선(없으면 alpha=0으로 숨김)

    canvas = FigureCanvasTkAgg(fig, master=plot_frame) # Tk 프레임에 캔버스 삽입
    canvas.get_tk_widget().pack(fill="both", expand=True)  # 캔버스 위젯 배치

    def periodic_update():
        global request_finish                           # 저장 트리거 사용

        with lock:                                      # 전역 상태 스냅샷(락)
            d = float(current_diameter)                 # 지름 읽기
            sf = float(last_stable_f)                   # 안정 주파수 읽기
            tf = float(target_freq)                     # 목표 주파수 읽기
            air = float(last_current_air)               # 공기층 읽기
            hits = int(consecutive_stop_hits)           # hits 읽기
            do_finish = bool(request_finish)            # 저장 트리거 읽기
            if request_finish:                          # 트리거가 켜져 있으면
                request_finish = False                  # 한 번만 저장하도록 즉시 끄기
            t_list = list(history_time)                 # 그래프용 시간 복사
            f_list = list(history_freq)                 # 그래프용 주파수 복사

        d_var.set(f"지름(D) : {d:.2f} cm" if d > 0 else "지름(D) : - cm")     # 지름 라벨 갱신
        f_var.set(f"주파수(F) : {sf:.0f} Hz" if sf > 0 else "주파수(F) : - Hz") # 주파수 라벨 갱신
        tf_var.set(f"목표(Target) : {tf:.0f} Hz" if tf > 0 else "목표(Target) : - Hz") # 목표 라벨 갱신
        air_var.set(f"공기층(Air) : {air:.2f} cm" if air != 0 else "공기층(Air) : - cm") # 공기층 라벨 갱신
        hit_var.set(f"확신(Hits) : {hits}/{STOP_TRIGGER_COUNT}")             # hits 라벨 갱신

        progress.set(hits / float(max(1, STOP_TRIGGER_COUNT)))              # 진행바 갱신(0~1)

        if not t_list:                                # 데이터가 없으면(아직 시작 전)
            line_freq.set_data([], [])                 # 빈 데이터
            target_line.set_ydata([0, 0])              # 목표선 0
            ax.set_xlim(0, 1)                          # 기본 x축
            ax.set_ylim(FREQ_MIN_LIMIT, FREQ_MAX_LIMIT)# 기본 y축
            canvas.draw_idle()                         # 비동기 redraw
        else:
            if len(t_list) > PLOT_MAX_POINTS:          # 너무 많으면
                t_list = t_list[-PLOT_MAX_POINTS:]     # 최근 데이터만
                f_list = f_list[-PLOT_MAX_POINTS:]     # 최근 데이터만

            line_freq.set_data(t_list, f_list)         # 라인 데이터 갱신

            t_max = max(t_list)                        # 마지막 시간
            ax.set_xlim(max(0, t_max - 30), max(5, t_max))  # 최근 30초 보이게(최소 5초)

            f_min, f_max = min(f_list), max(f_list)    # 주파수 범위
            pad = max(50, 0.1 * (f_max - f_min))       # y축 패딩(최소 50Hz)
            ax.set_ylim(max(0, f_min - pad), f_max + pad)  # y축 자동 조절

            if tf > 0:                                 # 목표가 있으면
                target_line.set_ydata([tf, tf])        # 목표선 위치 갱신
                target_line.set_alpha(0.9)             # 보이게
            else:
                target_line.set_alpha(0.0)             # 목표 없으면 숨김

            canvas.draw_idle()                         # redraw 요청

        if do_finish:                                  # 저장 트리거가 켜져 있으면
            set_status("종료 → 결과 저장")             # 상태 표시
            with lock:
                init_f = float(initial_stable_freq)    # 초기 주파수 읽기
            save_to_csv(d, init_f, tf, sf)             # CSV 저장(지름/초기/목표/정지)

        app.after(100, periodic_update)                # 100ms 후 다시 실행(주기 업데이트)

    footer = ctk.CTkFrame(card, fg_color=C_CARD, corner_radius=20)  # 하단 상태 표시 영역
    footer.grid(row=2, column=0, sticky="ew", padx=24, pady=(0, 18)) # 배치
    ctk.CTkLabel(footer, textvariable=status_var, text_color=C_MUTED, font=("Malgun Gothic", 14, "normal")).pack(anchor="w")  # 상태 라벨

    app.protocol("WM_DELETE_WINDOW", on_close)         # 창 닫기 이벤트 핸들러 등록

    do_connect()                                       # 시작하자마자 시리얼 연결 시도
    ensure_audio_stream()                              # 오디오 스트림 보장
    threading.Thread(target=serial_reader_loop, args=(set_status,), daemon=True).start()  # 시리얼 수신 스레드 시작
    periodic_update()                                  # GUI 주기 업데이트 시작
    app.mainloop()                                     # GUI 이벤트 루프 시작

if __name__ == "__main__":
    run_kiosk_gui()                                    # 스크립트 직접 실행 시 GUI 실행
