# [10. 시리얼 수신 스레드]
# =========================================================
def serial_reader_loop(on_status):
    global ser
    while True:
        if ser is None:
            time.sleep(0.1); continue
        try:
            if ser.in_waiting:
                msg = ser.readline().decode(errors='ignore').strip()
                if "ON" in msg:
                    start_filling_local()
                    on_status("아두이노 ON 수신")
                elif "OFF" in msg:
                    stop_filling_local(save_result=True)
                    on_status("아두이노 OFF 수신")
        except Exception: pass
        time.sleep(0.01)

