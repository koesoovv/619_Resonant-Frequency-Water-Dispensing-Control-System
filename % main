#!/usr/bin/env python3
"""
main.py  ─ 스마트 정수기 통합 실행 파일
=========================================
구성 (5개 파일)
  main.py          ← 진입점, 스레드 시작
  voice_module.py  ← 음성인식 상태머신
  smart_water_core.py ← 급수 제어 로직
  gui_app.py       ← 터치 GUI
  csv_logger.py    ← 실험 결과 저장

실행:
  python3 main.py
"""

import threading
import time
import audio_diag_patch
import voice_module as voice
from gui_app import run_kiosk_gui


# GUI 콜백 등록 함수 (gui_app.py 에서 호출)
def register_gui_callbacks(on_cb, off_cb):
    voice.register_gui_callbacks(on_cb, off_cb)


def register_gui_level_callback(cb):
    voice.register_gui_level_callback(cb)


def main():
    print(flush=True)
    print('+============================================================+', flush=True)
    print('| 스마트 정수기 통합 시스템                                   |', flush=True)
    print('| 음성인식(silero+Google STT) + 급수제어(LPC+LOESS+LSM)       |', flush=True)
    print('| 초음파 도착감지(GPIO20/21) + ESP32 컵위치(HTTP)              |', flush=True)
    print('+============================================================+', flush=True)

    # 음성인식 루프를 별도 데몬 스레드로 시작
    voice_thread = threading.Thread(
        target=voice.voice_loop,
        name='VoiceLoop',
        daemon=True,
    )
    voice_thread.start()
    print(f'  [{time.strftime("%H:%M:%S")}] 음성인식 스레드 시작됨', flush=True)

    # GUI는 메인 스레드에서 실행 (Tkinter 요구사항)
    run_kiosk_gui()
    import os
    os._exit(0)

if __name__ == '__main__':
    main()

