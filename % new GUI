def _get_display_profile_value(profile: str, key: str, default: float) -> float:
    """초반 주파수 기반 표시 프로파일에서 속도 값을 꺼낸다."""
    table = DISPLAY_PROFILE_TABLE.get(profile) or DISPLAY_PROFILE_TABLE[DISPLAY_PROFILE_UNKNOWN]
    try:
        return float(table.get(key, default))
    except (TypeError, ValueError):
        return float(default)


def _profile_from_early_freq(freq_hz: float) -> str:
    """초반 주파수 중앙값으로 GUI 표시용 컵 크기 프로파일을 판정한다."""
    try:
        f = float(freq_hz)
    except (TypeError, ValueError):
        return DISPLAY_PROFILE_UNKNOWN
    if f <= 0:
        return DISPLAY_PROFILE_UNKNOWN
    if f < DISPLAY_LARGE_MAX_HZ:
        return DISPLAY_PROFILE_LARGE
    if f >= DISPLAY_SMALL_MIN_HZ:
        return DISPLAY_PROFILE_SMALL
    return DISPLAY_PROFILE_MID


import random, math


class CupCanvas(tk.Canvas):
    _RIPPLE_WAVES = 1
    _RIPPLE_DELAY = 14
    _RIPPLE_SPEED = 1.8
    _RIPPLE_MAX   = int(30 * SCALE)

    _ORB_LAYERS = [
        {'color': (100,  80, 255), 'r_mult': 1.00, 'amp': 0.13, 'spd': 0.9,  'phase': 0.0, 'alpha': 75},
        {'color': (160,  60, 255), 'r_mult': 0.82, 'amp': 0.18, 'spd': 1.2,  'phase': 1.1, 'alpha': 95},
        {'color': (240,  50, 180), 'r_mult': 0.64, 'amp': 0.22, 'spd': 0.75, 'phase': 2.2, 'alpha': 110},
        {'color': (255,  80, 130), 'r_mult': 0.46, 'amp': 0.20, 'spd': 1.45, 'phase': 3.3, 'alpha': 120},
    ]

    def __init__(self, master, **kw):
        super().__init__(master, width=CUP_CW, height=CUP_CH,
                         bg=BG, highlightthickness=0, **kw)
        self._pct            = 0.0       # 현재 화면에 실제로 그려지는 수위
        self._pct_target     = 0.0       # 화면이 부드럽게 따라갈 목표 수위
        self._last_smooth_t  = time.time()  # 수위 보간용 마지막 프레임 시각
        self._target         = 70.0      # 목표 급수량
        self._display_profile = DISPLAY_PROFILE_UNKNOWN  # 초반 주파수 기반 GUI 표시 속도 프로파일
        self._filling        = False
        self._voice          = False
        self._voice_t        = 0
        self._wave_t         = 0
        self._bubbles        = []  # 물방울 제거(GPU 부하 완화). 복구 시 [self._new_bubble() for _ in range(3)]
        self._complete_active = False
        self._complete_t      = 0
        self._anim_id        = None
        self._voice_photo    = None
        self._orb_frame       = 0     # 기존 호환용 카운터. 실제 아우라는 시간 기준으로 진행
        self._voice_vol_smooth = 0.0  # 아우라 크기 표시용 볼륨 EMA
        self._voice_orb_cache = {}    # 보라색 음성 오브 PhotoImage 캐시. PIL 실시간 렌더링 반복을 줄임
        self._post_fill_recover_until = 0.0  # 급수 종료 후 애니메이션 타이밍 재정렬 구간
        # [계측] 프레임 타이밍. proc_max(벽시계)와 cpu_max(실제 CPU)를 비교해 GIL 뺏김을 확인한다.
        self._frame_prev_t      = None
        self._frame_gap_sum_ms  = 0.0
        self._frame_gap_max_ms  = 0.0
        self._frame_proc_max_ms = 0.0
        self._frame_cpu_max_ms  = 0.0
        self._frame_count       = 0
        self.after(300, self._prebuild_voice_orb_cache)  # 앱 시작 후 아우라 프레임을 미리 생성
        self._redraw()
        self._animate()

    def _new_bubble(self):
        x = random.uniform(CUP_BX - CUP_BRX * 0.6, CUP_BX + CUP_BRX * 0.6)
        y = random.uniform(CUP_BY - 10, CUP_BY - 5)
        return [x, y, random.uniform(2, 4), random.uniform(0.4, 1.0)]

    def _prebuild_voice_orb_cache(self):
        """아우라 이미지를 미리 생성해 급수 후 첫 음성 입력 때 PIL 렌더링이 몰리지 않게 한다."""
        try:
            for vol_idx in range(VOICE_ORB_VOL_STEPS):
                vol = vol_idx / float(max(1, VOICE_ORB_VOL_STEPS - 1))
                for frame_idx in range(VOICE_ORB_FRAME_COUNT):
                    key = (vol_idx, frame_idx)
                    if key not in self._voice_orb_cache:
                        self._voice_orb_cache[key] = self._render_voice_orb_photo(vol, frame_idx)
            print('\n[GUI] voice orb cache prebuilt')
        except Exception as e:
            print(f'\n[GUI] voice orb cache prebuild 오류: {e}')

    def recover_animation_after_fill(self):
        """급수 후 밀린 애니메이션 타이밍을 재정렬한다. 음성인식 로직은 건드리지 않는다."""
        self._last_smooth_t = time.time()
        # _voice_t/_orb_frame은 초기화하지 않는다. 초기화하면 다음 음성 입력 때 아우라가 첫 프레임부터 다시 시작해 끊겨 보인다.
        self._post_fill_recover_until = time.time() + 0.20

        try:
            if self._anim_id is not None:
                self.after_cancel(self._anim_id)
        except Exception:
            pass

        self._anim_id = self.after(POST_FILL_ANIM_RESET_MS, self._animate)

    def _rx_at(self, y):
        r = (CUP_BY - y) / CUP_INNER_H
        return CUP_BRX + (CUP_TRX - CUP_BRX) * r

    def _animate(self):
        frame_start = time.time() 
        frame_cpu_start = time.thread_time()   # [계측] 이 스레드 실제 CPU 시간(GIL 뺏긴 시간 제외)
        if self._frame_prev_t is not None:     # [계측] 직전 프레임과의 간격
            gap_ms = (frame_start - self._frame_prev_t) * 1000.0
            self._frame_gap_sum_ms += gap_ms
            self._frame_count += 1
            if gap_ms > self._frame_gap_max_ms:
                self._frame_gap_max_ms = gap_ms
        self._frame_prev_t = frame_start
        now = frame_start
        dt = max(0.016, min(0.12, now - self._last_smooth_t))
        self._last_smooth_t = now

        diff = self._pct_target - self._pct
        if abs(diff) < 0.08:
            self._pct = self._pct_target
        else:
            # 프레임 시간 기반 보간을 사용해 FPS 흔들림에도 수위 움직임이 일정하게 보이도록 한다.
            smooth_tau = _get_display_profile_value(self._display_profile, 'canvas_tau', 0.22)
            smooth_tau = max(0.08, float(smooth_tau))
            alpha = 1.0 - math.exp(-dt / smooth_tau)

            max_up_step = _get_display_profile_value(self._display_profile, 'canvas_max_up', 38.0) * dt
            max_down_step = _get_display_profile_value(self._display_profile, 'canvas_max_down', 80.0) * dt

            step = diff * alpha
            if step > 0:
                step = min(step, max_up_step)
            else:
                step = max(step, -max_down_step)

            self._pct = max(0.0, min(100.0, self._pct + step))

        # 물방울 애니메이션 제거(GPU 부하 완화)
        if self._voice:
            self._voice_t += 1
        if self._filling:
            self._wave_t += 1
        if self._complete_active:
            self._complete_t += 1
            total = self._RIPPLE_DELAY * self._RIPPLE_WAVES + self._RIPPLE_MAX / self._RIPPLE_SPEED
            if self._complete_t > total:
                self._complete_active = False
                self._complete_t = 0
        self._redraw()
        elapsed_ms = int((time.time() - frame_start) * 1000)
        proc_ms = (time.time() - frame_start) * 1000.0   # [계측] 벽시계 프레임 시간
        if proc_ms > self._frame_proc_max_ms:
            self._frame_proc_max_ms = proc_ms
        cpu_ms = (time.thread_time() - frame_cpu_start) * 1000.0  # [계측] 실제 CPU 시간
        if cpu_ms > self._frame_cpu_max_ms:
            self._frame_cpu_max_ms = cpu_ms
        next_delay = max(1, CANVAS_ANIM_MS - elapsed_ms)

        if time.time() < self._post_fill_recover_until:
            next_delay = max(1, min(next_delay, CANVAS_ANIM_MS))  # 20ms 강제 고속 루프 제거

        self._anim_id = self.after(next_delay, self._animate)

    def _get_voice_orb_photo(self, vol: float):
        """보라색 음성 오브 이미지를 캐시해서 반환한다."""
        try:
            vol = float(vol)
        except (TypeError, ValueError):
            vol = 0.5
        vol = max(0.0, min(1.0, vol))

        # 음성 입력이 작아도 시각적으로 충분히 보이도록 최소 표시값을 보장한다.
        if vol > 0.02:
            vol = max(vol, VOICE_ORB_MIN_VOL)

        vol_idx = int(round(vol * (VOICE_ORB_VOL_STEPS - 1)))
        vol_idx = max(0, min(VOICE_ORB_VOL_STEPS - 1, vol_idx))
        # redraw가 늦어져도 아우라 속도는 느려지지 않도록 실제 시간 기준으로 프레임 선택
        frame_idx = int(time.monotonic() * VOICE_ORB_ANIM_FPS) % VOICE_ORB_FRAME_COUNT
        key = (vol_idx, frame_idx)

        if key not in self._voice_orb_cache:
            cache_vol = vol_idx / float(max(1, VOICE_ORB_VOL_STEPS - 1))
            self._voice_orb_cache[key] = self._render_voice_orb_photo(cache_vol, frame_idx)

        return self._voice_orb_cache[key]

    def _render_voice_orb_photo(self, vol: float, frame_idx: int):
        """음성 오브 PhotoImage 1장을 생성한다. 생성 결과는 캐시에 저장되어 반복 사용된다."""
        cx, cy = RING_CX, RING_CY
        t = frame_idx * 0.42
        base_r = int((VOICE_ORB_BASE_R + vol * VOICE_ORB_GAIN_R) * SCALE)

        orb = Image.new('RGBA', (CUP_CW, CUP_CH), (0, 0, 0, 0))
        draw = ImageDraw.Draw(orb)

        for layer in self._ORB_LAYERS:
            r = base_r * layer['r_mult']
            amp = r * layer['amp'] * (0.4 + vol * 0.6)
            pts = []
            for j in range(VOICE_ORB_POINTS):
                angle = 2 * math.pi * j / VOICE_ORB_POINTS
                deform = (
                    amp * math.sin(3 * angle + t * layer['spd'] + layer['phase'])
                    + amp * 0.5 * math.sin(5 * angle - t * layer['spd'] * 0.8 + layer['phase'])
                    + amp * 0.3 * math.sin(2 * angle + t * layer['spd'] * 1.3)
                )
                rr = r + deform
                pts.append((cx + rr * math.cos(angle), cy + rr * math.sin(angle)))
            cr, cg, cb = layer['color']
            draw.polygon(pts, fill=(cr, cg, cb, layer['alpha']))

        orb = orb.filter(ImageFilter.GaussianBlur(radius=int(9 * SCALE)))
        return ImageTk.PhotoImage(orb)

    def _redraw(self):
        self.delete('all')
        pct = self._pct

        # ① 시리 오브 — 표시 상태는 VAD active만 따르되, 프레임은 실제 시간 기준으로 진행한다.
        if self._voice:
            self._orb_frame += 1
            try:
                raw_vol = float(getattr(core, 'mic_volume', 0.5))
            except (TypeError, ValueError):
                raw_vol = 0.5
            raw_vol = max(0.0, min(1.0, raw_vol))
            # 급수 시작 후 mic_volume 갱신이 듬성듬성 와도 크기가 갑자기 죽지 않게 EMA로 완충한다.
            self._voice_vol_smooth = self._voice_vol_smooth * 0.72 + raw_vol * 0.28
            vol = self._voice_vol_smooth
            self._voice_photo = self._get_voice_orb_photo(vol)
            if self._voice_photo is not None:
                self.create_image(0, 0, anchor='nw', image=self._voice_photo)
        else:
            self._voice_photo = None
            self._voice_vol_smooth *= 0.85

        # ② 원형 링 — 급수 중일 때만 표시
        if self._filling:
            r = RING_R
            cx, cy = RING_CX, RING_CY
            self.create_oval(cx-r, cy-r, cx+r, cy+r,
                             outline='#0d2010', width=14, fill='')
            self.create_oval(cx-r, cy-r, cx+r, cy+r,
                             outline='#1a3a1a', width=9, fill='')
            if pct > 0.5 and self._target > 0:
                extent = min(360, (pct / self._target) * 360)
                self.create_arc(cx-r, cy-r, cx+r, cy+r,
                                start=90, extent=-extent,
                                outline='#14532d', width=20, style='arc')
                self.create_arc(cx-r, cy-r, cx+r, cy+r,
                                start=90, extent=-extent,
                                outline='#4ade80', width=10, style='arc')

        # ③ 컵 몸통 배경
        sides = [CUP_TX-CUP_TRX, CUP_TY, CUP_BX-CUP_BRX, CUP_BY,
                 CUP_BX+CUP_BRX, CUP_BY, CUP_TX+CUP_TRX, CUP_TY]
        self.create_polygon(sides, fill='#06111f', outline='')

        # ④ 물 채움 (그라디언트)
        if pct > 0.2:
            wy  = CUP_BY - CUP_INNER_H * (pct / 100.0)
            wrx = self._rx_at(wy)
            wry = CUP_BRY + (CUP_TRY - CUP_BRY) * (pct / 100.0)

            strips = WATER_GRADIENT_STRIPS
            colors = ['#1e3a8a','#1e40af','#1d4ed8','#2055e0',
                      '#2563eb','#2b6cb0','#1e56c8','#1a4fc0',
                      '#1565c0','#1976d2','#1e88e5','#2196f3',
                      '#42a5f5','#1e40af']
            strip_h = (CUP_BY - wy) / strips
            for i in range(strips):
                y0 = CUP_BY - strip_h * (i + 1)
                y1 = CUP_BY - strip_h * i
                r0 = (CUP_BY - y0) / CUP_INNER_H
                r1 = (CUP_BY - y1) / CUP_INNER_H
                x0l = CUP_BX - (CUP_BRX + (CUP_TRX - CUP_BRX) * r0)
                x0r = CUP_BX + (CUP_BRX + (CUP_TRX - CUP_BRX) * r0)
                x1l = CUP_BX - (CUP_BRX + (CUP_TRX - CUP_BRX) * r1)
                x1r = CUP_BX + (CUP_BRX + (CUP_TRX - CUP_BRX) * r1)
                self.create_polygon(x0l, y0, x0r, y0, x1r, y1, x1l, y1,
                                    fill=colors[i], outline='')

            N = 36
            amp = max(2, int(5 * SCALE)) if self._filling else 1
            wave_pts = []
            for j in range(N + 1):
                frac = j / N
                x = (CUP_BX - wrx) + 2 * wrx * frac
                y = wy + amp * math.sin(2 * math.pi * (2.5 * frac - self._wave_t / 18.0))
                wave_pts += [x, y]
            poly_pts = wave_pts + [CUP_BX + CUP_BRX, CUP_BY, CUP_BX - CUP_BRX, CUP_BY]
            self.create_polygon(poly_pts, fill='#1e40af', outline='', smooth=False)
            self.create_line(wave_pts, fill='#93c5fd', width=2, smooth=True)

            # 물방울 그리기 제거(GPU 부하 완화)

        # ⑤ 하단 타원
        self.create_oval(CUP_BX-CUP_BRX, CUP_BY-CUP_BRY,
                         CUP_BX+CUP_BRX, CUP_BY+CUP_BRY,
                         fill='#0a1628', outline='#1e3a8a', width=6)
        self.create_oval(CUP_BX-CUP_BRX, CUP_BY-CUP_BRY,
                         CUP_BX+CUP_BRX, CUP_BY+CUP_BRY,
                         fill='', outline='#3b82f6', width=2)

        # ⑥ 컵 벽
        lx = CUP_TX - CUP_TRX
        self.create_line(lx, CUP_TY, CUP_BX-CUP_BRX, CUP_BY,
                         fill='#1e3a8a', width=10)
        self.create_line(lx+2, CUP_TY, CUP_BX-CUP_BRX+2, CUP_BY,
                         fill='#60a5fa', width=2)
        rx = CUP_TX + CUP_TRX
        self.create_line(rx, CUP_TY, CUP_BX+CUP_BRX, CUP_BY,
                         fill='#1e3a8a', width=10)
        self.create_line(rx-2, CUP_TY, CUP_BX+CUP_BRX-2, CUP_BY,
                         fill='#2563eb', width=2)

        # ⑦ 상단 림 타원
        self.create_oval(CUP_TX-CUP_TRX-2, CUP_TY-CUP_TRY-2,
                         CUP_TX+CUP_TRX+2, CUP_TY+CUP_TRY+2,
                         fill='#0d1a3a', outline='#1e3a8a', width=7)
        self.create_oval(CUP_TX-CUP_TRX, CUP_TY-CUP_TRY,
                         CUP_TX+CUP_TRX, CUP_TY+CUP_TRY,
                         fill='', outline='#67e8f9', width=2)

        # ⑧ 급수완료 파동 애니메이션
        if self._complete_active:
            cx, cy = RING_CX, RING_CY
            fade_colors = ['#4ade80','#36d474','#28c065','#1aaa52',
                           '#128e3f','#0a6e2e','#064e1e','#03300e']
            for i in range(self._RIPPLE_WAVES):
                start_t = i * self._RIPPLE_DELAY
                elapsed = self._complete_t - start_t
                if elapsed <= 0:
                    continue
                progress = elapsed * self._RIPPLE_SPEED
                if progress > self._RIPPLE_MAX:
                    continue
                r_wave = RING_R + progress
                fade = 1.0 - progress / self._RIPPLE_MAX
                ci = int((1 - fade) * (len(fade_colors) - 1))
                lw = max(1, int(5 * fade + 1))
                self.create_oval(cx - r_wave, cy - r_wave,
                                 cx + r_wave, cy + r_wave,
                                 outline=fade_colors[ci], width=lw, fill='')

        # ⑨ 수위 % 텍스트
        self.create_text(CUP_CW//2, CUP_CH//2,
                         text=f'{round(pct)}%',
                         font=(FONT_NUM, int(52 * SCALE), 'bold'), fill='white')

    def set_fill(self, pct: float, immediate: bool = False):
        pct = max(0.0, min(100.0, pct))
        self._pct_target = pct
        if immediate:
            self._pct = pct
            self._last_smooth_t = time.time()

    def get_fill(self) -> float:
        return float(self._pct)

    def freeze_fill(self):
        # 급수가 멈춘 뒤 이전 목표값을 계속 따라가며 올라가는 것을 막는다.
        self._pct_target = float(self._pct)
        self._last_smooth_t = time.time()

    def set_filling(self, filling: bool):
        self._filling = filling

    def set_target(self, target: float):
        self._target = max(1.0, target)

    def set_display_profile(self, profile: str):
        if profile not in DISPLAY_PROFILE_TABLE:
            profile = DISPLAY_PROFILE_UNKNOWN
        self._display_profile = profile

    def trigger_complete(self):
        self._complete_active = True
        self._complete_t = 0

    def set_voice(self, active: bool):
        # False가 잠깐 들어와도 애니메이션 카운터를 초기화하지 않는다.
        # 실제 프레임은 time.monotonic() 기준이라 급수 시작 후 redraw가 밀려도 아우라 속도가 느려지지 않는다.
        self._voice = bool(active)


