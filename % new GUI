    def _print_frame_diag(filling):
        cc = cup_canvas
        fc = max(1, cc._frame_count)
        gap_avg = cc._frame_gap_sum_ms / fc
        print(
            f'\n[DIAG] filling={filling}'
            f' | frame_n={cc._frame_count}'
            f' | gap_avg={gap_avg:.0f} gap_max={cc._frame_gap_max_ms:.0f}'
            f' | proc_max={cc._frame_proc_max_ms:.0f}'
            f' | cpu_max={cc._frame_cpu_max_ms:.0f}',
            flush=True,
        )
        cc._frame_gap_sum_ms = 0.0
        cc._frame_gap_max_ms = 0.0
        cc._frame_proc_max_ms = 0.0
        cc._frame_cpu_max_ms = 0.0
        cc._frame_count = 0

    # ── 100ms 주기 갱신 ──────────────────────────────
    def periodic_update():
        try:
            DAYS = ['월', '화', '수', '목', '금', '토', '일']
            n = datetime.datetime.now()
            clock_lbl.configure(
                text=(f'{n.year}.{n.month:02d}.{n.day:02d}'
                      f' ({DAYS[n.weekday()]}) | {n.hour:02d}:{n.minute:02d}')
            )

            with core.lock:
                d        = float(core.current_diameter)
                sf       = float(core.last_stable_f)
                tf       = float(core.target_freq)
                air      = float(core.last_current_air)
                hits     = int(core.consecutive_stop_hits)
                max_hits = int(core.STOP_TRIGGER_COUNT)
                filling  = bool(core.is_filling)
                init_air = float(core.init_air_len_cm)
                t_mode   = bool(core.tracking_mode)
                finish   = bool(core.request_finish)
                init_f   = float(core.initial_stable_freq)
                r2       = float(core.last_r2)
                t_inter  = float(core.theory_intercept)
                snap     = list(core.history_freq_snapshot)
                target_pct_save = float(core.TARGET_FILL_PCT)
                stop_elapsed_sec = float(getattr(core, 'last_stop_elapsed_sec', 0.0))
                core_fill_pct = float(getattr(core, 'last_fill_pct', 0.0) or 0.0)
                voice    = bool(getattr(core, 'voice_active', False))
                speech_text = str(getattr(core, 'last_recognized_text', '') or '')
                tts_text = str(getattr(core, 'last_tts_text', '') or '')
                tts_time = float(getattr(core, 'last_tts_time', 0.0) or 0.0)
                voice_ready = bool(getattr(core, 'voice_ready', False))
                voice_ready_text = str(getattr(core, 'voice_ready_text', '') or '')
                voice_remain_sec = float(getattr(core, 'voice_remain_sec', -1.0) or -1.0)
                voice_remain_time = float(getattr(core, 'voice_remain_time', 0.0) or 0.0)
                if finish:
                    core.request_finish = False

            # [계측] 약 2초 주기로 프레임 타이밍 진단 출력
            _diag_now = time.time()
            if _diag_now - _diag_last_t[0] >= 2.0:
                _print_frame_diag(filling)
                _diag_last_t[0] = _diag_now

            # voice_ready는 '말해도 되는 대기 상태'일 뿐 실제 발화가 아니다.
            # 따라서 아우라는 voice_active가 켜졌을 때만 표시하고, 짧은 VAD 끊김만 래치로 보정한다.
            now_voice_visual = time.time()
            if voice:
                voice_visual_until[0] = now_voice_visual + VOICE_VISUAL_LATCH_SEC
            visual_voice = bool(now_voice_visual < voice_visual_until[0])
            cup_canvas.set_voice(visual_voice)

            if voice:
                _fit_text_to_fixed_label(speech_text_lbl, '듣는 중 ...', kind='user')
                speech_text_lbl.configure(fg=CYAN)
            elif voice_ready:
                ready_msg = voice_ready_text if voice_ready_text else '말씀해 주세요'
                # 남은 발화 가능 시간 카운트다운 표시.
                # remain이 0 이상이고, 갱신된 지 1초 이내(오래된 값 제외)일 때만 '(N초)'를 덧붙인다.
                now_remain_gui = time.time()
                if voice_remain_sec >= 0.0 and (now_remain_gui - voice_remain_time) <= 1.0:
                    remain_disp = int(voice_remain_sec + 0.999)   # 올림 처리(0.1초 남아도 1초로 보이게)
                    ready_msg = f'{ready_msg} ({remain_disp}초)'
                _fit_text_to_fixed_label(speech_text_lbl, ready_msg, kind='user')
                speech_text_lbl.configure(fg=CYAN)
            elif speech_text:
                display_speech_text = speech_text                              # voice_module에서 이미 보정된 표시 문장

                _fit_text_to_fixed_label(
                    speech_text_lbl,
                    display_speech_text,
                    kind='user'
                )
                speech_text_lbl.configure(fg='#e2e8f0')
                
            else:
                _fit_text_to_fixed_label(speech_text_lbl, '호출어 또는 명령을 말해주세요', kind='user')
                speech_text_lbl.configure(fg=MUTED)

            now_tts = time.time()
            if tts_text and (now_tts - tts_time <= 30.0):
                _fit_text_to_fixed_label(tts_text_lbl, tts_text, base_size=13, small_size=10, kind='tts')
                tts_text_lbl.configure(fg=GUIDE_FG)
            elif tts_text:
                _fit_text_to_fixed_label(tts_text_lbl, tts_text, base_size=13, small_size=10, kind='tts')
                tts_text_lbl.configure(fg='#8b85c9')
            else:
                _fit_text_to_fixed_label(tts_text_lbl, '안내 대기 중', base_size=13, small_size=10, kind='tts')
                tts_text_lbl.configure(fg=MUTED)

            if finish:
                cup_canvas.trigger_complete()
                cup_canvas.recover_animation_after_fill()                     # 자동 정지 후 아우라/컵 애니메이션 타이밍 재정렬
                _close_core_audio_stream_later()                              # 자동 정지 후 급수 분석 스트림 해제
                try:
                    import voice_module as vm
                    vm.notify_water_finished(source='user_gui')               # 자동 정지 시 완료 안내 보장
                    if hasattr(vm, 'request_voice_audio_restart'):
                        vm.request_voice_audio_restart('fill_finished')        # 급수 후 음성 입력 스트림 재시작 요청
                except Exception as e:
                    print(f'\n[GUI] 음성 복구 요청 오류: {e}')

            now = time.time()
            if finish and (now - _last_saved_t[0]) > 2.0:
                _last_saved_t[0] = now
                threading.Thread(
                    target=save_to_csv,
                    args=(d, init_f, tf, sf),
                    kwargs=dict(
                        r2_final=r2, total_samples=len(snap),
                        theory_intercept=t_inter,
                        stand_type='filled_box', stand_height_cm=3.0,
                        estimated_stop_air_cm=air,
                        init_air_len_cm=init_air,
                        actual_fill_pct=None,
                        cup_type='user_mode',
                        target_fill_pct=target_pct_save,
                        stop_elapsed_sec=stop_elapsed_sec,
                    ),
                    daemon=True,
                ).start()

            # core에서 계산한 실제 추정 수위.
            # 이 값은 제어에는 그대로 쓰되, 사용자 화면에는 직접 넣지 않는다.
            # 특히 air=0 같은 초기화값은 계산식상 100%가 되므로 표시용 입력에서 제외한다.
            raw_fill_pct = 0.0
            raw_fill_valid = False
            water_started = bool(display_water_started[0])
            if filling and water_started:
                # core에서 현재 %가 생성되면 이것을 최우선으로 따라간다.
                # 아직 현재 %가 없을 때만 air/init_air 계산값을 보조로 사용한다.
                if 0.0 < core_fill_pct <= 100.0:
                    raw_fill_pct = max(0.0, min(100.0, core_fill_pct))
                    raw_fill_valid = True
                elif (init_air > 0.5 and DISPLAY_MIN_VALID_AIR_CM <= air <= init_air * 1.05):
                    raw_fill_pct = max(0.0, min(100.0,
                                       (1.0 - air / init_air) * 100.0))
                    raw_fill_valid = True

            target_pct = float(target_pct_var.get())
            now_for_display = time.time()
            dt = max(0.01, min(0.5, now_for_display - display_last_t[0]))
            display_last_t[0] = now_for_display

            # 초반 주파수 기반 컵 크기 프로파일 판정.
            # 목표 %가 아니라 실제로 먼저 들어오는 공명 주파수로 GUI 상승 속도를 결정한다.
            if filling and water_started:
                if display_profile_start_t[0] <= 0.0:
                    display_profile_start_t[0] = now_for_display

                profile_elapsed = max(0.0, now_for_display - display_profile_start_t[0])
                candidate_freq = 0.0

                if DISPLAY_FREQ_MIN_HZ <= sf <= DISPLAY_FREQ_MAX_HZ:
                    candidate_freq = sf
                elif DISPLAY_FREQ_MIN_HZ <= init_f <= DISPLAY_FREQ_MAX_HZ:
                    candidate_freq = init_f

                if candidate_freq > 0.0 and not display_profile_locked[0]:
                    display_profile_freqs[0].append(candidate_freq)
                    if len(display_profile_freqs[0]) > 30:
                        display_profile_freqs[0] = display_profile_freqs[0][-30:]

                enough_samples = len(display_profile_freqs[0]) >= DISPLAY_PROFILE_MIN_COUNT
                enough_time = profile_elapsed >= DISPLAY_PROFILE_LOCK_SEC
                force_time = profile_elapsed >= DISPLAY_PROFILE_FORCE_SEC

                if not display_profile_locked[0] and display_profile_freqs[0] and ((enough_samples and enough_time) or force_time):
                    vals = sorted(display_profile_freqs[0])
                    mid_i = len(vals) // 2
                    if len(vals) % 2:
                        median_hz = vals[mid_i]
                    else:
                        median_hz = (vals[mid_i - 1] + vals[mid_i]) / 2.0
                    display_profile_median_hz[0] = median_hz
                    display_profile[0] = _profile_from_early_freq(median_hz)
                    display_profile_locked[0] = True
                    print(f'\n[GUI] 표시 프로파일 확정: {display_profile[0]} ({median_hz:.0f} Hz)')

            time_per_sec = _get_display_profile_value(display_profile[0], 'time_per_sec', 4.8)
            rise_per_sec = _get_display_profile_value(display_profile[0], 'rise_per_sec', 7.5)
            catchup_per_sec = _get_display_profile_value(display_profile[0], 'catchup_per_sec', 18.0)
            cup_canvas.set_display_profile(display_profile[0])

            # 급수 시작 순간: 실제 추정값이 40~100%로 튀어도 화면은 0%에서 시작한다.
            if filling and not display_was_filling[0]:
                already_water_started = bool(display_water_started[0])
                display_pct_state[0] = 0.0
                if not already_water_started:
                    display_start_t[0] = now_for_display
                display_completed[0] = False
                display_raw_ready[0] = False
                display_raw_mode[0] = False
                display_last_raw_pct[0] = 0.0
                display_confirmed_raw_goal[0] = 0.0
                display_confirmed_raw_time[0] = 0.0
                display_pending_raw_goal[0] = None
                display_pending_raw_since[0] = 0.0
                if not already_water_started:
                    display_water_started[0] = False
                    water_started = False
                else:
                    water_started = True

            if finish:
                # 목표 도달로 급수가 끝난 순간: 표시값은 목표 수위에 정확히 맞춘다.
                display_pct_state[0] = target_pct
                display_completed[0] = True
                display_complete_t[0] = now_for_display   # 완료 시각 기록 → HOLD_SEC 후 0%로 복귀
                display_raw_ready[0] = False
                display_raw_mode[0] = False
                display_confirmed_raw_time[0] = 0.0
                display_pending_raw_goal[0] = None
                display_pending_raw_since[0] = 0.0
            elif filling:
                # 실제 밸브가 아직 열리지 않았으면 화면 수위는 0%에서 대기한다.
                # 이 부분이 버튼 직후 6% 정도로 먼저 올라가던 문제를 막는다.
                if not water_started or now_for_display < display_start_t[0]:
                    display_pct_state[0] = 0.0
                else:
                    elapsed_water = max(0.0, now_for_display - display_start_t[0])

                    # 출수 직후의 비정상 추정값 차단.
                    # 실제 물이 막 나오기 시작한 구간에서 25% 이상 튀면 표시용 입력에서 제외한다.
                    if (elapsed_water < DISPLAY_START_GUARD_SECONDS
                            and raw_fill_pct >= DISPLAY_EARLY_SPIKE_LIMIT_PCT):
                        raw_fill_valid = False

                    corrected_raw_goal = None
                    if raw_fill_valid:
                        display_raw_ready[0] = True
                        display_last_raw_pct[0] = raw_fill_pct
                        corrected_raw_goal = max(0.0, raw_fill_pct + DISPLAY_RAW_DISPLAY_BOOST_PCT)
                        corrected_raw_goal = max(0.0, min(target_pct, corrected_raw_goal))

                        # 현재 %가 생성된 순간부터는 시간 기준 임의 상승을 중단한다.
                        # 이후 화면은 core 현재 %에 지연 보정(+2%)을 더한 값만 따라간다.
                        if not display_raw_mode[0]:
                            display_raw_mode[0] = True
                            if display_pct_state[0] > corrected_raw_goal:
                                display_pct_state[0] = corrected_raw_goal

                        # 물은 실제로 줄지 않으므로 현재 %는 기본적으로 단조 증가값으로 확정한다.
                        # 단, 처음 생성된 현재 %는 그대로 기준값으로 잡는다.
                        confirmed = float(display_confirmed_raw_goal[0])
                        if confirmed <= 0.0:
                            display_confirmed_raw_goal[0] = corrected_raw_goal
                        else:
                            display_confirmed_raw_goal[0] = max(confirmed, corrected_raw_goal)
                        display_confirmed_raw_time[0] = now_for_display
                        display_pending_raw_goal[0] = None
                        display_pending_raw_since[0] = 0.0

                    time_goal = min(target_pct, elapsed_water * time_per_sec)
                    stable_raw_goal = float(display_confirmed_raw_goal[0])
                    cur_display = display_pct_state[0]

                    if display_raw_mode[0] and stable_raw_goal > 0.0:
                        # 현재 % 생성 후: 시간 기준으로 더 올라가지 않는다.
                        # 현재 %보다 낮으면 따라붙고, 혹시 앞서갔으면 천천히 내려 맞춘다.
                        desired_pct = max(0.0, min(target_pct, stable_raw_goal))
                        if cur_display < desired_pct:
                            cur_display = min(desired_pct,
                                              cur_display + catchup_per_sec * dt)
                        elif cur_display > desired_pct:
                            cur_display = max(desired_pct,
                                              cur_display - DISPLAY_FALL_PER_SEC * dt)
                    else:
                        # 현재 %가 아직 없을 때만 시간/주파수 기반 임시 상승을 사용한다.
                        desired_pct = time_goal
                        if target_pct < cur_display:
                            cur_display = max(target_pct, cur_display - DISPLAY_FALL_PER_SEC * dt)
                        elif desired_pct >= cur_display:
                            cur_display = min(desired_pct,
                                              cur_display + rise_per_sec * dt,
                                              target_pct)

                    display_pct_state[0] = max(0.0, min(target_pct, cur_display))
            else:
                # 대기 중에는 core의 남은 air 값이 0으로 초기화되어도 화면에 100%를 찍지 않는다.
                if display_completed[0]:
                    # 급수 완료 후 HOLD_SEC 동안은 가득 찬 화면을 유지하고,
                    # 그 시간이 지나면 완료 상태를 풀어 0%로 부드럽게 내려간다.
                    if now_for_display - display_complete_t[0] >= DISPLAY_COMPLETE_HOLD_SEC:
                        display_completed[0] = False
                        display_complete_t[0] = 0.0
                        display_pct_state[0] = 0.0
                    # HOLD 구간 동안은 display_pct_state(목표 수위)를 그대로 유지
                else:
                    display_pct_state[0] = 0.0
                display_raw_ready[0] = False
                display_raw_mode[0] = False
                display_last_raw_pct[0] = 0.0
                display_water_started[0] = False
                display_confirmed_raw_goal[0] = 0.0
                display_confirmed_raw_time[0] = 0.0
                display_pending_raw_goal[0] = None
                display_pending_raw_since[0] = 0.0

            display_fill_pct = display_pct_state[0]
            display_was_filling[0] = filling

            if finish:
                # 자동 정지 순간에는 목표값을 즉시 반영하고 고정해, 정지 후에도 컵이 계속 차오르는 느낌을 막는다.
                cup_canvas.set_fill(display_fill_pct, immediate=True)
                cup_canvas.freeze_fill()
            elif not filling:
                if display_completed[0]:
                    # 급수 완료 후 HOLD 구간: 가득 찬 화면을 그대로 고정 유지한다.
                    cup_canvas.set_fill(display_fill_pct, immediate=True)
                    cup_canvas.freeze_fill()
                else:
                    # HOLD가 끝나 0%로 복귀하는 구간: 즉시 고정하지 않고 목표값만 넘겨
                    # _animate의 하강 속도(canvas_max_down)로 부드럽게 내려가게 한다.
                    cup_canvas.set_fill(display_fill_pct)
            else:
                cup_canvas.set_fill(display_fill_pct)                  # 급수 중에는 목표값만 넘겨 부드럽게 추종
            cup_canvas.set_filling(filling)
            cup_canvas.set_target(target_pct)

            water_started_now = bool(display_water_started[0])  # 실제 밸브가 열린 뒤 True가 됨

            if not filling:
                status_lbl.configure(text='대 기  중', fg=CYAN)  # 급수 대기 상태
            elif not water_started_now:
                status_lbl.configure(text='소음 측정 중 ...', fg=AMBER)  # 밸브 열리기 전까지만 표시
            else:
                status_lbl.configure(text='급 수 중', fg=GREEN_CLR)  # 소음 측정 종료 후 급수 중 표시

            # ── 사용자 GUI 표시용 현재 Hz 보정 ─────────────────────
            # 제어값은 그대로 두고, 화면에 보이는 주파수만 목표 Hz를 넘지 않게 제한한다.
            # 게이지와 동일한 타이밍으로 동작시킨다:
            #  - 완료(또는 완료 후 HOLD): 목표 Hz에 고정(현재 주파수로 되돌아가지 않음)
            #  - 급수 중: 현재 주파수(목표 초과 표시는 차단)
            #  - 대기(완료 풀림 포함): 표시를 비운다(--- Hz)
            if tf > 0 and (finish or display_completed[0]):
                display_freq_hz = tf                              # 완료 후 표시는 목표 Hz에 고정
            elif filling and tf > 0 and sf > 0:
                display_freq_hz = min(sf, tf)                     # 급수 중 목표 Hz 초과 표시는 차단
            elif filling:
                display_freq_hz = sf                              # 급수 중 목표 Hz가 없으면 기존 값 표시
            else:
                display_freq_hz = 0.0                             # 대기 상태: 현재 Hz 표시 비움

            freq_cur_lbl.configure(
                text=f'{display_freq_hz:.0f} Hz' if display_freq_hz > 0 else '--- Hz',
                fg=GREEN_CLR if t_mode else AMBER,
            )
            freq_tgt_lbl.configure(
                text=f'{tf:.0f} Hz' if tf > 0 else '--- Hz',
            )

            freq_bar_cv.delete('all')
            bw = max(freq_bar_cv.winfo_width(), 10)
            freq_bar_cv.create_rectangle(0, 0, bw, 16, fill='#1e3a5f', outline='')

            # ── 게이지 목표 비율 결정 ────────────────────────────────
            # 컵 수위 애니메이션과 동일한 타이밍으로 움직인다.
            #  - 급수 중: 현재 주파수/목표 주파수 비율을 목표로 점진 상승.
            #  - 완료(또는 완료 후 HOLD 구간): 100%에 고정. 주파수가 흔들려도 현재 주파수로 되돌아가지 않는다.
            #  - 완료가 풀린 대기 상태: 0%로 복귀. (display_completed가 5초 뒤 False가 되며 컵과 함께 내려간다)
            if finish or display_completed[0]:
                target_ratio = 1.0                                  # 완료 도달 후 HOLD 동안 100% 고정
            elif filling and display_freq_hz > 0 and tf > 0:
                target_ratio = max(0.0, min(1.0, display_freq_hz / tf))  # 급수 중: 목표를 향해 진행
            elif filling:
                target_ratio = freq_bar_ratio[0]                    # 급수 중 목표 못 구하면 현재 값 유지(정체 시 멈추지 않게)
            else:
                target_ratio = 0.0                                  # 대기 상태: 게이지를 0으로 내린다

            # ── 게이지 비율 부드럽게 보간 ────────────────────────────
            now_bar = time.time()
            dt_bar = max(0.0, min(0.5, now_bar - freq_bar_last_t[0]))
            freq_bar_last_t[0] = now_bar

            cur_ratio = freq_bar_ratio[0]
            BAR_UP_PER_SEC   = 0.6   # 게이지 상승 최대 속도(초당 비율). 0.6이면 0→100%에 약 1.7초
            BAR_DOWN_PER_SEC = 2.0   # 대기/초기화 시 하강 속도(초당 비율)

            if target_ratio >= cur_ratio:
                # 목표가 더 높음: 상승 속도 상한을 두고 부드럽게 차오른다(점프 방지).
                cur_ratio = min(target_ratio, cur_ratio + BAR_UP_PER_SEC * dt_bar)
            elif (not filling) and (not display_completed[0]):
                # 대기 상태(완료 풀림 포함): 게이지를 0으로 부드럽게 내린다.
                cur_ratio = max(target_ratio, cur_ratio - BAR_DOWN_PER_SEC * dt_bar)
            else:
                # 급수 중 목표가 현재보다 낮음(주파수 흔들림): 한번 올라간 게이지는 잘 내리지 않게 천천히만 내린다.
                cur_ratio = max(target_ratio, cur_ratio - BAR_UP_PER_SEC * 0.5 * dt_bar)

            freq_bar_ratio[0] = max(0.0, min(1.0, cur_ratio))

            if freq_bar_ratio[0] > 0.0:
                fill_w = int(bw * freq_bar_ratio[0])
                freq_bar_cv.create_rectangle(0, 0, fill_w, 16, fill=CYAN, outline='')

            if len(hit_dots) != max_hits:
                rebuild_dots(max_hits)
            for i, dw in enumerate(hit_dots):
                dw.configure(fg=BLUE if i < hits else BORDER)

            btn_start.configure(
                fg_color='#14532d' if filling else '#0e2819',
                text_color='#86efac',
            )

        except Exception as e:
            print(f'\n[periodic_update 오류] {e}')
        finally:
            app.after(UI_UPDATE_MS, periodic_update)

    core.solenoid_off()
    periodic_update()

    if callable(on_ready):
        app.after(300, on_ready)  # GUI 초기화 후 음성인식 스레드 시작

    app.mainloop()


if __name__ == '__main__':
    run_kiosk_gui()
