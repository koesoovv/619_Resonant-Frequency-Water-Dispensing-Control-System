    def _close_core_audio_stream_later(delay_sec=CORE_AUDIO_CLOSE_DELAY_SEC):
        """급수 종료 후 급수제어용 오디오 스트림을 늦게 닫아 음성/GUI 부하를 줄인다."""
        stream_ref = getattr(core, 'audio_stream', None)          # 현재 열린 급수 분석 스트림 참조
        if stream_ref is None:                                    # 열린 스트림이 없으면 정리할 것이 없음
            return

        def _worker():
            time.sleep(max(0.0, float(delay_sec)))                # stop_filling/CSV 스냅샷 반영 시간 확보
            try:
                with core.lock:
                    filling = bool(core.is_filling)               # 새 급수가 시작됐으면 닫으면 안 됨
                if filling:
                    return

                current = getattr(core, 'audio_stream', None)     # 현재 스트림 재확인
                if current is None:
                    return
                if current is not stream_ref:                     # 다음 급수에서 새 스트림이 열렸으면 보호
                    return

                try:
                    current.stop()                                # 급수 분석 스트림 정지
                except Exception:
                    pass
                try:
                    current.close()                               # 오디오 장치 해제
                except Exception:
                    pass

                core.audio_stream = None                          # 다음 급수 때 ensure_audio_stream()이 새로 열도록 함
                print('\n[GUI] 급수 종료 후 core audio_stream 정리 완료')
            except Exception as e:
                print(f'\n[GUI] core audio_stream 정리 오류: {e}')

