        safe_text = str(text).strip() if text is not None else ''
        text_len = len(safe_text)

        if kind == 'tts':
            if text_len <= 26:
                size = base_size
            elif text_len <= 38:
                size = 12
            elif text_len <= 54:
                size = 11
            else:
                size = small_size
            label.configure(font=(FONT_SANS, size, 'bold'), wraplength=650, height=2)
        else:
            if text_len <= 18:
                size = 12
            elif text_len <= 32:
                size = 11
            else:
                size = 10
            label.configure(font=(FONT_SANS, size, 'bold'), wraplength=650)

        label.configure(text=safe_text)

