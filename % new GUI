        display_pending_raw_goal[0] = None
        display_pending_raw_since[0] = 0.0
        display_profile[0] = DISPLAY_PROFILE_UNKNOWN
        display_profile_locked[0] = False
        display_profile_freqs[0] = []
        display_profile_start_t[0] = 0.0
        display_profile_median_hz[0] = 0.0
        cup_canvas.set_display_profile(DISPLAY_PROFILE_UNKNOWN)
        cup_canvas.set_fill(0.0, immediate=True)

        pct = target_pct_var.get()
        core.TARGET_FILL_PCT = float(pct)
        with core.lock:
            init_air = float(core.init_air_len_cm)
        if init_air > 0.5:
            with core.lock:
                core._eff_target_air_cm = max(0.5, init_air * (1.0 - pct / 100.0))
        core.ensure_audio_stream()
        core.start_filling_local()

        def _pump():
            time.sleep(core.NOISE_CALIBRATION_TIME + 0.1)
            with core.lock:
                if core.is_filling:
                    core.solenoid_on()
                    # 사용자 화면의 수위 증가는 버튼 누른 시점이 아니라 실제 밸브가 열린 시점부터 시작한다.
                    now2 = time.time()
                    display_water_started[0] = True
                    display_start_t[0] = now2 + DISPLAY_WATER_SETTLE_SECONDS
                    display_last_t[0] = now2
                    display_pct_state[0] = 0.0
                    display_raw_ready[0] = False
                    display_raw_mode[0] = False
                    display_last_raw_pct[0] = 0.0
                    display_confirmed_raw_goal[0] = 0.0
                    display_confirmed_raw_time[0] = 0.0
                    display_pending_raw_goal[0] = None
                    display_pending_raw_since[0] = 0.0
                    display_profile[0] = DISPLAY_PROFILE_UNKNOWN
                    display_profile_locked[0] = False
                    display_profile_freqs[0] = []
                    display_profile_start_t[0] = now2
                    display_profile_median_hz[0] = 0.0
                    cup_canvas.set_display_profile(DISPLAY_PROFILE_UNKNOWN)
                    print('\n>>> 펌프 가동!')

        threading.Thread(target=_pump, daemon=True).start()

