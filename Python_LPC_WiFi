tcp = None                                                          # (추가) TCP 클라이언트 객체

class UnoWifiClient:                                                # (추가) 지속 연결 TCP 클라이언트
    def __init__(self, ip: str, port: int, timeout_s: float = 3.0):  # 생성자
        self.ip = ip                                                # IP 저장
        self.port = port                                            # 포트 저장
        self.timeout_s = timeout_s                                  # 타임아웃 저장
        self.s = None                                               # 소켓 핸들
        self.buf = b""                                              # 수신 버퍼

    def connect(self) -> bool:                                      # 연결 시도
        self.close()                                                # 기존 연결 닫기
        try:
            self.s = socket.create_connection((self.ip, self.port), timeout=self.timeout_s)  # 연결
            self.s.settimeout(self.timeout_s)                       # 타임아웃 설정
            return True                                             # 성공
        except Exception:
            self.s = None                                           # 실패 처리
            return False                                            # 실패

    def close(self):                                                # 연결 종료
        if self.s:                                                  # 소켓 있으면
            try: self.s.close()                                     # 닫기
            except: pass                                            # 무시
        self.s = None                                               # 핸들 제거
        self.buf = b""                                              # 버퍼 초기화

    def send_bit(self, bit: bytes) -> None:                         # '1'/'0' 전송 (기존 serial_write(b'1') 유지용)
        if self.s is None:                                          # 미연결이면
            if not self.connect():                                  # 재연결 시도
                raise ConnectionError("TCP connect fail")            # 실패면 예외
        if not bit:                                                 # 빈 값이면
            return                                                  # 종료
        b0 = bytes([bit[0]])                                        # 첫 바이트만 사용
        if b0 not in (b'0', b'1'):                                  # 0/1 아니면
            return                                                  # 무시
        self.s.sendall(b0 + b"\n")                                  # "0\n" 또는 "1\n" 전송

    def recv_line(self) -> str:                                     # 한 줄 수신(\n까지)
        if self.s is None:                                          # 미연결이면
            return ""                                               # 빈 문자열
        while b"\n" not in self.buf:                                # \n 나올 때까지
            chunk = self.s.recv(1024)                               # 수신
            if not chunk:                                           # 끊김이면
                self.close()                                        # 닫기
                return ""                                           # 빈 문자열
            self.buf += chunk                                       # 누적
        line, self.buf = self.buf.split(b"\n", 1)                   # 1줄 분리
        return line.decode(errors="ignore").strip()                 # 문자열 반환

def connect_serial(port: str, baud: int) -> bool:                   # (유지) 함수명 유지, 내부만 TCP로 교체
    global tcp                                                      # 전역 tcp 사용
    try:
        ip = str(port).strip()                                      # (변경) PORT 입력칸 = IP
        tcp_port = int(baud)                                        # (변경) BAUD 입력칸 = TCP 포트
        tcp = UnoWifiClient(ip, tcp_port, timeout_s=3.0)            # 클라이언트 생성
        ok = tcp.connect()                                          # 연결 시도
        print(f"[{ip}:{tcp_port}] UNO WiFi 연결 {'성공' if ok else '실패'}")  # 로그
        return ok                                                   # 결과
    except Exception:
        tcp = None                                                  # 실패 처리
        print(f"[{port}:{baud}] UNO WiFi 연결 실패 (테스트 모드).")  # 로그
        return False                                                # 실패

def serial_write(b: bytes) -> None:                                 # (유지) 호출부 그대로 두기 위한 래퍼
    global tcp                                                      # 전역 tcp 사용
    if tcp is None:                                                 # 연결 없으면
        return                                                      # 종료
    try:
        tcp.send_bit(b)                                             # b'1' 또는 b'0' 전송
    except Exception:
        return                                                      # 예외 무시

# =========================================================
# [5-A. LPC(선형예측) 유틸리티]
# =========================================================
def levinson_durbin(r, order):                                      # Levinson-Durbin(자기상관 기반 AR계수)
    a = np.zeros(order + 1, dtype=float)                            # AR 계수 배열(길이 order+1)
    e = float(r[0])                                                 # 초기 오차 에너지
    if e <= 0:                                                      # r[0]이 0이면 실패
        return None                                                 # 실패 반환
    a[0] = 1.0                                                      # a0 = 1
    for k in range(1, order + 1):                                   # 1..order 반복
        acc = 0.0                                                   # 누적항
        for j in range(1, k):                                       # 내부 합
            acc += a[j] * r[k - j]                                  # a[j]*r[k-j]
        lam = -(r[k] + acc) / (e + 1e-12)                           # 반사계수(안전 eps)
        a_new = a.copy()                                            # 업데이트용 복사
        a_new[k] = lam                                              # 새 계수
        for j in range(1, k):                                       # 대칭 업데이트
            a_new[j] = a[j] + lam * a[k - j]                        # 갱신
        a = a_new                                                   # 적용
        e *= (1.0 - lam * lam)                                      # 오차 갱신
        if e <= 1e-12:                                              # 너무 작아지면 중단
            break                                                   # 중단
    return a                                                        # AR 다항식 반환(1 + a1 z^-1 + ...)

def lpc_peak_frequency(filtered_chunk, rate, current_min, current_ceil):  # LPC 스펙트럼 피크 추정
    x = filtered_chunk.astype(float)                                # float 변환
    if np.mean(x * x) < LPC_MIN_VALID_ENERGY:                       # 에너지가 너무 작으면
        return 0.0                                                  # 실패 반환
    x = x - np.mean(x)                                              # DC 제거
    x = x * np.hamming(len(x))                                      # 창 적용(짧은 구간 안정화)
    x = x / (np.max(np.abs(x)) + 1e-12)                             # 정규화(수치 안정)

    order = int(LPC_ORDER)                                          # LPC 차수
    if order < 4:                                                   # 너무 낮으면 의미 없음
        return 0.0                                                  # 실패 반환
    if order >= len(x) - 1:                                         # 차수가 너무 크면 실패
        order = max(4, len(x) // 4)                                 # 안전하게 축소

    # --- 자기상관 계산(r[0..order]) ---
    r = np.zeros(order + 1, dtype=float)                            # autocorr 배열
    for k in range(order + 1):                                      # 0..order
        r[k] = np.dot(x[:len(x) - k], x[k:])                        # r[k] = sum x[n]*x[n+k]

    a = levinson_durbin(r, order)                                   # AR 계수 추정
    if a is None:                                                   # 실패면
        return 0.0                                                  # 0 반환

    # --- AR 스펙트럼: P(w) ~ 1/|A(e^jw)| ---
    A = np.fft.rfft(a, n=LPC_NFFT)                                  # A(e^jw) 계산
    mag = 1.0 / (np.abs(A) + 1e-12)                                 # 1/|A|
    freqs = np.fft.rfftfreq(LPC_NFFT, d=1.0 / rate)                 # 주파수 축

    mask = (freqs >= current_min) & (freqs <= current_ceil)         # 관심 대역 마스크
    if not np.any(mask):                                            # 비어 있으면
        return 0.0                                                  # 실패 반환
    valid_freqs = freqs[mask]                                       # 유효 주파수
    valid_mag = mag[mask]                                           # 유효 크기

    prom = np.max(valid_mag) * LPC_PEAK_PROM_RATIO                  # prominence 설정
    peaks, _ = signal.find_peaks(valid_mag, prominence=prom, distance=10)  # 피크 탐색
    if len(peaks) == 0:                                             # 피크 없으면
        return 0.0                                                  # 실패 반환

    peak_freqs = valid_freqs[peaks]                                 # 피크 주파수들
    peak_mags = valid_mag[peaks]                                    # 피크 크기들

    # --- 노이즈 프로파일 근처 제외 ---
    clean_idx = []                                                  # 깨끗한 후보 인덱스
    for i, f in enumerate(peak_freqs):                              # 각 피크에 대해
        is_noise = False                                            # 노이즈 여부
        for nf in noise_profile:                                    # 저장된 노이즈 피크들과 비교
            if abs(f - nf) < 25.0:                                  # ±25Hz 이내면
                is_noise = True                                     # 노이즈로 간주
                break                                               # 중단
        if not is_noise:                                            # 노이즈 아니면
            clean_idx.append(i)                                     # 후보로 추가

    if not clean_idx:                                               # 모두 노이즈면
        return 0.0                                                  # 실패 반환

    clean_freqs = peak_freqs[clean_idx]                             # clean 주파수
    clean_mags = peak_mags[clean_idx]                               # clean 크기
    dom = float(clean_freqs[int(np.argmax(clean_mags))])            # 가장 큰 피크 선택
    return dom                                                      # LPC 기반 후보 반환

# =========================================================
# [5-B. 알고리즘: 스마트 주파수 추적 (FFT 기본 + LPC 보조)]
# =========================================================
def get_smart_frequency(chunk, rate, last_freq, current_min, current_ceil):  # 주파수 추정 함수
    # HPF 150Hz
    sos = signal.butter(4, 150, 'hp', fs=rate, output='sos')         # 150Hz 하이패스
    filtered_chunk = signal.sosfilt(sos, chunk)                      # 필터 적용

    # ===== (1) FFT 기반 추정(기본) =====
    windowed = filtered_chunk * np.hamming(len(chunk))               # 창 적용
    fft_val = np.abs(np.fft.rfft(windowed))                          # FFT 크기
    freqs = np.fft.rfftfreq(len(chunk), d=1/rate)                    # 주파수 축

    mask = (freqs >= current_min) & (freqs <= current_ceil)          # 탐색 범위 마스크
    valid_freqs = freqs[mask]                                        # 유효 주파수
    valid_mag = fft_val[mask]                                        # 유효 크기

    if len(valid_mag) == 0:                                          # 범위가 비면
        return 0.0                                                   # 실패 반환

    peaks, _ = signal.find_peaks(valid_mag, prominence=np.max(valid_mag)*0.15, distance=10)  # 피크 탐색

    if len(peaks) == 0:                                              # 피크가 없으면
        fft_candidate = float(valid_freqs[np.argmax(valid_mag)])     # 최대값 bin을 후보로
    else:
        peak_freqs = valid_freqs[peaks]                              # 피크 주파수
        peak_mags = valid_mag[peaks]                                 # 피크 크기

        clean_candidates_idx = []                                    # 노이즈 제외 후보
        for i, f in enumerate(peak_freqs):                           # 각 피크 검사
            is_noise = False                                         # 노이즈 여부
            for noise_f in noise_profile:                            # 노이즈 리스트 비교
                if abs(f - noise_f) < 25.0:                          # ±25Hz 이내면
                    is_noise = True                                  # 노이즈 처리
                    break                                            # 중단
            if not is_noise:                                         # 노이즈 아니면
                clean_candidates_idx.append(i)                       # 후보로 채택

        if not clean_candidates_idx:                                 # 후보가 전부 노이즈면
            fft_candidate = 0.0                                      # FFT 후보 실패
        else:
            clean_freqs = peak_freqs[clean_candidates_idx]           # clean 주파수
            clean_mags = peak_mags[clean_candidates_idx]             # clean 크기
            dom_freq = float(clean_freqs[int(np.argmax(clean_mags))])# 가장 큰 피크
            fft_candidate = dom_freq                                  # FFT 후보 확정

    # ===== (2) 배음(고조파) 역산/차단 로직(FFT 후보에 적용) =====
    if fft_candidate > 0 and last_freq > 0:                          # 이전값이 있으면
        ratio = fft_candidate / last_freq                            # 비율 계산
        if 2.7 <= ratio <= 3.3:                                      # 3배 근처면
            fft_candidate = float(fft_candidate / 3.0)               # 1/3로 보정
        elif 4.7 <= ratio <= 5.3:                                    # 5배 근처면
            fft_candidate = float(fft_candidate / 5.0)               # 1/5로 보정
        elif ratio > 2.5:                                            # 너무 크게 튀면
            fft_candidate = 0.0                                      # 실패 처리

    # ===== (3) LPC 보조(조건부) =====
    if USE_LPC_ASSIST:                                               # LPC 보조 사용이면
        need_lpc = False                                             # LPC 필요 여부
        if fft_candidate <= 0.0:                                     # FFT가 실패했으면
            need_lpc = True                                          # LPC로 복구 시도
        elif last_freq > 0 and abs(fft_candidate - last_freq) > 250: # 갑자기 크게 튀면(경험적)
            need_lpc = True                                          # LPC로 교차검증

        if need_lpc:                                                 # LPC를 써야 하면
            lpc_candidate = lpc_peak_frequency(filtered_chunk, rate, current_min, current_ceil)  # LPC 후보
            if lpc_candidate > 0:                                    # LPC가 성공하면
                # --- LPC 후보도 배음 보정(이전값 기준) ---
                if last_freq > 0:                                    # 이전값이 있으면
                    ratio2 = lpc_candidate / last_freq               # 비율 계산
                    if 2.7 <= ratio2 <= 3.3:                         # 3배 근처
                        lpc_candidate = float(lpc_candidate / 3.0)   # 보정
                    elif 4.7 <= ratio2 <= 5.3:                       # 5배 근처
                        lpc_candidate = float(lpc_candidate / 5.0)   # 보정
                    elif ratio2 > 2.5:                               # 너무 튀면
                        lpc_candidate = 0.0                          # 실패 처리

                if lpc_candidate > 0:                                # 최종 유효하면
                    return float(lpc_candidate)                      # LPC 후보 채택(복구/교차검증)

    return float(fft_candidate)                                      # 기본은 FFT 후보 반환

# =========================================================
# [6. (이름만 RANSAC) 잔차 컷 + 재회귀로 강건 기울기]
# =========================================================
def robust_slope_calculation(times, inv_freqs):                      # 강건 기울기 계산
    if len(times) < 10: return None, 0                               # 데이터 부족
    x = np.array(times)                                              # x 배열
    y = np.array(inv_freqs)                                          # y 배열
    try:
        p = np.polyfit(x, y, 1)                                      # 1차 피팅(초기)
        y_pred = p[0] * x + p[1]                                     # 예측값
        residuals = np.abs(y - y_pred)                               # 잔차(abs)
        threshold = np.percentile(residuals, 70)                     # 70퍼센타일 컷
        inlier_mask = residuals <= threshold                         # inlier 마스크
        x_in = x[inlier_mask]                                        # inlier x
        y_in = y[inlier_mask]                                        # inlier y

        if len(x_in) < 8: return None, 0                             # inlier 부족

        slope, intercept = np.polyfit(x_in, y_in, 1)                 # inlier 재피팅
        y_in_pred = slope * x_in + intercept                         # inlier 예측
        ss_res = np.sum((y_in - y_in_pred) ** 2)                     # SSE
        ss_tot = np.sum((y_in - np.mean(y_in)) ** 2)                 # SST
        r_squared = 1 - (ss_res / ss_tot) if ss_tot > 0 else 0       # R^2
        return slope, r_squared                                      # 기울기, 품질 반환
    except:
        return None, 0                                               # 실패 반환

# =========================================================
# [7. 제어 로직]
# =========================================================
def start_filling_local() -> None:                                   # 주입 시작(로컬 상태 초기화)
    global is_filling, filling_start_time, calibration_done, calibration_frozen
    global freq_buffer, reg_time_buffer, reg_inv_freq_buffer, diameter_candidates
    global history_time, history_freq
    global last_tracked_freq, consecutive_loss_count, consecutive_stop_hits
    global current_diameter, target_freq, initial_stable_freq
    global request_finish, last_stable_f, last_current_air, dynamic_min_limit, noise_profile

    with lock:
        is_filling = True                                            # 주입 ON
        filling_start_time = time.time()                             # 시작 시간
        calibration_done = False                                     # 캘리 초기화
        calibration_frozen = False                                   # 캘리 동결 해제
        freq_buffer = []                                             # 주파수 버퍼 초기화
        reg_time_buffer.clear()                                      # 회귀 버퍼 초기화
        reg_inv_freq_buffer.clear()                                  # 회귀 버퍼 초기화
        diameter_candidates.clear()                                  # 후보 버퍼 초기화
        history_time = []                                            # 히스토리 초기화
        history_freq = []                                            # 히스토리 초기화
        last_tracked_freq = 0.0                                      # 추적값 초기화
        consecutive_loss_count = 0                                   # 손실 카운트 초기화
        consecutive_stop_hits = 0                                    # hits 초기화
        initial_stable_freq = 0.0                                    # 초기 주파수 초기화
        current_diameter = 0.0                                       # 지름 초기화
        target_freq = 0.0                                            # 목표 초기화
        request_finish = False                                       # 저장 트리거 초기화
        last_stable_f = 0.0                                          # 안정 주파수 초기화
        last_current_air = 0.0                                       # 공기층 초기화
        dynamic_min_limit = FREQ_MIN_LIMIT                           # 동적 하한 초기화
        noise_profile = []                                           # 노이즈 프로파일 초기화

    print("\n>>> [1단계] 배경 소음 측정 (1초)...")                      # 안내 출력

def stop_filling_local(save_result: bool) -> None:                   # 주입 종료(로컬)
    global is_filling, request_finish
    with lock:
        is_filling = False                                           # 주입 OFF
        if save_result:
            request_finish = True                                    # 저장 요청
    print("\n>>> 물 주입 종료.")                                       # 안내 출력

# =========================================================
# [8. 오디오 콜백 (Stable Version)]
# =========================================================
def audio_callback(indata, frames, time_info, status):               # 오디오 콜백
    global is_filling, filling_start_time, calibration_done, calibration_frozen
    global target_freq, current_diameter
    global freq_buffer, reg_time_buffer, reg_inv_freq_buffer, diameter_candidates
    global history_time, history_freq
    global last_tracked_freq, consecutive_loss_count, consecutive_stop_hits
    global request_finish, last_stable_f, last_current_air, initial_stable_freq
    global last_print_time, dynamic_min_limit, noise_profile
    global STOP_TRIGGER_COUNT, CONTROL_START_TIME, FREQ_MAX_LIMIT, EARLY_CEIL_HZ

    with lock:
        if not is_filling: return                                    # 주입 중 아니면 무시

    chunk = indata.flatten().astype(float)                           # 1채널 flatten
    if np.max(np.abs(chunk)) < 0.01: return                          # 너무 작으면 무시

    try:
        with lock:
            current_time = time.time()                               # 현재 시각
            elapsed = current_time - filling_start_time              # 경과 시간

        # [Phase 1] 노이즈 수집
        if elapsed < NOISE_CALIBRATION_TIME:                          # 노이즈 수집 구간이면
            windowed = chunk * np.hamming(len(chunk))                 # 창 적용
            fft_val = np.abs(np.fft.rfft(windowed))                   # FFT
            freqs = np.fft.rfftfreq(len(chunk), d=1/SAMPLE_RATE)      # 주파수 축
            mask = (freqs >= 100) & (freqs <= 2000)                   # 노이즈 탐색 범위
            if np.any(mask):                                          # 범위 유효하면
                valid_freqs = freqs[mask]                             # 주파수
                valid_mag = fft_val[mask]                             # 크기
                peaks, _ = signal.find_peaks(valid_mag, prominence=np.max(valid_mag)*0.2)  # 피크
                for p in peaks:                                       # 피크 순회
                    f_noise = valid_freqs[p]                          # 피크 주파수
                    if not any(abs(f_noise - nf) < 20 for nf in noise_profile):  # 중복 제거
                        noise_profile.append(f_noise)                 # 노이즈 등록
            return                                                    # 노이즈 구간은 종료

        filling_elapsed = elapsed - NOISE_CALIBRATION_TIME            # 실제 주입 경과

        # [Safety 1] 초기 물 튀는 소리 무시 (2초)
        if filling_elapsed < SPLASH_GUARD_TIME:
            return

        # [Safety 2] ceiling 결정(락 풀림 튐 방지: last=0이어도 안정값 기반 제한)
        if filling_elapsed < 3.5:                                     # 초반(3.5초 전)
            current_ceil = EARLY_CEIL_HZ                              # 초반 상한 제한
        else:
            base = float(last_tracked_freq)                           # 기본 기준 = last
            if base <= 0 and last_stable_f > 0:                       # last가 없으면 최근 안정값
                base = float(last_stable_f)                           # 재획득 기준
            if base <= 0 and initial_stable_freq > 0:                 # 그래도 없으면 초기 안정값
                base = float(initial_stable_freq)                     # 최소 기준
            if base > 0:
                current_ceil = min(FREQ_MAX_LIMIT, base + 600.0)      # last+600 방식 유지
            else:
                current_ceil = FREQ_MAX_LIMIT                         # 정말 아무 기준도 없을 때만 풀림

        # [Rising Floor]
        if last_tracked_freq > 400:
            new_floor = last_tracked_freq * 0.7                       # 하한 상승
            if new_floor > dynamic_min_limit:
                dynamic_min_limit = new_floor                         # 하한 업데이트

        if target_freq > 0 and dynamic_min_limit > target_freq * 0.85:
            dynamic_min_limit = target_freq * 0.85                    # 목표 이후 하한 과상승 방지

        detected_f = get_smart_frequency(chunk, SAMPLE_RATE, last_tracked_freq, dynamic_min_limit, current_ceil)  # 주파수 추정(FFT+LPC 보조)

        if detected_f < dynamic_min_limit:                            # 하한 미만이면
            detected_f = 0                                            # 실패 처리

        # [Safety 3] 3.5초 전 급발진 차단
        if filling_elapsed < 3.5 and detected_f > EARLY_CEIL_HZ:
            detected_f = 0                                            # 차단

        if detected_f == 0:                                           # 실패면
            consecutive_loss_count += 1                               # 손실 카운트 증가
            if consecutive_loss_count > 10:                           # 장기 손실이면(락 붕괴 구간)
                if last_stable_f > 0:                                 # 최근 안정값이 있으면
                    last_tracked_freq = float(last_stable_f)          # last를 안정값으로 재부여(재획득 기반)
                elif initial_stable_freq > 0:                         # 초기 안정값이라도 있으면
                    last_tracked_freq = float(initial_stable_freq)    # last를 초기값으로 유지
                else:
                    last_tracked_freq *= 0.9                          # 아무것도 없으면 완만 감쇠(0 리셋 방지)
            return                                                    # 실패 프레임은 종료

        consecutive_loss_count = 0                                    # 손실 리셋

        if last_tracked_freq > 0:
            detected_f = last_tracked_freq * 0.7 + detected_f * 0.3   # 1차 평활

        last_tracked_freq = detected_f                                # 추적값 업데이트

        freq_buffer.append(detected_f)                                # 버퍼 추가
        if len(freq_buffer) > 5: freq_buffer.pop(0)                   # 최근 5개 유지
        stable_f = float(np.median(freq_buffer))                      # median으로 안정화

        with lock:
            history_time.append(filling_elapsed)                      # 그래프 시간
            history_freq.append(detected_f)                           # 그래프 주파수
            last_stable_f = stable_f                                  # 안정 주파수 저장
            if filling_elapsed > SPLASH_GUARD_TIME and initial_stable_freq == 0:
                initial_stable_freq = stable_f                        # 초기 안정 주파수 기록

        # --- [데이터 수집 & 지름 계산 (CALC_START_TIME 이후 시작)] ---
        if filling_elapsed > CALC_START_TIME:
            if target_freq > 0 and stable_f > (target_freq * CALIBRATION_CUTOFF_RATIO):
                calibration_frozen = True                             # 목표 근접하면 캘리 동결

            if not calibration_frozen:
                if initial_stable_freq > 0 and stable_f > initial_stable_freq * 1.02:  # 2% 이상 상승 시만
                    reg_time_buffer.append(filling_elapsed)           # 시간 저장
                    reg_inv_freq_buffer.append(1.0 / stable_f)        # 1/f 저장

                    if len(reg_time_buffer) > 12:
                        s_a, r_sq = robust_slope_calculation(reg_time_buffer, reg_inv_freq_buffer)  # 강건 기울기

                        if s_a is not None and abs(s_a) > 1e-9 and r_sq > 0.75:
                            temp_D = np.sqrt((16 * FLOW_RATE) / (np.pi * SOUND_SPEED * abs(s_a)))  # 지름 추정
                            temp_D *= DIAMETER_SCALE                      # 지름 보정 적용

                            if 2.0 < temp_D < 15.0:                       # 범위 필터
                                diameter_candidates.append(temp_D)         # 후보 추가
                                if len(diameter_candidates) >= 5:
                                    median_D = float(np.median(list(diameter_candidates)[-5:]))  # 최근 5개 median
                                    if current_diameter == 0:
                                        current_diameter = median_D        # 초기값
                                    else:
                                        current_diameter = current_diameter * 0.9 + median_D * 0.1  # 저역통과
                                else:
                                    current_diameter = float(temp_D)       # 후보 적으면 바로 사용

                                target_L_effective = TARGET_AIR_CM + (END_CORRECTION_K * current_diameter)  # 유효 길이
                                target_freq = SOUND_SPEED / (4 * target_L_effective)                         # 목표 주파수
                                calibration_done = True                  # 캘리 완료

        # [제어 로직]
        if filling_elapsed > CONTROL_START_TIME and calibration_done:
            current_air = (SOUND_SPEED / (4 * stable_f)) - (END_CORRECTION_K * current_diameter)  # 공기층 계산
            with lock:
                last_current_air = float(current_air)                   # GUI 표시용 저장

            if stable_f >= (target_freq + STOP_OFFSET_HZ):             # 목표 이상이면
                consecutive_stop_hits += 1                              # hits 증가
            else:
                if consecutive_stop_hits > 0:
                    consecutive_stop_hits -= 1                          # hits 감소(히스테리시스)

            if (current_time - last_print_time) >= PRINT_INTERVAL:
                bar_len = min(consecutive_stop_hits, STOP_TRIGGER_COUNT)  # 진행바 길이
                progress_bar = "#" * bar_len + "-" * (STOP_TRIGGER_COUNT - bar_len)  # ASCII 바
                print(f"[제어] D:{current_diameter:.2f}cm | {stable_f:.0f}/{target_freq:.0f}Hz | [{progress_bar}]", end='\r')  # 콘솔 표시
                last_print_time = current_time                          # 출력 시간 갱신

            if consecutive_stop_hits >= STOP_TRIGGER_COUNT:             # 충분히 연속으로 맞으면
                print(f"\n[완료] 목표 도달! 최종 D: {current_diameter:.4f} cm")  # 완료 로그
                serial_write(b'0')                                      # (유지) UNO WiFi로 OFF 전송
                with lock:
                    is_filling = False                                  # 주입 종료
                    request_finish = True                               # 저장 요청
                return

    except Exception:
        return

