# [9. 오디오 스트림 보장]
# =========================================================
def ensure_audio_stream():                                            # 오디오 스트림 생성/시작
    global audio_stream
    if audio_stream is not None: return                               # 이미 있으면 종료
    audio_stream = sd.InputStream(device=INPUT_DEVICE, callback=audio_callback, channels=1, samplerate=SAMPLE_RATE, blocksize=CHUNK_SIZE)  # 스트림 생성
    audio_stream.start()                                              # 시작

