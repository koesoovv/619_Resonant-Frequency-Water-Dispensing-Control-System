# [10. TCP 수신 스레드]  # (시리얼 수신 대체)
# =========================================================
def serial_reader_loop(on_status):                                    # (유지) 함수명 유지
    global tcp
    while True:
        if tcp is None or tcp.s is None:
            time.sleep(0.2); continue
        try:
            msg = tcp.recv_line()                                     # 한 줄 수신(STATUS:ON/OFF 기대)
            if not msg:
                time.sleep(0.01); continue

            if "STATUS:ON" in msg or msg.strip() == "ON":
                start_filling_local()
                on_status("UNO WiFi ON 수신")
            elif "STATUS:OFF" in msg or msg.strip() == "OFF":
                stop_filling_local(save_result=True)
                on_status("UNO WiFi OFF 수신")
        except Exception:
            time.sleep(0.2)

