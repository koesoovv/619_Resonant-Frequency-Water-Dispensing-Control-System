# 수학 유틸리티
# ════════════════════════════════════════════════════════════════════
def loess_smooth(x, y, frac=LOESS_FRAC, degree=LOESS_DEGREE):
    n = len(x)

    if n < 4:
        return np.array(y, dtype=float)

    x = np.array(x, dtype=float)
    y = np.array(y, dtype=float)

    smoothed = np.zeros(n)
    h_width  = max(int(np.ceil(frac * n)), degree + 2)

    for i in range(n):
        dist  = np.abs(x - x[i])
        idx   = np.argsort(dist)[:h_width]
        max_d = dist[idx[-1]]

        if max_d < 1e-10:
            smoothed[i] = np.mean(y[idx])
            continue

        u = dist[idx] / max_d
        w = (1.0 - u**3)**3

        X = np.column_stack([x[idx]**p for p in range(degree + 1)])
        W = np.diag(w)

        try:
            XtW  = X.T @ W
            coef = np.linalg.lstsq(XtW @ X, XtW @ y[idx], rcond=None)[0]
            smoothed[i] = sum(coef[p] * x[i]**p for p in range(degree + 1))
        except Exception:
            smoothed[i] = y[i]

    return smoothed


def levinson_durbin(r, order):
    e = float(r[0])

    if e <= 0:
        return None

    a = np.zeros(order + 1, dtype=float)
    a[0] = 1.0

    for k in range(1, order + 1):
        acc = float(np.dot(a[1:k], r[k - 1:0:-1]))
        lam = -(r[k] + acc) / (e + 1e-12)

        if k > 1:
            a[1:k] = a[1:k] + lam * a[k - 1:0:-1]

        a[k] = lam
        e *= max(1.0 - lam * lam, 1e-12)

    return a


# ════════════════════════════════════════════════════════════════════
# 주파수 검출
# ════════════════════════════════════════════════════════════════════
def lpc_main_frequency(chunk, last_freq, f_min, f_max,
                       continuity_w=LPC_CONTINUITY_W,
                       rise_bias=LPC_RISE_BIAS):

    x_ds  = signal.decimate(chunk.astype(float), LPC_DS_FACTOR, ftype='fir')
    sr_ds = LPC_DS_RATE

    fl  = int(LPC_FRAME_MS / 1000 * sr_ds)
    hop = int(LPC_HOP_MS  / 1000 * sr_ds)

    frames = [x_ds[i:i + fl] for i in range(0, len(x_ds) - fl, hop)]

    if not frames:
        return 0.0

    cands = []

    for frame in frames:
        if float(np.mean(frame**2)) < LPC_MIN_ENERGY:
            continue

        frame = frame * np.hamming(len(frame))

        r = np.array([
            np.dot(frame[:len(frame) - k], frame[k:]) / len(frame)
            for k in range(LPC_ORDER + 1)
        ])

        if r[0] < 1e-12:
            continue

        a = levinson_durbin(r, LPC_ORDER)

        if a is None:
            continue

        A   = np.fft.rfft(a, n=LPC_NFFT)
        mag = 1.0 / (np.abs(A) + 1e-12)

        freqs = np.fft.rfftfreq(LPC_NFFT, d=1.0 / sr_ds)
        mask  = (freqs >= f_min) & (freqs <= min(f_max, sr_ds / 2 - 50))

        if not np.any(mask):
            continue

        vf = freqs[mask]
        vm = mag[mask]

        prom = vm.max() * LPC_PEAK_PROM
        peaks, _ = signal.find_peaks(vm, prominence=prom, distance=4)

        if len(peaks) == 0:
            peaks = np.array([np.argmax(vm)])

        pf = vf[peaks]
        pm = vm[peaks]

        clean = [
            i for i, f in enumerate(pf)
            if not any(abs(f - nf) < 25.0 for nf in noise_profile)
        ]

        if not clean:
            continue

        pf = pf[clean]
        pm = pm[clean]

        pm_n = pm / (pm.max() + 1e-12)

        if last_freq > 0:
            score = pm_n - (1.0 / continuity_w) * np.abs(pf - last_freq)

            if rise_bias > 0:
                score += rise_bias * (pf > last_freq)
        else:
            score = pm_n

        cands.append(float(pf[np.argmax(score)]))

    return float(np.median(cands)) if cands else 0.0


def fft_backup_frequency(chunk, last_freq, f_min, f_max,
                         continuity_w=800.0,
                         rise_bias=LPC_RISE_BIAS):

    windowed = chunk * np.hamming(len(chunk))
    fft_val  = np.abs(np.fft.rfft(windowed))
    freqs    = np.fft.rfftfreq(len(chunk), d=1.0 / SAMPLE_RATE)

    mask = (freqs >= f_min) & (freqs <= f_max)

    if not np.any(mask):
        return 0.0

    vf = freqs[mask]
    vm = fft_val[mask]

    peaks, _ = signal.find_peaks(vm, prominence=vm.max() * 0.15, distance=10)

    if len(peaks) == 0:
        return float(vf[np.argmax(vm)])

    pf = vf[peaks]
    pm = vm[peaks]

    clean = [
        i for i, f in enumerate(pf)
        if not any(abs(f - nf) < 25.0 for nf in noise_profile)
    ]

    if not clean:
        clean = list(range(len(pf)))

    pf = pf[clean]
    pm = pm[clean]

    pm_n = pm / (pm.max() + 1e-12)

    if last_freq > 0:
        score = pm_n - (1.0 / continuity_w) * np.abs(pf - last_freq)

        if rise_bias > 0:
            score += rise_bias * (pf > last_freq)
    else:
        score = pm_n

    return float(pf[np.argmax(score)])


def fft_explore_rising(chunk, current_f, f_max):
    filtered = signal.sosfilt(HP_SOS, chunk.astype(float))
    windowed = filtered * np.hamming(len(filtered))

    fft_val = np.abs(np.fft.rfft(windowed))
    freqs   = np.fft.rfftfreq(len(filtered), d=1.0 / SAMPLE_RATE)

    search_min = current_f * 1.02
    search_max = min(f_max, current_f * EXPLORE_SEARCH_MULT)

    mask = (freqs >= search_min) & (freqs <= search_max)

    if not np.any(mask):
        return 0.0

    vf = freqs[mask]
    vm = fft_val[mask]

    peaks, _ = signal.find_peaks(vm, prominence=vm.max() * 0.12, distance=10)

    if len(peaks) == 0:
        idx_max = np.argmax(vm)

        if vm[idx_max] < np.max(fft_val) * 0.08:
            return 0.0

        return float(vf[idx_max])

    pf = vf[peaks]
    pm = vm[peaks]

    clean = [
        i for i, f in enumerate(pf)
        if not any(abs(f - nf) < 25.0 for nf in noise_profile)
    ]

    if not clean:
        return 0.0

    pf = pf[clean]
    pm = pm[clean]

    return float(pf[np.argmax(pm)])


def _harmonic_correct(f: float, ref: float) -> float:
    if ref <= 0 or f <= 0:
        return f

    ratio = f / ref

    if 2.7 <= ratio <= 3.3:
        return f / 3.0

    if 1.8 <= ratio <= 2.2:
        return f / 2.0

    if 4.7 <= ratio <= 5.3:
        return f / 5.0

    if ratio > 2.5:
        return 0.0

    return f


def get_frequency(chunk, last_freq, f_min, f_max,
                  continuity_w=LPC_CONTINUITY_W,
                  rise_bias=LPC_RISE_BIAS):

    filtered = signal.sosfilt(HP_SOS, chunk.astype(float))

    lpc_f = lpc_main_frequency(
        filtered,
        last_freq,
        f_min,
        f_max,
        continuity_w=continuity_w,
        rise_bias=rise_bias
    )

    lpc_f = _harmonic_correct(lpc_f, last_freq)

    if lpc_f > 0:
        return float(lpc_f)

    fft_f = fft_backup_frequency(
        filtered,
        last_freq,
        f_min,
        f_max,
        continuity_w=continuity_w * 2.0,
        rise_bias=rise_bias
    )

    fft_f = _harmonic_correct(fft_f, last_freq)

    return float(fft_f)


