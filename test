#  회귀 워커 스레드
# ════════════════════════════════════════════════════════════════════
def _regression_worker():
    global current_diameter, target_freq, calibration_done
    global theory_slope, theory_intercept, theory_locked
    global init_air_len_cm, last_r2, diameter_candidates
    global _eff_target_air_cm, dynamic_Q
    global last_d_locked_cm, last_d_candidate_median, last_d_candidate_mad
    global last_init_air_by_initfreq_cm, last_init_air_by_regression_cm, last_init_air_locked_cm
    global last_model_valid, last_reject_reason, last_control_profile

    while True:
        _reg_event.wait(timeout=1.0)
        _reg_event.clear()

        with lock:
            if not is_filling:
                continue
            _filling_elapsed = time.time() - filling_start_time - NOISE_CALIBRATION_TIME
            times     = list(reg_time_buffer)
            inv_freqs = list(reg_inv_freq_buffer)
            _init_f   = float(initial_stable_freq)
            _cur_d    = float(current_diameter)
            _cand_cnt = len(diameter_candidates)
            _dyn_q    = float(dynamic_Q)
            _diam_full = (_cand_cnt >= DIAM_CAND_MAXLEN) or \
                         (_cand_cnt >= DIAM_CAND_MIN and _filling_elapsed > DIAM_CALC_END_TIME)

        if _diam_full:
            continue
        if len(times) <= REG_MIN_POINTS:
            continue

        s_a, s_b, r_sq = robust_slope_loess_lsm(times, inv_freqs)

        if s_a is not None:
            if _cur_d > 0:
                q_implied = abs(s_a) * np.pi * SOUND_SPEED * _cur_d**2 / 16
                print(f'\n[회귀] slope={s_a:.6f} | r²={r_sq:.4f}'
                      f' | 역산Q={q_implied:.1f}ml/s | dynQ={_dyn_q:.1f}ml/s')
            else:
                print(f'\n[회귀] slope={s_a:.6f} | r²={r_sq:.4f}')

        with lock:
            if s_a is not None and r_sq > THEORY_LOCK_R2 and not theory_locked:
                theory_slope     = s_a
                theory_intercept = s_b
                theory_locked    = True
                print(f'\n[★ 이론 곡선 잠금] slope={s_a:.6f} r²={r_sq:.3f}')

        if s_a is None or abs(s_a) <= 1e-9:
            continue

        if abs(s_a) < 0.000035:
            r2_threshold = 0.88
        elif abs(s_a) < 0.000055:
            r2_threshold = 0.92
        else:
            r2_threshold = 0.95

        if r_sq <= r2_threshold:
            with lock:
                last_r2 = r_sq
            continue

        # ── r² 통과 시 dynamic_Q EMA 갱신 ────────────────────────────
        if _cur_d > 0 and _cand_cnt >= DIAM_CAND_MIN:
            q_implied = abs(s_a) * np.pi * SOUND_SPEED * _cur_d**2 / 16
            if DYNAMIC_Q_MIN <= q_implied <= DYNAMIC_Q_MAX:
                new_dyn_q = _dyn_q * (1 - DYNAMIC_Q_EMA_ALPHA) + q_implied * DYNAMIC_Q_EMA_ALPHA
                new_dyn_q = max(DYNAMIC_Q_MIN, min(DYNAMIC_Q_MAX, new_dyn_q))
                with lock:
                    dynamic_Q = new_dyn_q
                _dyn_q = new_dyn_q
                print(f'\n[DYN-Q] Q={_dyn_q:.2f}ml/s (역산={q_implied:.1f})')

        effective_Q = DIAMETER_EST_FLOW_RATE
        temp_D = np.sqrt(16 * effective_Q / (np.pi * SOUND_SPEED * abs(s_a)))

        if abs(s_a) < 0.000030:
            auto_scale = 0.90
        elif abs(s_a) < 0.000045:
            auto_scale = 0.95
        else:
            auto_scale = 1.0

        temp_D *= auto_scale

        if not (2.0 < temp_D < 15.0):
            continue

        with lock:
            cand_list = list(diameter_candidates)

        # [FIX6] 후보가 MIN 개수 모이기 전엔 이상치 필터 미적용 (median 안정화)
        if len(cand_list) >= DIAM_CAND_MIN:
            cur_med = float(np.median(cand_list))
            outlier = abs(temp_D - cur_med) / cur_med > DIAM_OUTLIER_RATIO
        else:
            outlier = False
            cur_med = temp_D

        if outlier:
            print(f'\n[D이상치] temp_D={temp_D:.2f}cm '
                  f'(중앙값={cur_med:.2f}cm ±{DIAM_OUTLIER_RATIO*100:.0f}%, 무시)')
            continue

        with lock:
            last_r2 = r_sq
            diameter_candidates.append(temp_D)

            _new_cnt      = len(diameter_candidates)
            _elapsed_now  = time.time() - filling_start_time - NOISE_CALIBRATION_TIME
            diam_full_now = (_new_cnt >= DIAM_CAND_MAXLEN) or \
                            (_new_cnt >= DIAM_CAND_MIN and _elapsed_now > DIAM_CALC_END_TIME)

            cand_arr = np.array(list(diameter_candidates), dtype=float)
            med_D = float(np.median(cand_arr))
            mad_D = float(np.median(np.abs(cand_arr - med_D))) if len(cand_arr) > 0 else 0.0
            last_d_candidate_median = med_D
            last_d_candidate_mad    = mad_D
            if current_diameter == 0:
                current_diameter = med_D
            else:
                current_diameter = current_diameter * DIAM_EMA_KEEP + med_D * DIAM_EMA_NEW
            _cur_d = float(current_diameter)
            last_d_locked_cm = _cur_d

            if _new_cnt == 1:
                _cup_type  = '소형 컵 (D≤8.0cm)' if _cur_d <= DIAM_THRESHOLD else '대형 컵 (D>8.0cm)'
                _scale_val = _get_diam_ema_scale(_cur_d, 0.0)
                print(f'\n[용기 판별] {_cup_type} | D={_cur_d:.2f}cm | EMA scale={_scale_val:.2f}')

            if init_air_len_cm == 0.0 and _init_f > 0 and _cur_d > 0:
                h_offset = _get_init_air_offset(_init_f, _cur_d)
                h_init   = SOUND_SPEED / (4 * _init_f) - END_CORRECTION_K * _cur_d
                h_reg    = SOUND_SPEED * theory_intercept / 4.0 - END_CORRECTION_K * _cur_d \
                           if (theory_locked and theory_intercept > 0) else 0.0

                h_init_corr = h_init + h_offset
                h_reg_corr  = h_reg  + h_offset if h_reg > 0 else 0.0

                last_init_air_by_initfreq_cm   = h_init_corr
                last_init_air_by_regression_cm = h_reg_corr

                if h_reg_corr > 0 and abs(h_reg_corr - h_init_corr) <= INIT_AIR_BLEND_TOL_CM:
                    est = h_init_corr * (1.0 - INIT_AIR_REG_BLEND) + h_reg_corr * INIT_AIR_REG_BLEND
                else:
                    est = h_init_corr

                if 5.5 <= est <= 16.0:
                    init_air_len_cm         = est
                    last_init_air_locked_cm = est
                    last_model_valid        = True
                    last_reject_reason      = 'ok'
                    _eff_target_air_cm = max(0.5, est * (1.0 - TARGET_FILL_PCT / 100.0))
                    print(f'\n[★ 용기 높이 확정] {est:.2f}cm'
                          f' | offset:{h_offset:.2f}cm'
                          f' → 목표 공기층 {_eff_target_air_cm:.2f}cm ({TARGET_FILL_PCT:.0f}%)')
                else:
                    last_model_valid   = False
                    last_reject_reason = 'init_air_out_of_range'

            target_L_eff = _eff_target_air_cm + END_CORRECTION_K * _cur_d
            new_tf = SOUND_SPEED / (4 * target_L_eff)
            if target_freq == 0:
                target_freq = new_tf
            else:
                change_ratio = abs(new_tf - target_freq) / target_freq
                if change_ratio <= TARGET_MAX_CHANGE_RATIO:
                    target_freq = new_tf
            calibration_done = True

            if diam_full_now:
                print(f'\n[★ 지름 확정] D={_cur_d:.3f}cm | dynQ={dynamic_Q:.1f}ml/s'
                      f' | cand={_new_cnt} | t={_elapsed_now:.1f}s')


_reg_worker_thread = threading.Thread(target=_regression_worker, daemon=True)
_reg_worker_thread.start()


