#  수학 유틸리티
# ════════════════════════════════════════════════════════════════════
def loess_smooth(x, y, frac=LOESS_FRAC, degree=LOESS_DEGREE):
    n = len(x)
    if n < 4:
        return np.array(y, dtype=float)
    x = np.array(x, dtype=float)
    y = np.array(y, dtype=float)
    smoothed = np.zeros(n)
    h_width  = max(int(np.ceil(frac * n)), degree + 2)
    for i in range(n):
        dist  = np.abs(x - x[i])
        idx   = np.argsort(dist)[:h_width]
        max_d = dist[idx[-1]]
        if max_d < 1e-10:
            smoothed[i] = np.mean(y[idx])
            continue
        u = dist[idx] / max_d
        w = (1.0 - u**3)**3
        X = np.column_stack([x[idx]**p for p in range(degree + 1)])
        W = np.diag(w)
        try:
            XtW  = X.T @ W
            coef = np.linalg.lstsq(XtW @ X, XtW @ y[idx], rcond=None)[0]
            smoothed[i] = sum(coef[p] * x[i]**p for p in range(degree + 1))
        except Exception:
            smoothed[i] = y[i]
    return smoothed


def levinson_durbin(r, order):
    e = float(r[0])
    if e <= 0:
        return None
    a = np.zeros(order + 1, dtype=float)
    a[0] = 1.0
    for k in range(1, order + 1):
        acc = float(np.dot(a[1:k], r[k - 1:0:-1]))
        lam = -(r[k] + acc) / (e + 1e-12)
        if k > 1:
            a[1:k] = a[1:k] + lam * a[k - 1:0:-1]
        a[k]  = lam
        e    *= max(1.0 - lam * lam, 1e-12)
    return a


# ════════════════════════════════════════════════════════════════════
#  주파수 검출
# ════════════════════════════════════════════════════════════════════
def lpc_main_frequency(chunk, last_freq, f_min, f_max):
    x_ds  = signal.decimate(chunk.astype(float), LPC_DS_FACTOR, ftype='fir')
    sr_ds = LPC_DS_RATE
    fl    = int(LPC_FRAME_MS / 1000 * sr_ds)
    hop   = int(LPC_HOP_MS  / 1000 * sr_ds)
    frames = [x_ds[i:i + fl] for i in range(0, len(x_ds) - fl, hop)]
    if not frames:
        return 0.0
    cands = []
    for frame in frames:
        if float(np.mean(frame**2)) < LPC_MIN_ENERGY:
            continue
        frame = frame * np.hamming(len(frame))
        r = np.array([
            np.dot(frame[:len(frame) - k], frame[k:]) / len(frame)
            for k in range(LPC_ORDER + 1)
        ])
        if r[0] < 1e-12:
            continue
        a = levinson_durbin(r, LPC_ORDER)
        if a is None:
            continue
        A   = np.fft.rfft(a, n=LPC_NFFT)
        mag = 1.0 / (np.abs(A) + 1e-12)
        freqs = np.fft.rfftfreq(LPC_NFFT, d=1.0 / sr_ds)
        mask  = (freqs >= f_min) & (freqs <= min(f_max, sr_ds / 2 - 50))
        if not np.any(mask):
            continue
        vf, vm   = freqs[mask], mag[mask]
        prom     = vm.max() * LPC_PEAK_PROM
        peaks, _ = signal.find_peaks(vm, prominence=prom, distance=4)
        if len(peaks) == 0:
            peaks = np.array([np.argmax(vm)])
        pf, pm = vf[peaks], vm[peaks]
        clean  = [i for i, f in enumerate(pf)
                  if not any(abs(f - nf) < 25.0 for nf in noise_profile)]
        if not clean:
            continue
        pf, pm = pf[clean], pm[clean]
        pm_n   = pm / (pm.max() + 1e-12)
        if last_freq > 0:
            score = pm_n - (1.0 / LPC_CONTINUITY_W) * np.abs(pf - last_freq)
            if LPC_RISE_BIAS > 0:
                score += LPC_RISE_BIAS * (pf > last_freq)
        else:
            score = pm_n
        cands.append(float(pf[np.argmax(score)]))
    return float(np.median(cands)) if cands else 0.0


def fft_backup_frequency(chunk, last_freq, f_min, f_max):
    windowed = chunk * np.hamming(len(chunk))
    fft_val  = np.abs(np.fft.rfft(windowed))
    freqs    = np.fft.rfftfreq(len(chunk), d=1.0 / SAMPLE_RATE)
    mask     = (freqs >= f_min) & (freqs <= f_max)
    if not np.any(mask):
        return 0.0
    vf, vm   = freqs[mask], fft_val[mask]
    peaks, _ = signal.find_peaks(vm, prominence=vm.max() * 0.15, distance=10)
    if len(peaks) == 0:
        return float(vf[np.argmax(vm)])
    pf, pm = vf[peaks], vm[peaks]
    clean  = [i for i, f in enumerate(pf)
              if not any(abs(f - nf) < 25.0 for nf in noise_profile)]
    if not clean:
        clean = list(range(len(pf)))
    pf, pm = pf[clean], pm[clean]
    pm_n   = pm / (pm.max() + 1e-12)
    if last_freq > 0:
        score = pm_n - (1.0 / 800.0) * np.abs(pf - last_freq)
        if LPC_RISE_BIAS > 0:
            score += LPC_RISE_BIAS * (pf > last_freq)
    else:
        score = pm_n
    return float(pf[np.argmax(score)])


def _harmonic_correct(f: float, ref: float, allow_even: bool = ALLOW_EVEN_HARMONIC_CORRECTION) -> float:
    if ref <= 0 or f <= 0:
        return f
    ratio = f / ref
    if 2.7 <= ratio <= 3.3:
        return f / 3.0
    elif 4.7 <= ratio <= 5.3:
        return f / 5.0
    elif 1.85 <= ratio <= 2.15:
        return f / 2.0 if allow_even else 0.0
    elif ratio > REG_HARMONIC_UPPER:
        return 0.0
    return f


def get_frequency(chunk, last_freq, f_min, f_max, allow_even: bool = ALLOW_EVEN_HARMONIC_CORRECTION):
    filtered = signal.sosfilt(HP_SOS, chunk.astype(float))
    lpc_f = lpc_main_frequency(filtered, last_freq, f_min, f_max)
    lpc_f = _harmonic_correct(lpc_f, last_freq, allow_even=allow_even)
    if lpc_f > 0:
        return float(lpc_f)
    fft_f = fft_backup_frequency(filtered, last_freq, f_min, f_max)
    fft_f = _harmonic_correct(fft_f, last_freq, allow_even=allow_even)
    return float(fft_f)


# ════════════════════════════════════════════════════════════════════
#  [v5.25-WLSM] 시간 가중 회귀
# ════════════════════════════════════════════════════════════════════
def robust_slope_loess_lsm(times, inv_freqs):
    """LOESS 스무딩 후 시간 가중 최소자승 직선 회귀."""
    if len(times) < 8:
        return None, 0.0, 0.0
    x = np.array(times,     dtype=float)
    y = np.array(inv_freqs, dtype=float)
    y_smooth = loess_smooth(x, y, frac=LOESS_FRAC, degree=LOESS_DEGREE)
    try:
        # 1차 fit → 이상치 제거
        p   = np.polyfit(x, y_smooth, 1)
        res = np.abs(y_smooth - (p[0] * x + p[1]))
        mask = res <= np.percentile(res, 75)
        if mask.sum() < 6:
            return None, 0.0, 0.0

        xm = x[mask]
        ym = y_smooth[mask]

        # [v5.25-WLSM] 시간 가중치: 초반 데이터 우선
        t_start = xm[0]
        weights = np.exp(-WLSM_DECAY_RATE * (xm - t_start))

        # 가중 최소자승
        W   = np.diag(weights)
        X   = np.column_stack([xm, np.ones_like(xm)])
        XtW = X.T @ W
        try:
            coef = np.linalg.lstsq(XtW @ X, XtW @ ym, rcond=None)[0]
        except Exception:
            coef = np.polyfit(xm, ym, 1)
        slope, intercept = float(coef[0]), float(coef[1])

        if abs(slope) < MIN_SLOPE_CUTOFF:
            return None, 0.0, 0.0

        # R² (가중)
        y_pred = slope * xm + intercept
        ss_res = np.sum(weights * (ym - y_pred)**2)
        ss_tot = np.sum(weights * (ym - np.average(ym, weights=weights))**2)
        r2     = 1.0 - ss_res / (ss_tot + 1e-12)
        return slope, intercept, float(r2)
    except Exception:
        return None, 0.0, 0.0


def theory_freq(t: float) -> float:
    if not theory_locked:
        return 0.0
    denom = theory_slope * t + theory_intercept
    if denom <= 1e-6:
        return 0.0
    return 1.0 / denom


def _adaptive_r2_min(slope_abs: float) -> float:
    if slope_abs <= LSM_SLOPE_WEAK_THR:
        return LSM_R2_MIN_WEAK
    return LSM_R2_MIN


def _reg_entry_mult(filling_elapsed: float) -> float:
    if filling_elapsed < REG_ENTRY_RELAX_TIME:
        return REG_ENTRY_EARLY_MULT
    t_ratio = min(1.0, (filling_elapsed - REG_ENTRY_RELAX_TIME)
                       / (DIAM_CALC_END_TIME - REG_ENTRY_RELAX_TIME))
    return REG_ENTRY_EARLY_MULT + t_ratio * (REG_ENTRY_LATE_MULT - REG_ENTRY_EARLY_MULT)


