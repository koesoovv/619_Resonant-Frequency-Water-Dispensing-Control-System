def _smooth_control_freq(raw_f, last_stable, in_final, is_tracking):
    if raw_f <= 0:
        return last_stable

    if last_stable <= 0:
        return raw_f

    ratio = raw_f / (last_stable + 1e-12)

    if is_tracking:
        if ratio > SPIKE_RATIO_THRESHOLD:
            alpha = 0.12
        elif raw_f > last_stable:
            alpha = 0.42 if in_final else 0.22
        else:
            alpha = 0.30
    else:
        alpha = EMA_ALPHA_FINAL if in_final else EMA_ALPHA_NORMAL

    smoothed = last_stable * (1 - alpha) + raw_f * alpha

    if smoothed > last_stable:
        max_rise = RATE_LIMIT_FINAL_HZ if in_final else RATE_LIMIT_NORMAL_HZ
        if smoothed - last_stable > max_rise:
            smoothed = last_stable + max_rise

    max_drop = MAX_DROP_HZ_AFTER_LOCK if is_tracking else MAX_ALLOWED_DROP_HZ
    if last_stable - smoothed > max_drop:
        smoothed = last_stable - max_drop

    return float(smoothed)


def _update_initial_frequency(filling_elapsed, reg_f):
    global initial_stable_freq

    if initial_stable_freq > 0 or reg_f <= INIT_STABLE_MIN_HZ:
        return

    init_candidate_buf.append(reg_f)

    if len(init_candidate_buf) < INIT_CONFIRM_N:
        return

    vals = np.array(init_candidate_buf, dtype=float)
    spread = float(np.max(vals) - np.min(vals))

    if spread <= INIT_CONFIRM_SPREAD_HZ:
        initial_stable_freq = float(np.median(vals))
        print(f'\n[★ 초기 주파수 확정] init_f={initial_stable_freq:.0f}Hz | spread={spread:.1f}Hz | t={filling_elapsed:.1f}s')


def _make_reg_freq(raw_f, last_reg, in_final):
    if raw_f <= 0:
        return last_reg

    if last_reg <= 0:
        return raw_f

    ratio = raw_f / (last_reg + 1e-12)

    if ratio > 1.0 + REG_MAX_JUMP_RATIO:
        raw_f = last_reg * (1.0 + REG_MAX_JUMP_RATIO)
    elif ratio < 1.0 - REG_MAX_JUMP_RATIO:
        raw_f = last_reg * (1.0 - REG_MAX_JUMP_RATIO)

    alpha = REG_EMA_ALPHA_FINAL if in_final else REG_EMA_ALPHA_NORMAL
    return float(last_reg * (1 - alpha) + raw_f * alpha)


def _current_search_range(filling_elapsed, ref_freq, stable_f, target_f, loss_count):
    base_floor = FREQ_MIN_LIMIT
    base_ceil = FREQ_MAX_LIMIT

    if filling_elapsed < 3.5:
        base_ceil = EARLY_CEIL_HZ

    if ref_freq > 0:
        if loss_count > 0 and loss_count % RECOVERY_FULLSCAN_EVERY == 0:
            floor = FREQ_MIN_LIMIT
            ceil = FREQ_MAX_LIMIT
        elif tracking_mode:
            floor = max(FREQ_MIN_LIMIT, ref_freq * TRACKING_FLOOR_RATIO)
            ceil = min(FREQ_MAX_LIMIT, ref_freq + TRACKING_BAND_HZ)
        else:
            floor = max(FREQ_MIN_LIMIT, ref_freq * 0.55)
            ceil = min(FREQ_MAX_LIMIT, ref_freq * 1.85 + 180.0)
    else:
        floor = base_floor
        ceil = base_ceil

    if stable_f > 0 and not tracking_mode:
        floor = max(FREQ_MIN_LIMIT, min(floor, stable_f * 0.65))

    if target_f > 0:
        ceil = min(FREQ_MAX_LIMIT, max(ceil, target_f * 1.18))
        floor = min(floor, target_f * 0.80)

    floor = max(FREQ_MIN_LIMIT, floor)
    ceil = min(FREQ_MAX_LIMIT, max(ceil, floor + 120.0))

    return float(floor), float(ceil)


