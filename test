# ════════════════════════════════════════════════════════════════════
def _diam_lock_quality(times, inv_freqs, cand_list, r_sq):
    """지름 후보가 충분히 정확해 보일 때만 잠그기 위한 품질 검사."""
    if len(cand_list) < DIAM_CAND_MIN:
        return False, 'cand 부족'

    if len(times) < DIAM_LOCK_MIN_REG_POINTS:
        return False, f'reg 부족({len(times)}<{DIAM_LOCK_MIN_REG_POINTS})'

    if r_sq < DIAM_LOCK_R2_MIN:
        return False, f'r² 낮음({r_sq:.3f}<{DIAM_LOCK_R2_MIN})'

    x = np.array(times, dtype=float)
    y = np.array(inv_freqs, dtype=float)
    order = np.argsort(x)
    x = x[order]
    y = y[order]

    span = float(x[-1] - x[0]) if len(x) >= 2 else 0.0
    if span < DIAM_LOCK_MIN_SPAN_SEC:
        return False, f'회귀시간 짧음({span:.1f}s<{DIAM_LOCK_MIN_SPAN_SEC}s)'

    f_start = 1.0 / (y[0] + 1e-12)
    f_end   = 1.0 / (y[-1] + 1e-12)
    rise_ratio = (f_end - f_start) / (f_start + 1e-12)

    if rise_ratio < DIAM_LOCK_MIN_RISE_RATIO:
        return False, f'주파수상승 부족({rise_ratio*100:.1f}%<{DIAM_LOCK_MIN_RISE_RATIO*100:.0f}%)'

    recent = np.array(cand_list[-DIAM_LOCK_RECENT_N:], dtype=float)
    if len(recent) < DIAM_LOCK_RECENT_N:
        return False, f'최근D 부족({len(recent)}<{DIAM_LOCK_RECENT_N})'

    med = float(np.median(recent))
    std_ratio = float(np.std(recent) / (med + 1e-12))

    if std_ratio > DIAM_LOCK_STD_RATIO:
        return False, f'D흔들림 큼({std_ratio*100:.1f}%>{DIAM_LOCK_STD_RATIO*100:.1f}%)'

    return True, f'OK span={span:.1f}s rise={rise_ratio*100:.1f}% Dstd={std_ratio*100:.1f}%'


def _regression_worker():
    global current_diameter, target_freq, calibration_done
    global theory_slope, theory_intercept, theory_locked
    global init_air_len_cm, last_r2, diameter_candidates
    global diameter_ready, _diam_outlier_rejects

    while True:
        _reg_event.wait(timeout=1.0)
        _reg_event.clear()

        with lock:
            if not is_filling:
                continue

            times = list(reg_time_buffer)
            inv_freqs = list(reg_inv_freq_buffer)
            _init_f = float(initial_stable_freq)
            _cur_d = float(current_diameter)

        if len(times) <= REG_MIN_POINTS:
            continue

        s_a, s_b, r_sq = robust_slope_loess_lsm(times, inv_freqs)

        if s_a is not None:
            if _cur_d > 0:
                q_implied = abs(s_a) * np.pi * SOUND_SPEED * _cur_d**2 / 16
                print(f'\n[회귀] slope={s_a:.7f} | r²={r_sq:.4f} | 역산Q={q_implied:.1f}ml/s (설정Q={FLOW_RATE})')
            else:
                print(f'\n[회귀] slope={s_a:.7f} | r²={r_sq:.4f}')

        # 이론 곡선 잠금도 너무 빨리 걸리지 않도록 회귀 데이터 품질을 추가 확인한다.
        with lock:
            reg_len_for_lock = len(reg_time_buffer)
            reg_span_for_lock = (reg_time_buffer[-1] - reg_time_buffer[0]) if len(reg_time_buffer) >= 2 else 0.0

        if (
            s_a is not None
            and r_sq > THEORY_LOCK_R2
            and reg_len_for_lock >= DIAM_LOCK_MIN_REG_POINTS
            and reg_span_for_lock >= DIAM_LOCK_MIN_SPAN_SEC
            and not theory_locked
        ):
            with lock:
                theory_slope = s_a
                theory_intercept = s_b
                theory_locked = True
                print(f'\n[★ 이론 곡선 잠금] slope={s_a:.7f} r²={r_sq:.3f} span={reg_span_for_lock:.1f}s')

        if s_a is None or abs(s_a) <= 1e-9 or r_sq <= LSM_R2_MIN:
            with lock:
                if s_a is not None:
                    last_r2 = r_sq
            continue

        temp_D = np.sqrt(16 * FLOW_RATE / (np.pi * SOUND_SPEED * abs(s_a)))
        temp_D *= DIAMETER_SCALE

        if not (2.0 < temp_D < 15.0):
            print(f'\n[D범위제외] temp_D={temp_D:.2f}cm → 물리 안전범위 밖')
            continue

        with lock:
            cand_list = list(diameter_candidates)
            locked_now = bool(diameter_ready)

        # 잠금 전에는 잘못된 초기 후보가 median을 오염시킬 수 있으므로,
        # 이상치가 연속으로 나오면 후보 목록을 초기화해서 복구 가능하게 한다.
        if len(cand_list) >= 6:
            cur_med = float(np.median(cand_list))
            outlier = abs(temp_D - cur_med) / (cur_med + 1e-12) > DIAM_OUTLIER_RATIO
        else:
            outlier = False
            cur_med = temp_D

        if outlier:
            with lock:
                _diam_outlier_rejects += 1
                reject_n = int(_diam_outlier_rejects)
                locked_now = bool(diameter_ready)

                if not locked_now and reject_n >= DIAM_OUTLIER_RESET_N:
                    diameter_candidates.clear()
                    current_diameter = 0.0
                    _diam_outlier_rejects = 0
                    print(f'\n[D후보 리셋] 초기 후보가 틀렸을 가능성 → cand 초기화')

            print(f'\n[D이상치] temp_D={temp_D:.2f}cm (중앙값={cur_med:.2f}cm ±{DIAM_OUTLIER_RATIO*100:.0f}%, reject={reject_n})')
            continue

        with lock:
            _diam_outlier_rejects = 0
            last_r2 = r_sq
            diameter_candidates.append(temp_D)
            cand_list = list(diameter_candidates)
            _new_cnt = len(cand_list)

            med_D = float(np.median(cand_list))

            if current_diameter == 0:
                current_diameter = med_D
            elif diameter_ready:
                current_diameter = current_diameter * DIAM_EMA_KEEP_POST + med_D * DIAM_EMA_NEW_POST
            else:
                current_diameter = current_diameter * DIAM_EMA_KEEP + med_D * DIAM_EMA_NEW

            lock_ok, lock_reason = _diam_lock_quality(times, inv_freqs, cand_list, r_sq)

            if not diameter_ready:
                if lock_ok:
                    diameter_ready = True
                    current_diameter = med_D
                    print(f'\n[★ 지름 잠금 완료] D={med_D:.3f}cm | cand={_new_cnt} | {lock_reason}')
                elif _new_cnt >= DIAM_CAND_MIN:
                    print(f'\n[D잠금 보류] D_med={med_D:.3f}cm | cand={_new_cnt} | {lock_reason}')

            _cur_d = float(current_diameter)

            # 용기 높이와 목표 주파수는 지름이 잠긴 뒤에만 확정한다.
            # 잠기기 전 target을 만들면 잘못된 D가 제어 판단에 섞인다.
            if diameter_ready:
                if init_air_len_cm == 0.0 and _init_f > 0 and _cur_d > 0:
                    est = SOUND_SPEED / (4 * _init_f) - END_CORRECTION_K * _cur_d

                    if est > 0.5:
                        init_air_len_cm = est
                        print(f'\n[★ 용기 높이 확정] {est:.2f} cm')

                target_L_eff = TARGET_AIR_CM + END_CORRECTION_K * _cur_d
                new_tf = SOUND_SPEED / (4 * target_L_eff) + STOP_OFFSET_HZ

                if target_freq == 0:
                    target_freq = new_tf
                else:
                    change_ratio = abs(new_tf - target_freq) / (target_freq + 1e-12)

                    if change_ratio <= TARGET_MAX_CHANGE_RATIO:
                        target_freq = new_tf

                if not calibration_done:
                    calibration_done = True
                    print(f'\n[★ 캘리브레이션 완료] D={_cur_d:.3f}cm | target_f={target_freq:.0f}Hz')

        if _new_cnt % 5 == 0:
            print(f'\n[D갱신] D={_cur_d:.3f}cm | cand={_new_cnt} | r²={r_sq:.4f}')


_reg_worker_thread = threading.Thread(target=_regression_worker, daemon=True)
_reg_worker_thread.start()


