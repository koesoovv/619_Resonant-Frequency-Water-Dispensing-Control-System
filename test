# 오디오 스트림 관리
# ════════════════════════════════════════════════════════════════════
def ensure_audio_stream():
    global audio_stream
    if audio_stream is not None:
        return                                                       # 이미 있으면 종료
    audio_stream = sd.InputStream(
        device=INPUT_DEVICE,                                         # 입력 장치
        callback=audio_callback,                                     # 콜백 함수
        channels=1,                                                  # 모노 입력
        samplerate=SAMPLE_RATE,                                      # 샘플링 주파수
        blocksize=CHUNK_SIZE,                                        # 블록 크기
    )
    audio_stream.start()                                             # 스트림 시작
