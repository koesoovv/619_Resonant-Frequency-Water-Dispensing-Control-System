# ════════════════════════════════════════════════════════════════════
#  오디오 콜백 (v5.25)
# ════════════════════════════════════════════════════════════════════
def audio_callback(indata, frames, time_info, status):
    global is_filling, filling_start_time, calibration_done
    global target_freq, current_diameter, confirmed_diameter
    global freq_buffer, reg_time_buffer, reg_inv_freq_buffer
    global diameter_candidates, history_time, history_freq
    global last_tracked_freq, consecutive_loss_count, consecutive_stop_hits
    global request_finish, last_stable_f, last_current_air, initial_stable_freq
    global last_print_time, dynamic_min_limit, noise_profile
    global STOP_TRIGGER_COUNT, CONTROL_START_TIME, FREQ_MAX_LIMIT, EARLY_CEIL_HZ
    global max_freq_seen, tracking_mode, tracking_mode_hits
    global theory_slope, theory_intercept, theory_locked
    global _prev_buf_median, _freeze_count
    global last_r2, spike_blocked_count, mono_blocked_count
    global history_freq_snapshot
    global init_air_len_cm
    global init_confirmed, init_rise_count, last_diam_spread

    if not is_filling:
        return

    chunk = indata.flatten().astype(float)
    if np.max(np.abs(chunk)) < 0.01:
        return

    try:
        current_time = time.time()
        with lock:
            elapsed = current_time - filling_start_time

        # ── 1단계: 배경 소음 수집 ────────────────────────────────────
        if elapsed < NOISE_CALIBRATION_TIME:
            windowed = chunk * np.hamming(len(chunk))
            fft_val  = np.abs(np.fft.rfft(windowed))
            freqs    = np.fft.rfftfreq(len(chunk), d=1.0 / SAMPLE_RATE)
            mask     = (freqs >= 100) & (freqs <= 2000)
            if np.any(mask):
                vf, vm   = freqs[mask], fft_val[mask]
                peaks, _ = signal.find_peaks(vm, prominence=vm.max() * 0.2)
                with lock:
                    for p in peaks:
                        f_n = float(vf[p])
                        if not any(abs(f_n - nf) < 20 for nf in noise_profile):
                            noise_profile.append(f_n)
            return

        filling_elapsed = elapsed - NOISE_CALIBRATION_TIME

        if filling_elapsed < SPLASH_GUARD_TIME:
            return

        with lock:
            _last   = float(last_tracked_freq)
            _init   = float(initial_stable_freq)
            _last_s = float(last_stable_f)
            _init_confirmed = bool(init_confirmed)

        # ── 3단계: 탐색 범위 결정 ────────────────────────────────────
        if filling_elapsed < 3.5:
            current_ceil  = EARLY_CEIL_HZ
            current_floor = dynamic_min_limit
        elif tracking_mode:
            current_ceil  = min(FREQ_MAX_LIMIT, _last + TRACKING_BAND_HZ)
            current_floor = max(dynamic_min_limit, max_freq_seen * TRACKING_FLOOR_RATIO)
        else:
            base = _last if _last > 0 else (_last_s if _last_s > 0 else _init)
            current_ceil  = min(FREQ_MAX_LIMIT, base + 1500.0) if base > 0 else FREQ_MAX_LIMIT
            current_floor = dynamic_min_limit

        with lock:
            if not tracking_mode and _last > 400:
                new_floor = _last * 0.75
                if new_floor > dynamic_min_limit:
                    dynamic_min_limit = new_floor
            if _init_confirmed and _init > 0 and not tracking_mode:
                init_floor = _init * 0.95
                if init_floor > dynamic_min_limit:
                    dynamic_min_limit = init_floor
            _tf = float(target_freq)
            if _tf > 0 and dynamic_min_limit > _tf * 0.85:
                dynamic_min_limit = _tf * 0.85

        # ── 4단계: 주파수 검출 ───────────────────────────────────────
        detected_f = get_frequency(chunk, _last, current_floor, current_ceil, allow_even=False)

        if detected_f < current_floor or detected_f == 0:
            detected_f = 0.0
        if filling_elapsed < 3.5 and detected_f > EARLY_CEIL_HZ:
            detected_f = 0.0

        if detected_f == 0.0:
            consecutive_loss_count += 1
            if not tracking_mode:
                dynamic_min_limit = max(FREQ_MIN_LIMIT, dynamic_min_limit * 0.97)
            if consecutive_loss_count > 10:
                with lock:
                    if last_stable_f > 0:
                        last_tracked_freq = float(last_stable_f)
                    elif initial_stable_freq > 0:
                        last_tracked_freq = float(initial_stable_freq)
                    else:
                        last_tracked_freq *= 0.9
            return

        consecutive_loss_count = 0

        raw_f_for_reg = float(detected_f)

        # ── 5단계: EMA 스무딩 (제어용) ───────────────────────────────
        with lock:
            _cur_d_live = float(current_diameter)
            _cur_d_snap = float(confirmed_diameter)
            _calib_snap = bool(calibration_done)

        final_approach_mult  = _final_approach_mult()
        alpha_final          = _ema_alpha_final()
        final_tracking_alpha = _final_tracking_rise_alpha()
        final_buf_n          = _final_buf_size()

        if _calib_snap and _cur_d_snap > 0 and _last_s > 0:
            L_now    = SOUND_SPEED / (4 * _last_s) - END_CORRECTION_K * _cur_d_snap
            in_final = (L_now < TARGET_AIR_CM * final_approach_mult)
        else:
            in_final = False

        alpha_det = alpha_final if in_final else EMA_ALPHA_NORMAL

        if _last > 0:
            ratio = detected_f / _last

            if tracking_mode:
                if ratio < TRACKING_DROP_HARD_RATIO:
                    detected_f = _last * 0.85 + detected_f * 0.15
                elif ratio > 1.5:
                    detected_f = _last * (1 - TRACKING_EMA_BIGRISE_ALPHA) \
                               + detected_f * TRACKING_EMA_BIGRISE_ALPHA
                elif ratio > 1.4:
                    detected_f = _last * 0.95 + detected_f * 0.05
                elif detected_f > _last:
                    if in_final:
                        alpha = final_tracking_alpha
                    elif ratio > 1.3:
                        alpha = TRACKING_EMA_SPIKE_ALPHA
                    elif ratio > 1.15:
                        alpha = TRACKING_EMA_RISE2_ALPHA
                    else:
                        alpha = TRACKING_EMA_RISE1_ALPHA
                    detected_f = _last * (1 - alpha) + detected_f * alpha
                else:
                    detected_f = _last * (1 - TRACKING_EMA_FALL_ALPHA) \
                               + detected_f * TRACKING_EMA_FALL_ALPHA
            else:
                if ratio > SPIKE_RATIO_THRESHOLD:
                    detected_f = _last * 0.95 + detected_f * 0.05
                else:
                    detected_f = _last * (1 - alpha_det) + detected_f * alpha_det

        # ── 속도 제한 ─────────────────────────────────────────────
        if _last > 0 and detected_f > _last:
            if tracking_mode:
                max_rise = TRACKING_RISE_LIMIT_HZ
            else:
                max_rise = RATE_LIMIT_FINAL_HZ if in_final else RATE_LIMIT_NORMAL_HZ
            if detected_f - _last > max_rise:
                detected_f = _last + max_rise

        # ── 이론 곡선 가이드 ────────────────────────────────────────
        if theory_locked and detected_f > 0:
            f_theory = theory_freq(filling_elapsed)
            if f_theory > 0:
                deviation = abs(detected_f - f_theory) / f_theory
                if in_final:
                    g_alpha  = THEORY_GUIDE_ALPHA_FINAL
                    g_margin = THEORY_GUIDE_MARGIN_FINAL
                else:
                    g_alpha  = THEORY_GUIDE_ALPHA
                    g_margin = THEORY_GUIDE_MARGIN
                if deviation <= g_margin:
                    blended = detected_f * (1 - g_alpha) + f_theory * g_alpha
                    with lock:
                        _tf_cap = float(target_freq)
                    if _tf_cap > 0:
                        blended = min(blended, _tf_cap * 1.01)
                    detected_f = blended

        with lock:
            _tf_cap2   = float(target_freq)
            _calib_cap = bool(calibration_done)
        _cap_mult = 1.08 if _calib_cap else 1.15
        if _tf_cap2 > 0 and detected_f > _tf_cap2 * _cap_mult:
            detected_f = _last

        last_tracked_freq = detected_f

        # ── 6단계: freq_buffer → stable_f ────────────────────────────
        if in_final:
            buf_size = final_buf_n
        elif filling_elapsed < EARLY_NOISE_SEC:
            buf_size = EARLY_BUF_SIZE
        else:
            buf_size = 5

        freq_buffer.append(detected_f)
        while len(freq_buffer) > buf_size:
            freq_buffer.popleft()

        cur_median = float(np.median(list(freq_buffer)))
        if cur_median == _prev_buf_median:
            _freeze_count += 1
        else:
            _freeze_count = 0
        _prev_buf_median = cur_median
        if _freeze_count >= FREEZE_RESET_N:
            freq_buffer.clear()
            _freeze_count = 0

        if tracking_mode:
            recent_n = TRACKING_STABLE_BUF if not in_final else final_buf_n
            recent_vals = list(freq_buffer)[-recent_n:]
            stable_f = float(np.median(recent_vals)) if recent_vals else detected_f
        else:
            stable_f = float(np.median(list(freq_buffer))) if freq_buffer else detected_f

        if _init_confirmed and _init > 0 and stable_f < _init * 0.97:
            stable_f = _init * 0.97
        elif not _init_confirmed and filling_elapsed < EARLY_NOISE_SEC and _last_s > 0:
            if stable_f < _last_s * 0.80:
                stable_f = _last_s * 0.80

        with lock:
            history_time.append(filling_elapsed)
            history_freq.append(stable_f)

            if filling_elapsed > SPLASH_GUARD_TIME and stable_f > INIT_STABLE_MIN_HZ:
                if initial_stable_freq == 0:
                    initial_stable_freq = stable_f
                    init_confirmed  = False
                    init_rise_count = 0
                    print(f'\n[init 설정] {stable_f:.0f}Hz (미확정, t={filling_elapsed:.1f}s)')

                elif not init_confirmed:
                    if stable_f < initial_stable_freq * INIT_REANCHOR_RATIO:
                        old_init = initial_stable_freq
                        initial_stable_freq = stable_f
                        init_rise_count = 0
                        if dynamic_min_limit > stable_f * 0.75:
                            dynamic_min_limit = stable_f * 0.75
                        print(f'\n[init 하향] {old_init:.0f}→{stable_f:.0f}Hz (t={filling_elapsed:.1f}s)')
                    elif stable_f >= _last_s or abs(stable_f - _last_s) < 2.0:
                        init_rise_count += 1
                        if init_rise_count >= INIT_RISE_CONFIRM_N:
                            init_confirmed = True
                            print(f'\n[★ init 확정] {initial_stable_freq:.0f}Hz (t={filling_elapsed:.1f}s)')
                    else:
                        init_rise_count = max(0, init_rise_count - 1)

            last_stable_f = stable_f

        with lock:
            if filling_elapsed > EARLY_NOISE_SEC and _init_confirmed and stable_f > max_freq_seen:
                max_freq_seen = stable_f
            _max_f_seen = float(max_freq_seen)

        with lock:
            _tf_now = float(target_freq)
        if not tracking_mode and _tf_now > 0 and _max_f_seen > _tf_now * 0.75:
            hard_floor = min(_max_f_seen * 0.88, _tf_now * 0.98)
            if stable_f < hard_floor:
                stable_f = hard_floor

        # ── 7단계: tracking 모드 진입 판정 ──────────────────────────
        _tracking_thresh = max(TRACKING_ENTRY_HZ, _init * TRACKING_ENTRY_MULT) \
                           if _init > 0 else TRACKING_ENTRY_HZ

        if stable_f > _tracking_thresh:
            tracking_mode_hits += 1
        else:
            tracking_mode_hits = max(0, tracking_mode_hits - 1)

        if tracking_mode_hits >= TRACKING_MODE_THRESHOLD and not tracking_mode:
            with lock:
                tracking_mode = True
            print(f'\n[★ 트래킹 모드] {stable_f:.0f}Hz (thresh={_tracking_thresh:.0f}Hz) 시작')

        # ── 8단계: 회귀 버퍼 수집 → 워커 신호 ───────────────────────
        with lock:
            _init_f      = float(initial_stable_freq)
            _cur_d       = float(current_diameter)
            _conf_d      = float(confirmed_diameter)
            _cand_cnt    = len(diameter_candidates)
            _init_conf   = bool(init_confirmed)
            _diam_spread = float(last_diam_spread)

        # [v5.25] calibration_done 후에도 계속 수집 (재평가용)
        if filling_elapsed > CALC_START_TIME and _init_conf:

            if int(filling_elapsed) % 3 == 0 and abs(filling_elapsed - round(filling_elapsed)) < 0.15:
                with lock:
                    _reg_buf_len    = len(reg_time_buffer)
                    _spike_blocked  = int(spike_blocked_count)
                    _mono_blocked   = int(mono_blocked_count)
                    _reeval_cnt     = int(reeval_total_count)
                _entry_mult = _reg_entry_mult(filling_elapsed)
                print(
                    f'\n[D진단] t={filling_elapsed:.1f}s'
                    f' | init_f={_init_f:.0f}Hz'
                    f' | raw_f={raw_f_for_reg:.0f}Hz'
                    f' | entry_mult={_entry_mult:.4f}'
                    f' | reg_buf={_reg_buf_len}'
                    f' | spikes={_spike_blocked}'
                    f' | mono_blk={_mono_blocked}'
                    f' | D_live={_cur_d:.2f}cm'
                    f' | D_conf={_conf_d:.2f}cm'
                    f' | reeval={_reeval_cnt}'
                    f' | cand={_cand_cnt}/{DIAM_CAND_MAXLEN}'
                )

            _entry_mult_now = _reg_entry_mult(filling_elapsed)
            if (_init_f > 0
                    and raw_f_for_reg > _init_f * _entry_mult_now
                    and raw_f_for_reg < _init_f * REG_HARMONIC_UPPER):
                current_inv = 1.0 / raw_f_for_reg

                # [v5.25-MONO-REG] 단조 감소 필터: 1/f는 단조 감소해야 함
                with lock:
                    _buf_snapshot = list(reg_inv_freq_buffer)

                mono_ok = True
                if len(_buf_snapshot) >= 1:
                    last_inv = _buf_snapshot[-1]
                    # 1/f가 직전보다 증가(주파수 하락) → 오염 데이터
                    if current_inv > last_inv * (1.0 + REG_MONO_TOLERANCE):
                        mono_ok = False

                if not mono_ok:
                    with lock:
                        mono_blocked_count += 1
                else:
                    # spike gate
                    if len(_buf_snapshot) >= 5:
                        recent_median = float(np.median(_buf_snapshot[-5:]))
                        spike = abs(current_inv - recent_median) / (recent_median + 1e-12) > REG_SPIKE_GATE
                    else:
                        spike = False

                    if not spike:
                        with lock:
                            reg_time_buffer.append(filling_elapsed)
                            reg_inv_freq_buffer.append(current_inv)
                            _reg_len_now = len(reg_time_buffer)
                        if _reg_len_now > REG_MIN_POINTS:
                            _reg_event.set()
                    else:
                        with lock:
                            spike_blocked_count += 1

            else:
                if int(filling_elapsed) % 3 == 0 and abs(filling_elapsed - round(filling_elapsed)) < 0.15:
                    _entry_mult_diag = _reg_entry_mult(filling_elapsed)
                    if _init_f == 0:
                        print(f'\n[D진단] ❌ initial_stable_freq 아직 0')
                    elif raw_f_for_reg <= _init_f * _entry_mult_diag:
                        print(f'\n[D진단] ❌ raw_f({raw_f_for_reg:.0f}) ≤ init_f({_init_f:.0f})*{_entry_mult_diag:.4f}')
                    elif raw_f_for_reg >= _init_f * REG_HARMONIC_UPPER:
                        print(f'\n[D진단] ⚠ raw_f({raw_f_for_reg:.0f}) ≥ init_f({_init_f:.0f})*{REG_HARMONIC_UPPER} → 배음 의심, 제외')

        elif filling_elapsed > CALC_START_TIME and not _init_conf:
            if int(filling_elapsed) % 3 == 0 and abs(filling_elapsed - round(filling_elapsed)) < 0.15:
                print(
                    f'\n[D진단] ⏳ init 미확정 (init={_init_f:.0f}Hz, rise_count={init_rise_count}/{INIT_RISE_CONFIRM_N})'
                    f' | reg 수집 보류 중 (t={filling_elapsed:.1f}s)'
                )

        # ── 9단계: 정지 판단 ──────────────────────────────────────────
        with lock:
            _tf2      = float(target_freq)
            _cd       = bool(calibration_done)
            _cur_d2   = float(confirmed_diameter)
            _live_d2  = float(current_diameter)

        stop_need      = _stop_trigger_need()
        stop_adv_cm    = _stop_advance_cm()
        ctrl_start     = _control_start_time()
        fast_margin    = _fast_stop_margin_cm()
        fast_hit_bonus = _fast_stop_hit_bonus()

        if filling_elapsed > ctrl_start and _cd and stable_f > 0:
            current_air = SOUND_SPEED / (4 * stable_f) - END_CORRECTION_K * _cur_d2
            with lock:
                last_current_air = float(current_air)

            with lock:
                if current_air <= TARGET_AIR_CM + stop_adv_cm - fast_margin:
                    consecutive_stop_hits += fast_hit_bonus
                elif current_air <= TARGET_AIR_CM + stop_adv_cm:
                    consecutive_stop_hits += 1
                elif consecutive_stop_hits > 0:
                    consecutive_stop_hits = max(0, consecutive_stop_hits - 1)
                _hits = int(consecutive_stop_hits)

            if current_time - last_print_time >= PRINT_INTERVAL:
                mode_str = '[T]' if tracking_mode else '   '
                lock_str = '[R]' if theory_locked  else '   '
                fin_str  = '[F]' if in_final        else '   '
                init_str = '[I]' if _init_confirmed else '[?]'
                bar_len  = min(_hits, stop_need)
                bar      = '#' * bar_len + '-' * (stop_need - bar_len)
                print(
                    f'{mode_str}{lock_str}{fin_str}{init_str}[제어] D:{_cur_d2:.2f}cm '
                    f'| L:{current_air:.2f}/{TARGET_AIR_CM:.1f}cm '
                    f'| {stable_f:.0f}Hz [{bar}]',
                    end='\r'
                )
                last_print_time = current_time

            if _hits >= stop_need:
                print(f'\n[완료] 목표 도달! D:{_cur_d2:.4f}cm | L_est:{current_air:.2f}cm')
                solenoid_off_async()
                with lock:
                    history_freq_snapshot = list(history_freq)
                    is_filling     = False
                    request_finish = True
                return

    except Exception:
        return


