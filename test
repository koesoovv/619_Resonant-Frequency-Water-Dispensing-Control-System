# 수학 유틸리티
# ════════════════════════════════════════════════════════════════════
def loess_smooth(x, y, frac=LOESS_FRAC, degree=LOESS_DEGREE):
    n = len(x)                                                       # 데이터 개수
    if n < 4:
        return np.array(y, dtype=float)                              # 데이터가 적으면 원본 반환
    x = np.array(x, dtype=float)                                     # ndarray 변환
    y = np.array(y, dtype=float)                                     # ndarray 변환
    smoothed = np.zeros(n)                                           # 결과 배열
    h_width  = max(int(np.ceil(frac * n)), degree + 2)               # 이웃 개수
    for i in range(n):
        dist  = np.abs(x - x[i])                                     # 거리 계산
        idx   = np.argsort(dist)[:h_width]                           # 가까운 점 인덱스
        max_d = dist[idx[-1]]                                        # 최대 거리
        if max_d < 1e-10:
            smoothed[i] = np.mean(y[idx])                            # 거리가 거의 0이면 평균
            continue
        u = dist[idx] / max_d                                        # 정규화 거리
        w = (1.0 - u**3)**3                                          # tricube weight
        X = np.column_stack([x[idx]**p for p in range(degree + 1)])  # 설계행렬
        W = np.diag(w)                                               # 가중치 행렬
        try:
            XtW  = X.T @ W                                           # X^T W
            coef = np.linalg.lstsq(XtW @ X, XtW @ y[idx], rcond=None)[0]  # 국소회귀 계수
            smoothed[i] = sum(coef[p] * x[i]**p for p in range(degree + 1))  # 예측값
        except Exception:
            smoothed[i] = y[i]                                       # 실패 시 원본 유지
    return smoothed                                                  # 평활화 결과


def levinson_durbin(r, order):
    e = float(r[0])                                                  # 초기 오차
    if e <= 0:
        return None                                                  # 에너지 비정상이면 중단
    a = np.zeros(order + 1, dtype=float)                             # LPC 계수 배열
    a[0] = 1.0                                                       # a0 = 1
    for k in range(1, order + 1):
        acc = float(np.dot(a[1:k], r[k - 1:0:-1]))                   # 누산값
        lam = -(r[k] + acc) / (e + 1e-12)                            # reflection coeff
        if k > 1:
            a[1:k] = a[1:k] + lam * a[k - 1:0:-1]                    # 계수 갱신
        a[k]  = lam                                                  # 현재 계수
        e    *= max(1.0 - lam * lam, 1e-12)                          # 예측 오차 갱신
    return a                                                         # LPC 계수 반환


