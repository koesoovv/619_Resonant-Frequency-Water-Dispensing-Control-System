    ctk.CTkLabel(plot_frame, text="실시간 주파수 추적 그래프", text_color=C_TEXT,
                 font=("Malgun Gothic", 16, "bold")).pack(anchor="w", pady=(0, 6))

    fig = Figure(figsize=(6.2, 3.0), dpi=100)
    ax  = fig.add_subplot(111)
    ax.set_xlabel("t [s]");  ax.set_ylabel("f [Hz]");  ax.grid(True, alpha=0.3)
    fig.tight_layout(pad=3.0)
    line_freq,  = ax.plot([], [], linewidth=1.5)
    target_line = ax.axhline(y=0, linestyle="--", alpha=0.8)
    canvas = FigureCanvasTkAgg(fig, master=plot_frame)
    canvas.get_tk_widget().pack(fill="both", expand=True)

    def periodic_update():
        global request_finish
        with lock:
            d      = float(current_diameter)
            sf     = float(last_stable_f)
            tf     = float(target_freq)
            air    = float(last_current_air)
            hits   = int(consecutive_stop_hits)
            finish = bool(request_finish)
            if request_finish:
                request_finish = False
            t_list = list(history_time)
            f_list = list(history_freq)

        d_var.set(  f"지름(D) : {d:.2f} cm"       if d   > 0 else "지름(D) : - cm")
        f_var.set(  f"주파수(F) : {sf:.0f} Hz"     if sf  > 0 else "주파수(F) : - Hz")
        tf_var.set( f"목표(Target) : {tf:.0f} Hz"  if tf  > 0 else "목표(Target) : - Hz")
        air_var.set(f"공기층(Air) : {air:.2f} cm"  if air != 0 else "공기층(Air) : - cm")
        hit_var.set(f"확신(Hits) : {hits}/{STOP_TRIGGER_COUNT}")
        progress.set(hits / float(max(1, STOP_TRIGGER_COUNT)))

        if t_list:
            if len(t_list) > PLOT_MAX_POINTS:
                t_list, f_list = t_list[-PLOT_MAX_POINTS:], f_list[-PLOT_MAX_POINTS:]
            line_freq.set_data(t_list, f_list)
            t_max = max(t_list)
            ax.set_xlim(max(0, t_max - 30), max(5, t_max))
            fmn, fmx = min(f_list), max(f_list)
            pad = max(50, 0.1*(fmx-fmn))
            ax.set_ylim(max(0, fmn-pad), fmx+pad)
            if tf > 0:
                target_line.set_ydata([tf, tf]);  target_line.set_alpha(0.9)
            else:
                target_line.set_alpha(0.0)
        else:
            line_freq.set_data([], [])
            ax.set_xlim(0, 1);  ax.set_ylim(FREQ_MIN_LIMIT, FREQ_MAX_LIMIT)
        canvas.draw_idle()

        if finish:
            set_status("종료 → 결과 저장")
            with lock:
                init_f = float(initial_stable_freq)
            save_to_csv(d, init_f, tf, sf)

        app.after(100, periodic_update)

    footer = ctk.CTkFrame(card, fg_color=C_CARD, corner_radius=20)
    footer.grid(row=2, column=0, sticky="ew", padx=24, pady=(0, 18))
    ctk.CTkLabel(footer, textvariable=status_var, text_color=C_MUTED,
                 font=("Malgun Gothic", 14)).pack(anchor="w")

    sw_on.when_pressed  = gui_on
    sw_off.when_pressed = gui_off
    app.protocol("WM_DELETE_WINDOW", on_close)

    solenoid_off()
    # ★ 스트림은 ON 버튼 누를 때 시작 (원본: 여기서 무조건 시작)
    set_status("GPIO 제어 모드 준비 완료")
    periodic_update()
    app.mainloop()


if __name__ == "__main__":
    run_kiosk_gui()
