# 오디오 콜백
# ════════════════════════════════════════════════════════════════════
def audio_callback(indata, frames, time_info, status):
    global is_filling, filling_start_time, calibration_done
    global target_freq, current_diameter
    global freq_buffer, reg_freq_buffer, reg_time_buffer, reg_inv_freq_buffer
    global diameter_candidates, history_time, history_freq, history_raw_freq, history_reg_freq
    global last_tracked_freq, last_raw_freq, last_reg_freq
    global consecutive_loss_count, consecutive_stop_hits
    global request_finish, last_stable_f, last_current_air, initial_stable_freq
    global last_print_time, dynamic_min_limit, noise_profile
    global max_freq_seen, tracking_mode, tracking_mode_hits
    global theory_slope, theory_intercept, theory_locked
    global _prev_buf_median, _freeze_count
    global last_r2, spike_blocked_count, history_freq_snapshot
    global init_air_len_cm, diameter_ready, _diam_outlier_rejects
    global _stag_start_time, _stag_active, _explore_candidate, _explore_confirm

    if not is_filling:
        return

    chunk = indata.flatten().astype(float)

    if np.max(np.abs(chunk)) < 0.01:
        return

    try:
        current_time = time.time()

        with lock:
            elapsed = current_time - filling_start_time

        # ── 1단계: 배경 소음 수집 ────────────────────────────────────
        if elapsed < NOISE_CALIBRATION_TIME:
            windowed = chunk * np.hamming(len(chunk))
            fft_val = np.abs(np.fft.rfft(windowed))
            freqs = np.fft.rfftfreq(len(chunk), d=1.0 / SAMPLE_RATE)
            mask = (freqs >= 100) & (freqs <= 2200)

            if np.any(mask):
                vf = freqs[mask]
                vm = fft_val[mask]
                peaks, _ = signal.find_peaks(vm, prominence=vm.max() * 0.25)

                with lock:
                    for p in peaks:
                        f_n = float(vf[p])
                        if not any(abs(f_n - nf) < 20 for nf in noise_profile):
                            noise_profile.append(f_n)

            return

        filling_elapsed = elapsed - NOISE_CALIBRATION_TIME

        if filling_elapsed < SPLASH_GUARD_TIME:
            return

        filtered = _hp_filter_continuous(chunk)

        with lock:
            _last_raw = float(last_raw_freq)
            _last_reg = float(last_reg_freq)
            _last_s = float(last_stable_f)
            _init = float(initial_stable_freq)
            _tf = float(target_freq)
            _cur_d = float(current_diameter)
            _calib = bool(calibration_done)
            _loss = int(consecutive_loss_count)

        ref_freq = _last_reg if _last_reg > 0 else (_last_raw if _last_raw > 0 else _last_s)
        current_floor, current_ceil = _current_search_range(filling_elapsed, ref_freq, _last_s, _tf, _loss)

        allow_jump = _loss >= 2 or filling_elapsed < EARLY_NOISE_SEC
        raw_f, dbg = select_frequency_candidate(filtered, ref_freq, current_floor, current_ceil, allow_jump=allow_jump)

        # ── 정체 감지 + 탐색 FFT ─────────────────────────────────────
        explore_f = 0.0
        if ENABLE_STAG_EXPLORE and _last_reg > 0 and filling_elapsed > STAG_MIN_ELAPSED:
            with lock:
                h_freq_snap = list(history_reg_freq)
                h_time_snap = list(history_time)

            recent = []
            for i in range(len(h_time_snap) - 1, -1, -1):
                if filling_elapsed - h_time_snap[i] > STAG_WINDOW_SEC:
                    break
                if i < len(h_freq_snap):
                    recent.append(h_freq_snap[i])

            if len(recent) >= 5:
                f_range = max(recent) - min(recent)

                if f_range < STAG_BAND_HZ:
                    if not _stag_active:
                        _stag_active = True
                        _stag_start_time = filling_elapsed
                        _explore_confirm = 0
                        _explore_candidate = 0.0
                        print(f'\n[정체 감지] reg_range={f_range:.1f}Hz < {STAG_BAND_HZ}Hz')

                    explore_ceil = min(FREQ_MAX_LIMIT, _last_reg * EXPLORE_SEARCH_MULT)
                    explore_f = fft_explore_rising(filtered, _last_reg, explore_ceil)

                    if explore_f > _last_reg * EXPLORE_RISE_RATIO:
                        lpc_check, _ = select_frequency_candidate(
                            filtered,
                            explore_f,
                            max(FREQ_MIN_LIMIT, explore_f * 0.82),
                            min(FREQ_MAX_LIMIT, explore_f * 1.18),
                            allow_jump=True
                        )

                        lpc_fft_ok = abs(lpc_check - explore_f) / (explore_f + 1e-12) < 0.10 if lpc_check > 0 else False

                        if lpc_fft_ok:
                            if _explore_candidate > 0 and abs(explore_f - _explore_candidate) / (_explore_candidate + 1e-12) < 0.08:
                                _explore_confirm += 1
                            else:
                                _explore_candidate = explore_f
                                _explore_confirm = 1

                            if _explore_confirm >= EXPLORE_CONFIRM_N:
                                print(f'\n[정체 탈출] {_last_reg:.0f} → {explore_f:.0f}Hz | {EXPLORE_CONFIRM_N}회 확인')
                                raw_f = explore_f
                                _stag_active = False
                                _explore_candidate = 0.0
                                _explore_confirm = 0
                                freq_buffer.clear()
                                reg_freq_buffer.clear()
                    else:
                        _explore_confirm = max(0, _explore_confirm - 1)
                else:
                    if _stag_active:
                        print(f'\n[정체 해제] reg_range={f_range:.1f}Hz')
                    _stag_active = False
                    _explore_candidate = 0.0
                    _explore_confirm = 0

        # ── 검출 실패 처리 ───────────────────────────────────────────
        if raw_f <= 0:
            consecutive_loss_count += 1
            return

        consecutive_loss_count = 0

        # ── 회귀용 후보 품질 검사: LPC/FFT 동의 여부 ─────────────────
        # 이 값은 제어용 stable_f에는 직접 적용하지 않고, 지름 회귀 버퍼 투입 여부에만 사용한다.
        reg_src_ok, reg_src_reason = reg_source_agreement_ok(raw_f, dbg)

        # ── 회귀용 주파수 생성: stable_f와 분리 ─────────────────────
        if _calib and _cur_d > 0 and _last_s > 0:
            L_now = SOUND_SPEED / (4 * _last_s) - END_CORRECTION_K * _cur_d
            in_final = L_now < TARGET_AIR_CM * FINAL_APPROACH_MULT
        else:
            in_final = False

        reg_f = _make_reg_freq(raw_f, _last_reg, in_final)
        reg_freq_buffer.append(reg_f)

        if len(reg_freq_buffer) >= 3:
            reg_f = float(np.median(list(reg_freq_buffer)))

        # ── 제어/표시용 주파수 생성 ──────────────────────────────────
        stable_candidate = _smooth_control_freq(reg_f, _last_s, in_final, tracking_mode)
        freq_buffer.append(stable_candidate)

        if in_final:
            buf_size = BUF_SIZE_FINAL
        elif filling_elapsed < EARLY_NOISE_SEC:
            buf_size = EARLY_BUF_SIZE
        else:
            buf_size = 5

        while len(freq_buffer) > buf_size:
            freq_buffer.popleft()

        stable_f = float(np.median(list(freq_buffer))) if freq_buffer else stable_candidate

        cur_median = stable_f
        if abs(cur_median - _prev_buf_median) < 1e-6:
            _freeze_count += 1
        else:
            _freeze_count = 0
        _prev_buf_median = cur_median

        if _freeze_count >= FREEZE_RESET_N:
            freq_buffer.clear()
            _freeze_count = 0

        # ── 이론 곡선 가이드는 표시/제어용 stable_f에만 약하게 적용 ─────
        if theory_locked and stable_f > 0:
            f_theory = theory_freq(filling_elapsed)

            if f_theory > 0:
                deviation = abs(stable_f - f_theory) / f_theory
                g_alpha = THEORY_GUIDE_ALPHA_FINAL if in_final else THEORY_GUIDE_ALPHA
                g_margin = THEORY_GUIDE_MARGIN_FINAL if in_final else THEORY_GUIDE_MARGIN

                if deviation <= g_margin:
                    stable_f = stable_f * (1 - g_alpha) + f_theory * g_alpha

        # ── 상태 저장 ───────────────────────────────────────────────
        with lock:
            last_raw_freq = float(raw_f)
            last_reg_freq = float(reg_f)
            last_stable_f = float(stable_f)
            last_tracked_freq = float(stable_f)

            history_time.append(float(filling_elapsed))
            history_raw_freq.append(float(raw_f))
            history_reg_freq.append(float(reg_f))
            history_freq.append(float(stable_f))

            if stable_f > max_freq_seen:
                max_freq_seen = stable_f

        _update_initial_frequency(filling_elapsed, reg_f)

        # ── tracking 모드 진입 판정 ──────────────────────────────────
        with lock:
            _init_now = float(initial_stable_freq)
            _tf_now = float(target_freq)

        _tracking_thresh = max(TRACKING_ENTRY_HZ, _init_now * TRACKING_ENTRY_MULT) if _init_now > 0 else TRACKING_ENTRY_HZ

        if stable_f > _tracking_thresh:
            tracking_mode_hits += 1
        else:
            tracking_mode_hits = max(0, tracking_mode_hits - 2)

        if tracking_mode_hits >= TRACKING_MODE_THRESHOLD and not tracking_mode:
            with lock:
                tracking_mode = True
            print(f'\n[★ 트래킹 모드] {stable_f:.0f}Hz (thresh={_tracking_thresh:.0f}Hz) 시작')

        # ── 회귀 버퍼 수집 → 워커 신호 ───────────────────────────────
        with lock:
            _init_f = float(initial_stable_freq)
            _cur_d2 = float(current_diameter)
            _cand_cnt = len(diameter_candidates)
            _reg_buf_len = len(reg_time_buffer)
            _spike_blocked = int(spike_blocked_count)
            _d_ready_snap = bool(diameter_ready)

        if filling_elapsed > CALC_START_TIME:
            if int(filling_elapsed) % 3 == 0 and abs(filling_elapsed - round(filling_elapsed)) < 0.15:
                ready_str = '✓' if _d_ready_snap else '✗'
                stag_str = '정체' if _stag_active else '정상'
                print(
                    f'\n[D진단] t={filling_elapsed:.1f}s'
                    f' | floor={current_floor:.0f}'
                    f' | ceil={current_ceil:.0f}'
                    f' | lpc={dbg["lpc"]:.0f}'
                    f' | fft={dbg["fft"]:.0f}'
                    f' | raw={raw_f:.0f}'
                    f' | reg={reg_f:.0f}'
                    f' | stable={stable_f:.0f}'
                    f' | init={_init_f:.0f}'
                    f' | D={_cur_d2:.2f}cm'
                    f' | cand={_cand_cnt}/{DIAM_CAND_MAXLEN}'
                    f' | reg_buf={_reg_buf_len}'
                    f' | spikes={_spike_blocked}'
                    f' | src={dbg["src"]}'
                    f' | src_ok={"✓" if reg_src_ok else "✗"}'
                    f' | ready={ready_str}'
                    f' | {stag_str}'
                )

            accept_reg = False
            reason = ''

            if _init_f <= 0:
                reason = 'initial_stable_freq 아직 0'
            elif not reg_src_ok:
                reason = reg_src_reason
            elif reg_f <= _init_f * 1.015:
                reason = f'reg_f({reg_f:.0f}) ≤ init_f({_init_f:.0f})*1.015'
            elif reg_f >= min(FREQ_MAX_LIMIT, _init_f * 2.40):
                reason = f'reg_f({reg_f:.0f}) ≥ init_f({_init_f:.0f})*2.40 → 배음/오검출 의심'
            else:
                with lock:
                    inv_snapshot = list(reg_inv_freq_buffer)

                current_inv = 1.0 / reg_f

                if len(inv_snapshot) >= 5:
                    recent_median = float(np.median(inv_snapshot[-5:]))
                    spike = abs(current_inv - recent_median) / (recent_median + 1e-12) > REG_SPIKE_GATE
                else:
                    spike = False

                if spike:
                    reason = '1/f spike gate 차단'
                    with lock:
                        spike_blocked_count += 1
                else:
                    accept_reg = True

            if accept_reg:
                with lock:
                    reg_time_buffer.append(filling_elapsed)
                    reg_inv_freq_buffer.append(1.0 / reg_f)
                    _reg_len_now = len(reg_time_buffer)

                if _reg_len_now > REG_MIN_POINTS:
                    _reg_event.set()
            else:
                if int(filling_elapsed) % 3 == 0 and abs(filling_elapsed - round(filling_elapsed)) < 0.15:
                    print(f'\n[D진단] ❌ 회귀 제외: {reason}')

        # ── 정지 판단 ───────────────────────────────────────────────
        with lock:
            _tf2 = float(target_freq)
            _d_ready = bool(diameter_ready)
            _cur_d3 = float(current_diameter)
            _theory_lock = bool(theory_locked)
            _reg_buf_len2 = len(reg_time_buffer)

        control_ready = (
            _d_ready
            and _tf2 > 0
            and (_theory_lock or _reg_buf_len2 >= CONTROL_MIN_REG_POINTS)
            and filling_elapsed > CONTROL_START_TIME
        )

        if control_ready and stable_f > 0:
            current_air = SOUND_SPEED / (4 * stable_f) - END_CORRECTION_K * _cur_d3

            with lock:
                last_current_air = float(current_air)

            stop_candidate = current_air <= TARGET_AIR_CM + STOP_ADVANCE_CM

            # target cap은 검출값 변경이 아니라 정지 판단 보조로만 사용
            if _tf2 > 0 and stable_f > _tf2 * TARGET_HARD_CAP_RATIO:
                stop_candidate = True

            with lock:
                if stop_candidate:
                    consecutive_stop_hits += 1
                elif consecutive_stop_hits > 0:
                    consecutive_stop_hits = max(0, consecutive_stop_hits - 1)

                _hits = int(consecutive_stop_hits)

            if current_time - last_print_time >= PRINT_INTERVAL:
                mode_str = '[T]' if tracking_mode else '   '
                lock_str = '[R]' if _theory_lock else '   '
                fin_str = '[F]' if in_final else '   '
                bar_len = min(_hits, STOP_TRIGGER_COUNT)
                bar = '#' * bar_len + '-' * (STOP_TRIGGER_COUNT - bar_len)

                print(
                    f'{mode_str}{lock_str}{fin_str}[제어] D:{_cur_d3:.2f}cm '
                    f'| L:{current_air:.2f}/{TARGET_AIR_CM:.1f}cm '
                    f'| raw:{raw_f:.0f} reg:{reg_f:.0f} stable:{stable_f:.0f}Hz [{bar}]',
                    end='\r'
                )
                last_print_time = current_time

            if _hits >= STOP_TRIGGER_COUNT:
                print(f'\n[완료] 목표 도달! D:{_cur_d3:.4f}cm | L_est:{current_air:.2f}cm | f={stable_f:.0f}Hz')
                solenoid_off_async()

                with lock:
                    history_freq_snapshot = list(history_freq)
                    is_filling = False
                    request_finish = True

                return

        elif not control_ready and filling_elapsed > CONTROL_START_TIME:
            if int(filling_elapsed) % 3 == 0 and abs(filling_elapsed - round(filling_elapsed)) < 0.15:
                reasons = []

                if not _d_ready:
                    reasons.append(f'D미준비(cand={_cand_cnt})')

                if _tf2 <= 0:
                    reasons.append('target_freq=0')

                if not _theory_lock and _reg_buf_len2 < CONTROL_MIN_REG_POINTS:
                    reasons.append(f'이론미잠금&reg={_reg_buf_len2}<{CONTROL_MIN_REG_POINTS}')

                print(f'\n[제어대기] t={filling_elapsed:.1f}s | 미충족: {", ".join(reasons)}')

    except Exception as e:
        print(f'\n[오디오 콜백 오류] {e}')
        return


