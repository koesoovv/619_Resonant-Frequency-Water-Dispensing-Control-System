# 주파수 검출
# ════════════════════════════════════════════════════════════════════
def lpc_main_frequency(chunk, last_freq, f_min, f_max):
    x_ds  = signal.decimate(chunk.astype(float), LPC_DS_FACTOR, ftype='fir')  # 다운샘플
    sr_ds = LPC_DS_RATE                                             # 다운샘플 후 sr
    fl    = int(LPC_FRAME_MS / 1000 * sr_ds)                        # 프레임 길이
    hop   = int(LPC_HOP_MS  / 1000 * sr_ds)                         # 홉 길이
    frames = [x_ds[i:i + fl] for i in range(0, len(x_ds) - fl, hop)]  # 프레임 분할
    if not frames:
        return 0.0                                                  # 프레임 없으면 실패

    cands = []                                                      # 프레임별 후보 저장
    for frame in frames:
        if float(np.mean(frame**2)) < LPC_MIN_ENERGY:
            continue                                                # 너무 작은 에너지 제외
        frame = frame * np.hamming(len(frame))                      # 해밍 윈도우
        r = np.array([
            np.dot(frame[:len(frame) - k], frame[k:]) / len(frame)  # 자기상관
            for k in range(LPC_ORDER + 1)
        ])
        if r[0] < 1e-12:
            continue                                                # 자기상관 비정상 제외
        a = levinson_durbin(r, LPC_ORDER)                           # LPC 계산
        if a is None:
            continue                                                # 실패 시 제외

        A     = np.fft.rfft(a, n=LPC_NFFT)                          # LPC 응답 FFT
        mag   = 1.0 / (np.abs(A) + 1e-12)                           # 스펙트럼 envelope
        freqs = np.fft.rfftfreq(LPC_NFFT, d=1.0 / sr_ds)            # 주파수 축
        mask  = (freqs >= f_min) & (freqs <= min(f_max, sr_ds / 2 - 50))  # 유효 대역
        if not np.any(mask):
            continue                                                # 유효 대역 없음

        vf, vm = freqs[mask], mag[mask]                             # 잘린 주파수 / 크기
        prom   = vm.max() * LPC_PEAK_PROM                           # prominence 기준
        peaks, _ = signal.find_peaks(vm, prominence=prom, distance=4)  # 피크 탐색
        if len(peaks) == 0:
            peaks = np.array([np.argmax(vm)])                       # 피크 없으면 최대값 사용
        pf, pm = vf[peaks], vm[peaks]                               # 후보 피크들
        clean  = [i for i, f in enumerate(pf) if not any(abs(f - nf) < 25.0 for nf in noise_profile)]  # 노이즈 제거
        if not clean:
            continue                                                # 모두 노이즈면 제외
        pf, pm = pf[clean], pm[clean]                               # 깨끗한 피크만 사용
        pm_n   = pm / (pm.max() + 1e-12)                            # 크기 정규화

        if last_freq > 0:
            score  = pm_n - (1.0 / LPC_CONTINUITY_W) * np.abs(pf - last_freq)  # 연속성 점수
            score += LPC_RISE_BIAS * (pf > last_freq)               # 상승 후보 가산
        else:
            score = pm_n                                            # 초기에는 크기만 사용
        cands.append(float(pf[np.argmax(score)]))                   # 최고 점수 후보 저장

    return float(np.median(cands)) if cands else 0.0                # 후보 median 반환


def fft_backup_frequency(chunk, last_freq, f_min, f_max):
    windowed = chunk * np.hamming(len(chunk))                       # 해밍 윈도우
    fft_val  = np.abs(np.fft.rfft(windowed))                        # FFT magnitude
    freqs    = np.fft.rfftfreq(len(chunk), d=1.0 / SAMPLE_RATE)     # 주파수 축
    mask     = (freqs >= f_min) & (freqs <= f_max)                  # 유효 대역
    if not np.any(mask):
        return 0.0                                                  # 유효 대역 없음

    vf, vm   = freqs[mask], fft_val[mask]                           # 잘린 주파수 / 크기
    peaks, _ = signal.find_peaks(vm, prominence=vm.max() * 0.15, distance=10)  # 피크 탐색
    if len(peaks) == 0:
        return float(vf[np.argmax(vm)])                             # 피크 없으면 최대값 사용

    pf, pm = vf[peaks], vm[peaks]                                   # 후보 피크들
    clean  = [i for i, f in enumerate(pf) if not any(abs(f - nf) < 25.0 for nf in noise_profile)]  # 노이즈 제거
    if not clean:
        clean = list(range(len(pf)))                                # 모두 걸리면 전체 허용
    pf, pm = pf[clean], pm[clean]                                   # 정리
    pm_n   = pm / (pm.max() + 1e-12)                                # 정규화

    if last_freq > 0:
        score  = pm_n - (1.0 / 800.0) * np.abs(pf - last_freq)      # 연속성 반영
        score += 0.15 * (pf > last_freq)                            # 상승 가산점
    else:
        score = pm_n                                                # 초기에는 크기만
    return float(pf[np.argmax(score)])                              # 최고 점수 반환


def _harmonic_correct(f: float, ref: float) -> float:
    if ref <= 0 or f <= 0:
        return f                                                    # 기준 없으면 그대로 반환
    ratio = f / ref                                                 # 배수 비율
    if 2.7 <= ratio <= 3.3:
        return f / 3.0                                              # 3배음 보정
    elif 1.8 <= ratio <= 2.2:
        return f / 2.0                                              # 2배음 보정
    elif 4.7 <= ratio <= 5.3:
        return f / 5.0                                              # 5배음 보정
    elif ratio > 2.5:
        return 0.0                                                  # 너무 튀면 버림
    return f                                                        # 정상 주파수


def get_frequency(chunk, last_freq, f_min, f_max):
    filtered = signal.sosfilt(HP_SOS, chunk.astype(float))          # HPF 적용
    lpc_f = lpc_main_frequency(filtered, last_freq, f_min, f_max)   # LPC 후보
    lpc_f = _harmonic_correct(lpc_f, last_freq)                     # 배음 보정
    if lpc_f > 0:
        return float(lpc_f)                                         # LPC 성공 시 우선 사용
    fft_f = fft_backup_frequency(filtered, last_freq, f_min, f_max) # 백업 FFT 후보
    fft_f = _harmonic_correct(fft_f, last_freq)                     # 배음 보정
    return float(fft_f)                                             # FFT 반환


# ════════════════════════════════════════════════════════════════════
# 회귀 기반 D 추정
# ════════════════════════════════════════════════════════════════════
def robust_slope_loess_lsm(times, inv_freqs):
    if len(times) < 10:
        return None, 0.0, 0.0                                       # 데이터 부족
    x = np.array(times, dtype=float)                                # 시간 배열
    y = np.array(inv_freqs, dtype=float)                            # 1/f 배열
    y_smooth = loess_smooth(x, y, frac=LOESS_FRAC, degree=LOESS_DEGREE)  # 평활화

    try:
        p    = np.polyfit(x, y_smooth, 1)                           # 1차 선형 적합
        res  = np.abs(y_smooth - (p[0] * x + p[1]))                 # 잔차
        mask = res <= np.percentile(res, 75)                        # 큰 잔차 제거
        if mask.sum() < 8:
            return None, 0.0, 0.0                                   # 유효 점 부족

        slope, intercept = np.polyfit(x[mask], y_smooth[mask], 1)   # 재적합
        if abs(slope) < MIN_SLOPE_CUTOFF:
            return None, 0.0, 0.0                                   # 기울기 너무 작으면 무효

        y_pred = slope * x[mask] + intercept                        # 예측값
        ss_res = np.sum((y_smooth[mask] - y_pred)**2)               # 잔차 제곱합
        ss_tot = np.sum((y_smooth[mask] - y_smooth[mask].mean())**2)  # 전체 제곱합
        r2     = 1.0 - ss_res / (ss_tot + 1e-12)                    # 결정계수
        return float(slope), float(intercept), float(r2)            # 결과 반환
    except Exception:
        return None, 0.0, 0.0                                       # 실패 시 무효


def theory_freq(t: float) -> float:
    if not theory_locked:
        return 0.0                                                  # 잠금 안 됐으면 사용 안 함
    denom = theory_slope * t + theory_intercept                     # 1/f 식 분모
    if denom <= 1e-6:
        return 0.0                                                  # 비정상 방지
    return 1.0 / denom                                              # 이론 주파수


