# 오디오 스트림 관리
# ════════════════════════════════════════════════════════════════════
def ensure_audio_stream():
    global audio_stream

    if audio_stream is not None:
        return

    _reset_hp_filter_state()

    audio_stream = sd.InputStream(
        device=INPUT_DEVICE,
        callback=audio_callback,
        channels=1,
        samplerate=SAMPLE_RATE,
        blocksize=CHUNK_SIZE,
    )

    audio_stream.start()


def close_audio_stream():
    global audio_stream

    if audio_stream is None:
        return

    try:
        audio_stream.stop()
        audio_stream.close()
    except Exception as e:
        print(f'\n[오디오 스트림 종료 실패] {e}')

    audio_stream = None


