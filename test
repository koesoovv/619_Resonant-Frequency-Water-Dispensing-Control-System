def start_filling_local() -> None:
    global is_filling, filling_start_time, calibration_done
    global freq_buffer, reg_time_buffer, reg_inv_freq_buffer, diameter_candidates
    global history_time, history_freq
    global last_tracked_freq, consecutive_loss_count, consecutive_stop_hits
    global current_diameter, target_freq, initial_stable_freq
    global request_finish, last_stable_f, last_current_air, dynamic_min_limit, noise_profile
    global max_freq_seen, tracking_mode, tracking_mode_hits
    global theory_slope, theory_intercept, theory_locked
    global _prev_buf_median, _freeze_count

    with lock:
        is_filling           = True                                  # 급수 시작 플래그
        filling_start_time   = time.time()                           # 시작 시각 저장
        calibration_done     = False                                 # 보정 초기화
        freq_buffer          = []                                    # 주파수 버퍼 초기화
        reg_time_buffer.clear()                                      # 회귀 시간 버퍼 초기화
        reg_inv_freq_buffer.clear()                                  # 회귀 1/f 버퍼 초기화
        diameter_candidates.clear()                                  # 지름 후보 초기화
        history_time         = []                                    # 히스토리 초기화
        history_freq         = []                                    # 히스토리 초기화
        last_tracked_freq    = 0.0                                   # 마지막 추적 주파수 초기화
        consecutive_loss_count = 0                                   # loss 카운트 초기화
        consecutive_stop_hits  = 0                                   # stop hit 초기화
        initial_stable_freq  = 0.0                                   # 초기 안정 주파수 초기화
        current_diameter     = 0.0                                   # 지름 초기화
        target_freq          = 0.0                                   # 목표 주파수 초기화
        request_finish       = False                                 # 종료 요청 초기화
        last_stable_f        = 0.0                                   # 마지막 stable 초기화
        last_current_air     = 0.0                                   # 마지막 공기층 초기화
        dynamic_min_limit    = FREQ_MIN_LIMIT                        # 동적 하한 초기화
        noise_profile        = []                                    # 노이즈 프로파일 초기화
        max_freq_seen        = 0.0                                   # 최대 주파수 초기화
        tracking_mode        = False                                 # tracking off
        tracking_mode_hits   = 0                                     # tracking 카운터 초기화
        theory_slope         = 0.0                                   # 이론 slope 초기화
        theory_intercept     = 0.0                                   # 이론 intercept 초기화
        theory_locked        = False                                 # 이론 잠금 해제
        _prev_buf_median     = 0.0                                   # 이전 median 초기화
        _freeze_count        = 0                                     # freeze 카운트 초기화

    print('\n>>> [1단계] 배경 소음 측정...')                          # 상태 출력


def stop_filling_local(save_result: bool) -> None:
    global is_filling, request_finish
    with lock:
        is_filling = False                                           # 급수 중지
        if save_result:
            request_finish = True                                    # 저장 요청
    print('\n>>> 물 주입 종료.')                                      # 상태 출력


# ════════════════════════════════════════════════════════════════════
# 오디오 콜백
# ════════════════════════════════════════════════════════════════════
def audio_callback(indata, frames, time_info, status):
    global is_filling, filling_start_time, calibration_done
    global target_freq, current_diameter
    global freq_buffer, reg_time_buffer, reg_inv_freq_buffer, diameter_candidates
    global history_time, history_freq
    global last_tracked_freq, consecutive_loss_count, consecutive_stop_hits
    global request_finish, last_stable_f, last_current_air, initial_stable_freq
    global last_print_time, dynamic_min_limit, noise_profile
    global max_freq_seen, tracking_mode, tracking_mode_hits
    global theory_slope, theory_intercept, theory_locked
    global _prev_buf_median, _freeze_count

    if not is_filling:
        return                                                       # 급수 중이 아니면 종료

    chunk = indata.flatten().astype(float)                           # 1차원 float 배열화
    if np.max(np.abs(chunk)) < 0.01:
        return                                                       # 너무 작은 입력 무시

    try:
        current_time = time.time()                                   # 현재 시각
        with lock:
            elapsed = current_time - filling_start_time              # 전체 경과 시간

        # 1단계: 배경 소음 수집
        if elapsed < NOISE_CALIBRATION_TIME:
            windowed = chunk * np.hamming(len(chunk))                # 해밍 윈도우
            fft_val  = np.abs(np.fft.rfft(windowed))                 # FFT magnitude
            freqs    = np.fft.rfftfreq(len(chunk), d=1.0 / SAMPLE_RATE)  # 주파수 축
            mask     = (freqs >= 100) & (freqs <= 2000)              # 노이즈 수집 대역
            if np.any(mask):
                vf, vm   = freqs[mask], fft_val[mask]                # 잘린 축/크기
                peaks, _ = signal.find_peaks(vm, prominence=vm.max() * 0.2)  # 노이즈 피크
                with lock:
                    for p in peaks:
                        f_n = float(vf[p])                           # 피크 주파수
                        if not any(abs(f_n - nf) < 20 for nf in noise_profile):
                            noise_profile.append(f_n)                # 중복 없이 추가
            return                                                   # 소음 수집 단계 종료

        filling_elapsed = elapsed - NOISE_CALIBRATION_TIME           # 실제 급수 경과 시간

        if filling_elapsed < SPLASH_GUARD_TIME:
            return                                                   # 초기 물튀김 구간 무시

        with lock:
            _last   = float(last_tracked_freq)                       # 마지막 추적 주파수
            _init   = float(initial_stable_freq)                     # 초기 안정 주파수
            _last_s = float(last_stable_f)                           # 마지막 stable 주파수
            _tf_cur = float(target_freq)                             # 현재 target_freq
            _d_cur  = float(current_diameter)                        # 현재 지름
            _cd_cur = bool(calibration_done)                         # 보정 여부

        # 현재 공기층 추정값으로 near-target 여부 판단
        near_target = False                                          # 목표 근처 여부
        very_near_target = False                                     # 아주 가까운지 여부
        if _cd_cur and _d_cur > 0 and _last_s > 0:
            est_air_from_last = SOUND_SPEED / (4 * _last_s) - END_CORRECTION_K * _d_cur  # 마지막 stable 기반 공기층
            near_target = est_air_from_last <= (TARGET_AIR_CM + NEAR_TARGET_CM)           # 목표+1cm 이내
            very_near_target = est_air_from_last <= (TARGET_AIR_CM + VERY_NEAR_TARGET_CM) # 목표+0.45cm 이내

        # 3단계: 탐색 범위 결정
        if filling_elapsed < 3.0:
            current_ceil  = EARLY_CEIL_HZ                            # 초반 상한 제한
            current_floor = dynamic_min_limit                        # 초반 하한
        elif tracking_mode:
            current_ceil  = min(FREQ_MAX_LIMIT, _last + TRACKING_BAND_HZ)  # tracking 상한
            current_floor = max(dynamic_min_limit, max_freq_seen * TRACKING_FLOOR_RATIO)  # tracking 하한
        else:
            base = _last if _last > 0 else (_last_s if _last_s > 0 else _init)  # 기준 주파수
            current_ceil  = min(FREQ_MAX_LIMIT, base + 1500.0) if base > 0 else FREQ_MAX_LIMIT  # 상한 설정
            current_floor = dynamic_min_limit                        # 하한 설정

        if not tracking_mode and _last > 400:
            new_floor = _last * 0.72                                 # 후행 하한 완화 (0.75 → 0.72)
            if new_floor > dynamic_min_limit:
                dynamic_min_limit = new_floor                        # 동적 하한 갱신

        if _tf_cur > 0 and dynamic_min_limit > _tf_cur * 0.82:
            dynamic_min_limit = _tf_cur * 0.82                       # target 근처 하한 과상승 방지

        # 4단계: 주파수 검출
        detected_f = get_frequency(chunk, _last, current_floor, current_ceil)  # 검출 주파수

        if detected_f < current_floor or detected_f == 0:
            detected_f = 0.0                                         # 하한 미만이면 무효
        if filling_elapsed < 3.0 and detected_f > EARLY_CEIL_HZ:
            detected_f = 0.0                                         # 초반 과대값 제거

        if detected_f == 0.0:
            consecutive_loss_count += 1                              # loss 증가
            if not tracking_mode:
                dynamic_min_limit = max(FREQ_MIN_LIMIT, dynamic_min_limit * 0.96)  # 하한 완화
            if consecutive_loss_count > 8:
                with lock:
                    if last_stable_f > 0:
                        last_tracked_freq = float(last_stable_f)     # stable로 복구
                    elif initial_stable_freq > 0:
                        last_tracked_freq = float(initial_stable_freq)  # init으로 복구
                    else:
                        last_tracked_freq *= 0.9                     # 없으면 약하게 감쇠
            return                                                   # 이번 블록 종료

        consecutive_loss_count = 0                                   # loss 리셋

        # 5단계: EMA 스무딩
        if _cd_cur and _d_cur > 0 and detected_f > 0:
            L_now    = SOUND_SPEED / (4 * detected_f) - END_CORRECTION_K * _d_cur  # 현재 공기층
            in_final = (L_now < TARGET_AIR_CM * FINAL_APPROACH_MULT)  # final zone 여부
        else:
            in_final = False                                         # 보정 전이면 false

        alpha_det = EMA_ALPHA_FINAL if in_final else EMA_ALPHA_NORMAL  # 구간별 alpha

        if _last > 0:
            ratio = detected_f / _last                               # 이전 대비 비율

            # near-target 구간에서는 진짜 상승을 너무 늦게 막지 않도록 완화
            if very_near_target and detected_f > _last:
                if ratio > 1.30:
                    detected_f = _last * 0.82 + detected_f * 0.18    # 큰 급등도 일부 반영
                elif ratio > 1.15:
                    detected_f = _last * 0.55 + detected_f * 0.45    # 중간 상승 빠르게 반영
                else:
                    detected_f = _last * 0.30 + detected_f * 0.70    # 완만한 상승은 거의 바로 반영

            elif near_target and detected_f > _last:
                if ratio > 1.35:
                    detected_f = _last * 0.90 + detected_f * 0.10    # 지나친 급등은 완화
                elif ratio > FAST_RISE_ACCEPT_RATIO:
                    detected_f = _last * 0.45 + detected_f * 0.55    # 후반부 상승 빨리 반영
                else:
                    detected_f = _last * 0.25 + detected_f * 0.75    # 작은 상승은 더 민감하게 반영

            elif _tf_cur > 0 and _last > _tf_cur * 0.8:
                if ratio < 0.88:
                    detected_f = _last * 0.92 + detected_f * 0.08    # 후반부 급락 억제
                elif ratio > 1.45:
                    detected_f = _last * 0.88 + detected_f * 0.12    # 과도한 급등 완화
                elif tracking_mode:
                    if detected_f > _last:
                        if ratio > 1.3:
                            alpha = TRACKING_EMA_SPIKE_ALPHA          # 급등 alpha
                        elif ratio > 1.15:
                            alpha = TRACKING_EMA_RISE2_ALPHA          # 중간 상승 alpha
                        else:
                            alpha = TRACKING_EMA_RISE1_ALPHA          # 완만한 상승 alpha
                        detected_f = _last * (1 - alpha) + detected_f * alpha  # 상승 EMA
                    else:
                        detected_f = _last * (1 - TRACKING_EMA_FALL_ALPHA) + detected_f * TRACKING_EMA_FALL_ALPHA  # 하락 EMA
                else:
                    detected_f = _last * (1 - alpha_det) + detected_f * alpha_det  # 일반 EMA

            elif ratio < 0.65:
                detected_f = _last * 0.95 + detected_f * 0.05         # 과도한 급락 억제
            elif ratio > 1.45 and (_tf_cur <= 0 or detected_f > _tf_cur * 1.18):
                detected_f = _last * 0.90 + detected_f * 0.10         # 과도한 급등 억제
            else:
                detected_f = _last * (1 - alpha_det) + detected_f * alpha_det  # 일반 EMA

        # 이론 곡선 가이드
        if theory_locked and detected_f > 0 and not near_target:
            f_theory = theory_freq(filling_elapsed)                   # 이론 주파수
            if f_theory > 0:
                deviation = abs(detected_f - f_theory) / f_theory    # 오차율
                if deviation <= THEORY_GUIDE_MARGIN:
                    detected_f = detected_f * (1 - THEORY_GUIDE_ALPHA) + f_theory * THEORY_GUIDE_ALPHA  # 이론 당김

        last_tracked_freq = detected_f                                # 추적 주파수 저장

        # 6단계: freq_buffer → stable_f
        if very_near_target:
            buf_size = 1                                              # 아주 근처면 즉시 반영
        elif near_target or in_final:
            buf_size = BUF_SIZE_FINAL                                 # 목표 근처는 버퍼 최소화
        elif filling_elapsed < EARLY_NOISE_SEC:
            buf_size = EARLY_BUF_SIZE                                 # 초기 보호 버퍼
        else:
            buf_size = BUF_SIZE_NEAR                                  # 일반 구간 버퍼

        freq_buffer.append(detected_f)                                # 버퍼 추가
        if len(freq_buffer) > buf_size:
            freq_buffer.pop(0)                                        # 길이 유지

        cur_median = float(np.median(freq_buffer))                    # 현재 median
        if cur_median == _prev_buf_median:
            _freeze_count += 1                                        # 고착 증가
        else:
            _freeze_count = 0                                         # 변화 있으면 초기화
        _prev_buf_median = cur_median                                 # 저장
        if _freeze_count >= FREEZE_RESET_N:
            freq_buffer.clear()                                       # 고착 시 버퍼 리셋
            _freeze_count = 0                                         # 카운트 초기화

        if buf_size == 1 or tracking_mode:
            stable_f = detected_f                                     # 즉시성 우선
        else:
            stable_f = float(np.median(freq_buffer)) if freq_buffer else detected_f  # median 안정화

        if filling_elapsed < EARLY_NOISE_SEC and _last_s > 0 and not near_target:
            if stable_f < _last_s * MONO_DROP_RATIO:
                stable_f = _last_s                                    # 초기 역주행 방지

        with lock:
            history_time.append(filling_elapsed)                      # 히스토리 시간 저장
            history_freq.append(stable_f)                             # 히스토리 주파수 저장
            last_stable_f = stable_f                                  # 마지막 stable 저장
            if filling_elapsed > SPLASH_GUARD_TIME and initial_stable_freq == 0 and stable_f > INIT_STABLE_MIN_HZ:
                initial_stable_freq = stable_f                        # 초기 안정 주파수 고정

        if stable_f > max_freq_seen:
            max_freq_seen = stable_f                                  # 최대 주파수 갱신

        if not tracking_mode and _tf_cur > 0 and max_freq_seen > _tf_cur * 0.75 and not near_target:
            hard_floor = max_freq_seen * 0.86                         # 바닥 약간 완화 (0.88 → 0.86)
            if stable_f < hard_floor:
                stable_f = hard_floor                                 # 비정상 급락 방지

        # 7단계: tracking 모드 진입 판정
        if stable_f > TRACKING_ENTRY_HZ:
            tracking_mode_hits += 1                                   # 조건 충족 시 증가
        else:
            tracking_mode_hits = max(0, tracking_mode_hits - 2)       # 아니면 감소
        if tracking_mode_hits >= TRACKING_MODE_THRESHOLD and not tracking_mode:
            tracking_mode = True                                      # tracking 진입
            print(f'\n[★ 트래킹 모드] {stable_f:.0f}Hz → 창({TRACKING_BAND_HZ}Hz) 시작')

        # 8단계: D 추정
        with lock:
            _init_f = float(initial_stable_freq)                      # 초기 주파수 스냅샷
            _cur_d  = float(current_diameter)                         # 지름 스냅샷

        if filling_elapsed > CALC_START_TIME and not tracking_mode:
            if _init_f > 0 and stable_f > _init_f * 1.02:
                current_inv = 1.0 / stable_f                          # 현재 1/f
                if len(reg_inv_freq_buffer) >= 5:
                    recent_median = float(np.median(list(reg_inv_freq_buffer)[-5:]))  # 최근 median
                    spike = abs(current_inv - recent_median) / (recent_median + 1e-12) > 0.3  # 스파이크 여부
                else:
                    spike = False                                     # 데이터 부족 시 false

                if not spike:
                    reg_time_buffer.append(filling_elapsed)           # 회귀 시간 추가
                    reg_inv_freq_buffer.append(current_inv)           # 회귀 1/f 추가

                if len(reg_time_buffer) > REG_MIN_POINTS:
                    s_a, s_b, r_sq = robust_slope_loess_lsm(list(reg_time_buffer), list(reg_inv_freq_buffer))  # 회귀
                    if s_a is not None and abs(s_a) > 1e-9 and r_sq > LSM_R2_MIN:
                        temp_D = np.sqrt(16 * FLOW_RATE / (np.pi * SOUND_SPEED * abs(s_a)))  # 지름 계산
                        temp_D *= DIAMETER_SCALE                      # 스케일 보정
                        if 2.0 < temp_D < 10.0:
                            diameter_candidates.append(temp_D)        # 후보 저장
                            if len(diameter_candidates) >= DIAM_CAND_MIN:
                                med_D = float(np.median(list(diameter_candidates)[-DIAM_CAND_MIN:]))  # 최근 median
                            else:
                                med_D = temp_D                        # 후보 적으면 단일값 사용

                            with lock:
                                if current_diameter == 0:
                                    current_diameter = med_D          # 첫 지름 확정
                                else:
                                    current_diameter = current_diameter * DIAM_EMA_KEEP + med_D * DIAM_EMA_NEW  # EMA 갱신
                                _cur_d = float(current_diameter)      # 스냅샷 갱신

                            target_L_eff = TARGET_AIR_CM + END_CORRECTION_K * _cur_d  # 유효 공기층
                            new_tf       = SOUND_SPEED / (4 * target_L_eff)            # 새 목표 주파수
                            with lock:
                                if target_freq == 0:
                                    target_freq = new_tf              # 첫 target 설정
                                else:
                                    change_ratio = abs(new_tf - target_freq) / target_freq  # 변화율
                                    if change_ratio <= TARGET_MAX_CHANGE_RATIO:
                                        target_freq = new_tf          # 급변 아니면 갱신
                                calibration_done = True               # 보정 완료

                        if r_sq > THEORY_LOCK_R2 and not theory_locked and s_a is not None:
                            theory_slope     = s_a                    # 이론 slope 고정
                            theory_intercept = s_b                    # 이론 intercept 고정
                            theory_locked    = True                   # 잠금
                            print(f'\n[★ 이론 곡선 잠금] slope={s_a:.6f} r²={r_sq:.3f}')

        # 9단계: 정지 판단
        with lock:
            _cd2    = bool(calibration_done)                          # 보정 여부
            _cur_d2 = float(current_diameter)                         # 지름 스냅샷

        if filling_elapsed > CONTROL_START_TIME and _cd2 and stable_f > 0:
            current_air = SOUND_SPEED / (4 * stable_f) - END_CORRECTION_K * _cur_d2  # 현재 공기층
            with lock:
                last_current_air = float(current_air)                 # 저장

            # 목표 근처일수록 hit 요구 개수 축소
            stop_trigger_count = STOP_TRIGGER_COUNT_NEAR if current_air <= (TARGET_AIR_CM + VERY_NEAR_TARGET_CM) else STOP_TRIGGER_COUNT_BASE  # 가변 hit 수

            # 목표 아래는 즉시 누적, 목표 바로 위도 상승 추세면 선제적으로 누적
            if current_air <= TARGET_AIR_CM:
                consecutive_stop_hits += 1                            # 목표 도달
            elif current_air <= (TARGET_AIR_CM + VERY_NEAR_TARGET_CM):
                if len(history_freq) >= 2 and history_freq[-1] >= history_freq[-2]:
                    consecutive_stop_hits += 1                        # 아주 근처 + 상승 추세
                elif consecutive_stop_hits > 0:
                    consecutive_stop_hits -= 1                        # 아니면 감쇠
            elif consecutive_stop_hits > 0:
                consecutive_stop_hits -= 1                            # 멀어지면 감쇠

            if current_time - last_print_time >= PRINT_INTERVAL:
                mode_str = '[T]' if tracking_mode else '   '          # tracking 표시
                lock_str = '[R]' if theory_locked else '   '          # theory 표시
                bar_len  = min(consecutive_stop_hits, stop_trigger_count)  # 바 길이
                bar      = '#' * bar_len + '-' * (stop_trigger_count - bar_len)  # 진행 바
                print(
                    f'{mode_str}{lock_str}[제어] D:{_cur_d2:.2f}cm | L:{current_air:.2f}/{TARGET_AIR_CM:.1f}cm | {stable_f:.0f}Hz [{bar}]',
                    end='\r'
                )
                last_print_time = current_time                        # 출력 시간 갱신

            if consecutive_stop_hits >= stop_trigger_count:
                print(f'\n[완료] 목표 도달! D:{_cur_d2:.4f}cm | L_est:{current_air:.2f}cm')  # 완료 출력
                solenoid_off_async()                                  # 밸브 OFF
                with lock:
                    is_filling     = False                            # 급수 종료
                    request_finish = True                             # 종료 플래그
                return                                                # 콜백 종료

    except Exception:
        return                                                       # 예외는 조용히 무시


