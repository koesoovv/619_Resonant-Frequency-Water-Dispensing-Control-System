# 수학 유틸리티
# ════════════════════════════════════════════════════════════════════
def loess_smooth(x, y, frac=LOESS_FRAC, degree=LOESS_DEGREE):
    n = len(x)

    if n < 4:
        return np.array(y, dtype=float)

    x = np.array(x, dtype=float)
    y = np.array(y, dtype=float)
    smoothed = np.zeros(n)
    h_width = max(int(np.ceil(frac * n)), degree + 2)

    for i in range(n):
        dist = np.abs(x - x[i])
        idx = np.argsort(dist)[:h_width]
        max_d = dist[idx[-1]]

        if max_d < 1e-10:
            smoothed[i] = np.mean(y[idx])
            continue

        u = dist[idx] / max_d
        w = (1.0 - u**3)**3
        X = np.column_stack([x[idx]**p for p in range(degree + 1)])
        W = np.diag(w)

        try:
            XtW = X.T @ W
            coef = np.linalg.lstsq(XtW @ X, XtW @ y[idx], rcond=None)[0]
            smoothed[i] = sum(coef[p] * x[i]**p for p in range(degree + 1))
        except Exception:
            smoothed[i] = y[i]

    return smoothed


def levinson_durbin(r, order):
    e = float(r[0])

    if e <= 0:
        return None

    a = np.zeros(order + 1, dtype=float)
    a[0] = 1.0

    for k in range(1, order + 1):
        acc = float(np.dot(a[1:k], r[k - 1:0:-1]))
        lam = -(r[k] + acc) / (e + 1e-12)

        if k > 1:
            a[1:k] = a[1:k] + lam * a[k - 1:0:-1]

        a[k] = lam
        e *= max(1.0 - lam * lam, 1e-12)

    return a


def _reset_hp_filter_state():
    global _hp_zi
    _hp_zi = signal.sosfilt_zi(HP_SOS) * 0.0


def _hp_filter_continuous(chunk):
    global _hp_zi

    if _hp_zi is None:
        _reset_hp_filter_state()

    y, _hp_zi = signal.sosfilt(HP_SOS, chunk.astype(float), zi=_hp_zi)
    return y


def _is_noise_freq(f):
    return any(abs(f - nf) < 25.0 for nf in noise_profile)


def _unique_candidates(cands, merge_hz=18.0):
    if not cands:
        return []

    cands = sorted(cands, key=lambda c: c['score'], reverse=True)
    merged = []

    for cand in cands:
        f = cand['f']
        if f <= 0:
            continue

        matched = None
        for m in merged:
            if abs(m['f'] - f) <= merge_hz:
                matched = m
                break

        if matched is None:
            merged.append(dict(cand))
        else:
            total_w = matched['score'] + cand['score'] + 1e-12
            matched['f'] = (matched['f'] * matched['score'] + f * cand['score']) / total_w
            matched['score'] = max(matched['score'], cand['score']) + 0.08
            matched['src'] = matched['src'] + '+' + cand['src']

    return sorted(merged, key=lambda c: c['score'], reverse=True)


# ════════════════════════════════════════════════════════════════════
# 주파수 후보 추출
# ════════════════════════════════════════════════════════════════════
def lpc_frequency_candidates(filtered_chunk, f_min, f_max):
    x_ds = signal.decimate(filtered_chunk.astype(float), LPC_DS_FACTOR, ftype='fir')
    sr_ds = LPC_DS_RATE

    fl = int(LPC_FRAME_MS / 1000 * sr_ds)
    hop = int(LPC_HOP_MS / 1000 * sr_ds)

    if len(x_ds) < fl:
        return []

    all_cands = []

    for start in range(0, len(x_ds) - fl, hop):
        frame = x_ds[start:start + fl]

        if float(np.mean(frame**2)) < LPC_MIN_ENERGY:
            continue

        frame = frame * np.hamming(len(frame))
        r = np.array([
            np.dot(frame[:len(frame) - k], frame[k:]) / len(frame)
            for k in range(LPC_ORDER + 1)
        ])

        if r[0] < 1e-12:
            continue

        a = levinson_durbin(r, LPC_ORDER)

        if a is None:
            continue

        A = np.fft.rfft(a, n=LPC_NFFT)
        mag = 1.0 / (np.abs(A) + 1e-12)
        freqs = np.fft.rfftfreq(LPC_NFFT, d=1.0 / sr_ds)
        mask = (freqs >= f_min) & (freqs <= min(f_max, sr_ds / 2 - 50))

        if not np.any(mask):
            continue

        vf = freqs[mask]
        vm = mag[mask]
        prom = vm.max() * LPC_PEAK_PROM
        peaks, _ = signal.find_peaks(vm, prominence=prom, distance=4)

        if len(peaks) == 0:
            peaks = np.array([int(np.argmax(vm))])

        peak_items = []
        for p in peaks:
            f = float(vf[p])
            if _is_noise_freq(f):
                continue
            peak_items.append((f, float(vm[p])))

        if not peak_items:
            continue

        peak_items = sorted(peak_items, key=lambda x: x[1], reverse=True)[:LPC_MAX_PEAKS]
        max_amp = max(a for _, a in peak_items) + 1e-12

        for f, amp in peak_items:
            all_cands.append({
                'f': f,
                'amp': amp / max_amp,
                'src': 'LPC',
                'score': amp / max_amp,
                'harm': 1,
            })

    return _unique_candidates(all_cands)[:LPC_MAX_PEAKS]


def fft_frequency_candidates(filtered_chunk, f_min, f_max):
    windowed = filtered_chunk * np.hamming(len(filtered_chunk))
    fft_val = np.abs(np.fft.rfft(windowed))
    freqs = np.fft.rfftfreq(len(filtered_chunk), d=1.0 / SAMPLE_RATE)
    mask = (freqs >= f_min) & (freqs <= f_max)

    if not np.any(mask):
        return []

    vf = freqs[mask]
    vm = fft_val[mask]
    prom = vm.max() * FFT_PEAK_PROM
    peaks, _ = signal.find_peaks(vm, prominence=prom, distance=FFT_MIN_PEAK_SEP)

    if len(peaks) == 0:
        peaks = np.array([int(np.argmax(vm))])

    peak_items = []
    for p in peaks:
        f = float(vf[p])
        if _is_noise_freq(f):
            continue
        peak_items.append((f, float(vm[p])))

    if not peak_items:
        return []

    peak_items = sorted(peak_items, key=lambda x: x[1], reverse=True)[:FFT_MAX_PEAKS]
    max_amp = max(a for _, a in peak_items) + 1e-12

    cands = []
    for f, amp in peak_items:
        cands.append({
            'f': f,
            'amp': amp / max_amp,
            'src': 'FFT',
            'score': amp / max_amp,
            'harm': 1,
        })

    return _unique_candidates(cands)[:FFT_MAX_PEAKS]


def _add_harmonic_variants(cands, f_min, f_max):
    out = []

    for c in cands:
        out.append(dict(c))

        for h in (2, 3, 4, 5):
            fh = c['f'] / h
            if f_min <= fh <= f_max:
                out.append({
                    'f': fh,
                    'amp': c['amp'] * (0.82 - 0.06 * h),
                    'src': c['src'] + f'/H{h}',
                    'score': max(c['score'] - HARMONIC_PENALTY * h, 0.05),
                    'harm': h,
                })

    return _unique_candidates(out)


def _agreement_bonus(cands):
    if not cands:
        return []

    for c in cands:
        src = c['src']
        f = c['f']
        has_lpc = 'LPC' in src
        has_fft = 'FFT' in src

        if has_lpc and has_fft:
            c['score'] += SOURCE_AGREE_BONUS
            continue

        for other in cands:
            if other is c:
                continue

            other_src = other['src']
            if ('LPC' in src and 'FFT' in other_src) or ('FFT' in src and 'LPC' in other_src):
                if abs(other['f'] - f) <= max(25.0, f * 0.035):
                    c['score'] += SOURCE_AGREE_BONUS * 0.8
                    break

    return cands




def _freq_rel_diff(a, b):
    if a <= 0 or b <= 0:
        return 1e9
    return abs(a - b) / max(a, b)


def _supported_by_source_peak(selected_f, source_f):
    """selected_f가 source_f의 직접 피크 또는 배음 보정값으로 설명되는지 검사."""
    if selected_f <= 0 or source_f <= 0:
        return False

    # 직접 일치
    if _freq_rel_diff(selected_f, source_f) <= REG_LPC_FFT_AGREE_RATIO:
        return True

    # source_f가 selected_f의 2~5배 배음으로 잡힌 경우 허용
    ratio = source_f / (selected_f + 1e-12)
    for h in (2, 3, 4, 5):
        if abs(ratio - h) / h <= REG_HARMONIC_AGREE_RATIO:
            return True

    # selected_f가 source_f의 2~5배인 경우는 기본적으로 배음 오검출 가능성이 커서 회귀용으로는 불허
    return False


def reg_source_agreement_ok(raw_f, dbg):
    """지름 회귀용 raw_f가 LPC/FFT 양쪽에서 지지되는지 확인."""
    if not REG_REQUIRE_LPC_FFT_AGREE:
        return True, 'agreement 비활성'

    lpc_f = float(dbg.get('lpc', 0.0))
    fft_f = float(dbg.get('fft', 0.0))
    src = str(dbg.get('src', ''))

    if raw_f <= 0:
        return False, 'raw_f=0'

    if lpc_f <= 0 or fft_f <= 0:
        return False, f'LPC/FFT 부족(lpc={lpc_f:.0f}, fft={fft_f:.0f})'

    # 후보 병합 단계에서 이미 LPC+FFT가 같은 후보로 합쳐진 경우
    if 'LPC' in src and 'FFT' in src:
        return True, 'LPC+FFT merged'

    direct_diff = _freq_rel_diff(lpc_f, fft_f)
    if direct_diff <= REG_LPC_FFT_AGREE_RATIO:
        return True, f'LPC≈FFT({direct_diff*100:.1f}%)'

    lpc_support = _supported_by_source_peak(raw_f, lpc_f)
    fft_support = _supported_by_source_peak(raw_f, fft_f)

    if lpc_support and fft_support:
        return True, 'LPC/FFT harmonic support'

    return False, f'LPC/FFT 불일치(lpc={lpc_f:.0f}, fft={fft_f:.0f}, raw={raw_f:.0f}, diff={direct_diff*100:.1f}%)'

def select_frequency_candidate(filtered_chunk, ref_freq, f_min, f_max, allow_jump=True):
    lpc_cands = lpc_frequency_candidates(filtered_chunk, f_min, f_max)
    fft_cands = fft_frequency_candidates(filtered_chunk, f_min, f_max)

    all_cands = []
    all_cands.extend(lpc_cands)
    all_cands.extend(fft_cands)
    all_cands = _add_harmonic_variants(all_cands, f_min, f_max)
    all_cands = _agreement_bonus(all_cands)

    if not all_cands:
        return 0.0, {'lpc': 0.0, 'fft': 0.0, 'src': 'NONE', 'candidates': []}

    max_amp = max(c['amp'] for c in all_cands) + 1e-12

    for c in all_cands:
        f = c['f']
        amp_n = c['amp'] / max_amp
        score = 0.72 * c['score'] + 0.28 * amp_n

        if ref_freq > 0:
            dist = abs(f - ref_freq)
            cont = np.exp(-dist / CONTINUITY_WIDTH_HZ)
            score += CONTINUITY_WEIGHT * cont

            if f > ref_freq:
                score += RISE_BIAS_WEIGHT

            ratio = f / ref_freq
            strong_peak = amp_n >= JUMP_STRONG_AMP_RATIO

            if not allow_jump and (ratio > 1.8 or ratio < 0.55) and not strong_peak:
                score -= 0.65

            if ratio > 2.8 and c.get('harm', 1) == 1 and not strong_peak:
                score -= 0.40

        if c.get('harm', 1) > 1:
            score -= HARMONIC_PENALTY * (c['harm'] - 1)

        c['final_score'] = float(score)

    all_cands = sorted(all_cands, key=lambda c: c['final_score'], reverse=True)
    chosen = all_cands[0]

    best_lpc = lpc_cands[0]['f'] if lpc_cands else 0.0
    best_fft = fft_cands[0]['f'] if fft_cands else 0.0

    debug = {
        'lpc': float(best_lpc),
        'fft': float(best_fft),
        'src': chosen['src'],
        'candidates': [(round(c['f'], 1), round(c['final_score'], 3), c['src']) for c in all_cands[:6]],
    }

    return float(chosen['f']), debug


def fft_explore_rising(filtered_chunk, current_f, f_max):
    if current_f <= 0:
        return 0.0

    windowed = filtered_chunk * np.hamming(len(filtered_chunk))
    fft_val = np.abs(np.fft.rfft(windowed))
    freqs = np.fft.rfftfreq(len(filtered_chunk), d=1.0 / SAMPLE_RATE)

    search_min = current_f * 1.03
    search_max = min(f_max, current_f * EXPLORE_SEARCH_MULT, current_f * (1 + EXPLORE_MAX_JUMP_RATIO))
    mask = (freqs >= search_min) & (freqs <= search_max)

    if not np.any(mask):
        return 0.0

    vf = freqs[mask]
    vm = fft_val[mask]
    peaks, _ = signal.find_peaks(vm, prominence=vm.max() * 0.12, distance=10)

    if len(peaks) == 0:
        idx = int(np.argmax(vm))
        if vm[idx] < np.max(fft_val) * 0.08:
            return 0.0
        return float(vf[idx])

    pf = vf[peaks]
    pm = vm[peaks]
    clean = [i for i, f in enumerate(pf) if not _is_noise_freq(float(f))]

    if not clean:
        return 0.0

    pf = pf[clean]
    pm = pm[clean]
    return float(pf[int(np.argmax(pm))])


