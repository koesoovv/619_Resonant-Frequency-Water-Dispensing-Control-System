    return ONE_CM_FINAL_TRACKING_ALPHA if _is_tight_target() else FINAL_TRACKING_RISE_ALPHA


def _final_buf_size() -> int:
    return ONE_CM_BUF_SIZE_FINAL if _is_tight_target() else BUF_SIZE_FINAL


def _fast_stop_margin_cm() -> float:
    return ONE_CM_FAST_STOP_MARGIN_CM if _is_tight_target() else 0.0


def _fast_stop_hit_bonus() -> int:
    return ONE_CM_FAST_STOP_HIT_BONUS if _is_tight_target() else 1


def _recent_diam_spread(cands):
    if len(cands) < max(4, DIAM_CONFIRM_RECENT_N // 2):
        return None
    recent = list(cands)[-min(len(cands), DIAM_CONFIRM_RECENT_N):]
    med = float(np.median(recent))
    if med <= 1e-9:
        return None
    return float(np.std(recent) / (med + 1e-12))


def _diam_confirm_ready(cands, elapsed: float):
    spread = _recent_diam_spread(cands)
    ready = False
    if len(cands) >= DIAM_CAND_MAXLEN:
        ready = True
    elif (
        len(cands) >= DIAM_CAND_MIN
        and elapsed >= DIAM_CONFIRM_MIN_ELAPSED
        and spread is not None
        and spread <= DIAM_CONFIRM_SPREAD_MAX
    ):
        ready = True
    return ready, spread


# ════════════════════════════════════════════════════════════════════
#  회귀 워커 스레드
# ════════════════════════════════════════════════════════════════════
def _regression_worker():
    global current_diameter, confirmed_diameter, target_freq, calibration_done
    global theory_slope, theory_intercept, theory_locked
    global init_air_len_cm, last_r2, diameter_candidates, last_diam_spread
    global reeval_deviate_count, reeval_last_time, reeval_total_count

    while True:
        _reg_event.wait(timeout=1.0)
        _reg_event.clear()

        with lock:
            if not is_filling:
                continue
            _filling_elapsed = time.time() - filling_start_time - NOISE_CALIBRATION_TIME
            times      = list(reg_time_buffer)
            inv_freqs  = list(reg_inv_freq_buffer)
            _init_f    = float(initial_stable_freq)
            _live_d    = float(current_diameter)
            _conf_d    = float(confirmed_diameter)
            _diam_done = bool(calibration_done)

        if len(times) <= REG_MIN_POINTS:
            continue

        s_a, s_b, r_sq = robust_slope_loess_lsm(times, inv_freqs)

        if s_a is not None:
            if _live_d > 0:
                q_implied = abs(s_a) * np.pi * SOUND_SPEED * _live_d**2 / 16
                print(f'\n[회귀] slope={s_a:.6f} | r²={r_sq:.4f} | 역산Q={q_implied:.1f}ml/s (설정Q={FLOW_RATE})')
            else:
                print(f'\n[회귀] slope={s_a:.6f} | r²={r_sq:.4f}')

        with lock:
            if s_a is not None and r_sq > THEORY_LOCK_R2 and not theory_locked:
                theory_slope     = s_a
                theory_intercept = s_b
                theory_locked    = True
                print(f'\n[★ 이론 곡선 잠금] slope={s_a:.6f} r²={r_sq:.3f}')

        if s_a is None or abs(s_a) <= 1e-9:
            with lock:
                if s_a is not None:
                    last_r2 = r_sq
            continue

        r2_threshold = _adaptive_r2_min(abs(s_a))
        if r_sq <= r2_threshold:
            with lock:
                last_r2 = r_sq
            if r_sq > 0.6:
                print(f'\n[회귀] r²={r_sq:.4f} < 적응임계={r2_threshold:.2f} (slope={s_a:.2e}), D 미채택')
            continue

        temp_D = np.sqrt(16 * FLOW_RATE / (np.pi * SOUND_SPEED * abs(s_a)))
        temp_D *= DIAMETER_SCALE

        if not (2.0 < temp_D < 15.0):
            continue

        # ── 이상치 검사 ──────────────────────────────────────────────
        with lock:
            cand_list = list(diameter_candidates)

        if len(cand_list) >= 3:
            cur_med = float(np.median(cand_list))
            outlier = abs(temp_D - cur_med) / cur_med > DIAM_OUTLIER_RATIO
        else:
            outlier = False
            cur_med = temp_D

        if outlier:
            print(f'\n[D이상치] temp_D={temp_D:.2f}cm (중앙값={cur_med:.2f}cm ±20%, 무시)')
            continue

        # ── D 업데이트 (확정 전 / 재평가 공통) ───────────────────────
        with lock:
            last_r2 = r_sq
            diameter_candidates.append(temp_D)

            _new_cnt     = len(diameter_candidates)
            _elapsed_now = time.time() - filling_start_time - NOISE_CALIBRATION_TIME
            cand_vals    = list(diameter_candidates)

            med_D = float(np.median(cand_vals))
            if current_diameter == 0:
                current_diameter = med_D
            else:
                current_diameter = current_diameter * DIAM_EMA_KEEP + med_D * DIAM_EMA_NEW
            _live_d_now = float(current_diameter)

            ready_now, cand_spread = _diam_confirm_ready(cand_vals, _elapsed_now)
            last_diam_spread = 999.0 if cand_spread is None else float(cand_spread)

            # 용기 높이 확정 (최초 1회)
            if init_air_len_cm == 0.0 and _init_f > 0 and _live_d_now > 0 and _new_cnt >= DIAM_CAND_MIN:
                est = SOUND_SPEED / (4 * _init_f) - END_CORRECTION_K * _live_d_now
                if est > 0.5:
                    init_air_len_cm = est
                    print(f'\n[★ 용기 높이 확정] {est:.2f} cm')

            # ── 최초 확정 ────────────────────────────────────────────
            if not _diam_done and ready_now:
                confirmed_diameter = _live_d_now
                target_L_eff = TARGET_AIR_CM + END_CORRECTION_K * confirmed_diameter
                new_tf = SOUND_SPEED / (4 * target_L_eff)
                if target_freq == 0:
                    target_freq = new_tf
                else:
                    change_ratio = abs(new_tf - target_freq) / target_freq
                    if change_ratio <= TARGET_MAX_CHANGE_RATIO:
                        target_freq = new_tf
                calibration_done = True
                reeval_deviate_count = 0
                reeval_last_time     = _elapsed_now
                spread_txt = f'{cand_spread * 100:.1f}%' if cand_spread is not None else 'N/A'
                print(
                    f'\n[★ 지름 확정] live={_live_d_now:.3f}cm | confirmed={confirmed_diameter:.3f}cm'
                    f' | cand={_new_cnt} | spread={spread_txt} | t={_elapsed_now:.1f}s | r²={r_sq:.3f}'
                )

            # ── [v5.25-REEVAL] 확정 후 재평가 ────────────────────────
            elif _diam_done and reeval_total_count < REEVAL_MAX_COUNT:
                if _elapsed_now - reeval_last_time >= REEVAL_INTERVAL_SEC:
                    reeval_last_time = _elapsed_now
                    deviation = abs(_live_d_now - confirmed_diameter) / (confirmed_diameter + 1e-12)
                    if deviation > REEVAL_DEVIATION_RATIO:
                        reeval_deviate_count += 1
                        print(
                            f'\n[D재평가] 괴리 감지 {reeval_deviate_count}/{REEVAL_CONSECUTIVE_N}'
                            f' | live={_live_d_now:.3f}cm vs conf={confirmed_diameter:.3f}cm'
                            f' | diff={deviation*100:.1f}%'
                        )
                        if reeval_deviate_count >= REEVAL_CONSECUTIVE_N:
                            # Re-confirm!
                            old_conf = confirmed_diameter
                            confirmed_diameter = _live_d_now
                            target_L_eff = TARGET_AIR_CM + END_CORRECTION_K * confirmed_diameter
                            new_tf = SOUND_SPEED / (4 * target_L_eff)
                            target_freq = new_tf
                            reeval_deviate_count = 0
                            reeval_total_count  += 1
                            print(
                                f'\n[★ 지름 재확정 #{reeval_total_count}]'
                                f' {old_conf:.3f}→{confirmed_diameter:.3f}cm'
                                f' | target_f={target_freq:.0f}Hz'
                                f' | t={_elapsed_now:.1f}s'
                            )
                    else:
                        # 괴리 없음 → 카운터 리셋
                        reeval_deviate_count = max(0, reeval_deviate_count - 1)


_reg_worker_thread = threading.Thread(target=_regression_worker, daemon=True)
_reg_worker_thread.start()


