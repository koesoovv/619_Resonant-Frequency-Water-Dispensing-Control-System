#  오디오 스트림 관리
# ════════════════════════════════════════════════════════════════════
def audio_callback_timed(indata, frames, time_info, status):
    """
    [CB-DIAG] audio_callback 호출 간격/처리 시간을 측정하는 얇은 래퍼.
    본체(audio_callback)는 전혀 수정하지 않는다. 계측이 꺼져 있으면 곧장 본체만 호출한다.
    측정값은 약 CB_DIAG_INTERVAL초마다 콘솔에 한 줄로 출력한다.
    GIL 영향 판정:
      - gap_max ≫ CB_EXPECTED_MS  → 콜백이 늦게 호출됨(다른 스레드가 GIL 점유)
      - proc_max ≫ cpu_max        → 처리 도중에도 GIL을 뺏김
    """
    global _cb_prev_entry_t, _cb_gap_max_ms, _cb_gap_sum_ms
    global _cb_proc_max_ms, _cb_cpu_max_ms, _cb_count, _cb_late_count, _cb_last_log_t

    if not CB_DIAG_ENABLE:
        return audio_callback(indata, frames, time_info, status)

    entry_t   = time.time()
    cpu_start = time.thread_time()

    # 직전 진입과의 간격(호출이 밀렸는지)
    if _cb_prev_entry_t is not None:
        gap_ms = (entry_t - _cb_prev_entry_t) * 1000.0
        _cb_gap_sum_ms += gap_ms
        _cb_count += 1
        if gap_ms > _cb_gap_max_ms:
            _cb_gap_max_ms = gap_ms
        if gap_ms > CB_EXPECTED_MS * 1.5:
            _cb_late_count += 1
    _cb_prev_entry_t = entry_t

    try:
        return audio_callback(indata, frames, time_info, status)
    finally:
        proc_ms = (time.time() - entry_t) * 1000.0
        cpu_ms  = (time.thread_time() - cpu_start) * 1000.0
        if proc_ms > _cb_proc_max_ms:
            _cb_proc_max_ms = proc_ms
        if cpu_ms > _cb_cpu_max_ms:
            _cb_cpu_max_ms = cpu_ms

        # 급수 중일 때만, 약 CB_DIAG_INTERVAL초마다 요약 출력 후 윈도 리셋
        if is_filling and (entry_t - _cb_last_log_t >= CB_DIAG_INTERVAL) and _cb_count > 0:
            gap_avg = _cb_gap_sum_ms / max(1, _cb_count)
            print(f'\n[CB-DIAG] filling=True | n={_cb_count}'
                  f' | expect={CB_EXPECTED_MS:.0f}ms'
                  f' | gap_avg={gap_avg:.0f} gap_max={_cb_gap_max_ms:.0f}'
                  f' | proc_max={_cb_proc_max_ms:.0f} cpu_max={_cb_cpu_max_ms:.0f}'
                  f' | late={_cb_late_count}/{_cb_count}')
            _cb_last_log_t  = entry_t
            _cb_gap_max_ms  = 0.0
            _cb_gap_sum_ms  = 0.0
            _cb_proc_max_ms = 0.0
            _cb_cpu_max_ms  = 0.0
            _cb_count       = 0
            _cb_late_count  = 0


def ensure_audio_stream():
    global audio_stream
    if audio_stream is not None:
        return
    audio_stream = sd.InputStream(
        device=INPUT_DEVICE,
        callback=audio_callback_timed,   # [CB-DIAG] 계측 래퍼 등록(본체 audio_callback은 그대로)
        channels=1,
        samplerate=SAMPLE_RATE,
        blocksize=CHUNK_SIZE,
    )
    audio_stream.start()

def close_audio_stream_async(delay_sec=0.35):
    """급수 종료 후 급수 분석용 sounddevice 스트림을 비동기로 정리한다."""
    global audio_stream

    stream_ref = audio_stream                                      # 현재 스트림 참조를 고정
    if stream_ref is None:                                         # 열린 분석 스트림이 없으면 종료
        return

    def _worker():
        global audio_stream
        time.sleep(max(0.0, float(delay_sec)))                     # 콜백 종료 여유 시간
        try:
            with lock:
                still_filling = bool(is_filling)                  # 새 급수가 시작됐는지 확인
            if still_filling:
                return                                             # 급수 중이면 닫지 않음
            if audio_stream is not stream_ref:
                return                                             # 다른 스트림으로 바뀌었으면 보호
            try:
                stream_ref.stop()                                  # PortAudio 스트림 정지
            except Exception:
                pass
            try:
                stream_ref.close()                                 # 오디오 장치 해제
            except Exception:
                pass
            audio_stream = None                                    # 다음 급수 때 새로 열도록 초기화
            print('\n[CORE] 급수 분석 audio_stream 정리 완료')
        except Exception as e:
            print(f'\n[CORE] audio_stream 정리 오류: {e}')

    threading.Thread(target=_worker, daemon=True).start()           # GUI/오디오 콜백을 막지 않음
